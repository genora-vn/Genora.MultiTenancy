@page
@model Genora.MultiTenancy.Web.Pages.HoaLinh.BlouseConfig.IndexModel
@inject IHtmlLocalizer<MultiTenancyResource> L
@using Microsoft.AspNetCore.Mvc.Localization
@using Genora.MultiTenancy.Localization

@section styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css" />
    <style>
        .hl-banner-preview { max-width: 100%; max-height: 70px; object-fit: contain; border: 1px solid #e5e7eb; border-radius: 6px; padding: 2px; background: #fff; }
        .hl-banner-box { min-height: 70px; display: flex; align-items: center; justify-content: center; border: 1px dashed #d1d5db; border-radius: 6px; }
    </style>
}

@section scripts {
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script src="https://npmcdn.com/flatpickr/dist/l10n/vn.js"></script>
    <script src="~/Pages/HoaLinh/BlouseConfig/index.js" asp-append-version="true"></script>
}

<abp-row>
    <abp-column size-md="_5">
        <abp-card>
            <abp-card-header>
                <h4 class="mb-0"><i class="fa fa-sliders me-2"></i>Cấu hình chương trình</h4>
            </abp-card-header>
            <abp-card-body>
                <form id="CampaignForm">
                    <div class="mb-2">
                        <label class="form-label small">Tên chương trình <span class="text-danger">*</span></label>
                        <input type="text" id="ProgramName" class="form-control form-control-sm" placeholder="Đăng ký nhận áo Blouse" />
                    </div>
                    <div class="mb-2">
                        <label class="form-label small">Giới thiệu (HTML)</label>
                        <textarea id="IntroductionHtml" class="form-control form-control-sm" rows="2" placeholder="Mô tả ngắn chương trình..."></textarea>
                    </div>
                    <div class="row g-2">
                        <div class="col-4">
                            <label class="form-label small">Số áo tặng miễn phí</label>
                            <input type="number" id="FreeShirtLimit" class="form-control form-control-sm" min="0" value="2" />
                        </div>
                        <div class="col-4">
                            <label class="form-label small">Điểm / 1 áo đổi</label>
                            <input type="number" id="PointsPerShirt" class="form-control form-control-sm" min="0" value="150" />
                        </div>
                        <div class="col-4">
                            <label class="form-label small">Số áo đổi tối đa</label>
                            <input type="number" id="MaxExchangeShirt" class="form-control form-control-sm" min="0" value="0" />
                        </div>
                    </div>
                    <div class="form-text mb-2">Số áo đổi tối đa = 0 nghĩa là không giới hạn.</div>
                    <div class="mb-2">
                        <label class="form-label small">Ảnh banner chương trình</label>
                        <div class="row g-2 align-items-center">
                            <div class="col-8">
                                <input type="text" id="SizeChartImageUrl" class="form-control form-control-sm mb-2" placeholder="Dán URL ảnh..." />
                                <input type="file" id="BannerFile" class="form-control form-control-sm" accept="image/*" />
                            </div>
                            <div class="col-4">
                                <div class="hl-banner-box">
                                    <img id="BannerPreview" class="hl-banner-preview" alt="Banner" style="display:none" />
                                    <span id="BannerNoPreview" class="text-muted small">Chưa có ảnh</span>
                                </div>
                            </div>
                        </div>
                    </div>
                    <div class="row g-2">
                        <div class="col-6">
                            <label class="form-label small">Bắt đầu</label>
                            <input type="text" id="StartTime" class="form-control form-control-sm flatpickr-dt" autocomplete="off" placeholder="dd/MM/yyyy HH:mm" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small">Kết thúc</label>
                            <input type="text" id="EndTime" class="form-control form-control-sm flatpickr-dt" autocomplete="off" placeholder="dd/MM/yyyy HH:mm" />
                        </div>
                    </div>
                    <div class="form-check mt-2">
                        <input type="checkbox" id="IsActive" class="form-check-input" checked />
                        <label class="form-check-label small" for="IsActive">Đang bật chương trình</label>
                    </div>
                    <button type="button" id="BtnSaveCampaign" class="btn btn-primary btn-sm mt-3"><i class="fa fa-save me-1"></i>Lưu cấu hình</button>
                </form>
            </abp-card-body>
        </abp-card>
    </abp-column>

    <abp-column size-md="_7">
        <abp-card>
            <abp-card-header>
                <abp-row>
                    <abp-column size-md="_7">
                        <h4 class="mb-0"><i class="fa fa-ruler me-2"></i>Danh mục size &amp; tồn kho</h4>
                    </abp-column>
                    <abp-column size-md="_5" class="text-end">
                        <button id="BtnAddSize" class="btn btn-success btn-sm"><i class="fa fa-plus me-1"></i>Thêm size</button>
                    </abp-column>
                </abp-row>
            </abp-card-header>
            <abp-card-body>
                <div id="SizeContainer">
                    <table id="HlBlouseSizeTable" class="table table-hover table-bordered table-sm w-100">
                        <thead class="table-light">
                            <tr>
                                <th>Dáng</th>
                                <th>Size</th>
                                <th>Cân nặng</th>
                                <th class="text-center">Tồn kho</th>
                                <th class="text-center">Thứ tự</th>
                                <th class="text-center">Bật</th>
                                <th style="width:90px" class="text-center">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
            </abp-card-body>
        </abp-card>
    </abp-column>
</abp-row>

<!-- Size Modal -->
<div class="modal fade" id="SizeModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="SizeModalTitle"><i class="fa fa-ruler me-2"></i>Thêm size</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="SizeId" />
                <div class="mb-2">
                    <label class="form-label small">Dáng áo <span class="text-danger">*</span></label>
                    <select id="SizeStyle" class="form-select form-select-sm">
                        <option value="1">Nam</option>
                        <option value="2">Nữ</option>
                    </select>
                </div>
                <div class="mb-2">
                    <label class="form-label small">Mã size <span class="text-danger">*</span></label>
                    <input type="text" id="SizeCode" class="form-control form-control-sm" placeholder="M, L, XL, 2XL..." />
                </div>
                <div class="mb-2">
                    <label class="form-label small">Cân nặng phù hợp</label>
                    <input type="text" id="WeightRange" class="form-control form-control-sm" placeholder="50-55kg" />
                </div>
                <div class="row g-2">
                    <div class="col-6">
                        <label class="form-label small">Tồn kho</label>
                        <input type="number" id="StockQuantity" class="form-control form-control-sm" min="0" value="0" />
                    </div>
                    <div class="col-6">
                        <label class="form-label small">Thứ tự hiển thị</label>
                        <input type="number" id="DisplayOrder" class="form-control form-control-sm" min="0" value="0" />
                    </div>
                </div>
                <div class="form-check mt-2">
                    <input type="checkbox" id="SizeIsActive" class="form-check-input" checked />
                    <label class="form-check-label small" for="SizeIsActive">Đang áp dụng</label>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">Hủy</button>
                <button type="button" id="BtnSaveSize" class="btn btn-primary btn-sm"><i class="fa fa-save me-1"></i>Lưu</button>
            </div>
        </div>
    </div>
</div>
