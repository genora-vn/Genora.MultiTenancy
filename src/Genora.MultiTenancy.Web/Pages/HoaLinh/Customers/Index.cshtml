@page
@model Genora.MultiTenancy.Web.Pages.HoaLinh.Customers.IndexModel
@inject IHtmlLocalizer<MultiTenancyResource> L
@using Microsoft.AspNetCore.Mvc.Localization
@using Genora.MultiTenancy.Localization

@section styles {
    <style>
        .hl-badge-gkhl { background-color: #fff3cd; color: #856404; }
        .hl-tier-badge { background-color: #e2e3f1; color: #383d6e; font-weight: 600; }
        .hl-src-dms { background-color: #d1e7dd; color: #0f5132; }
        .hl-src-mini { background-color: #cff4fc; color: #055160; }
        .hl-src-other { background-color: #e2e3e5; color: #41464b; }
    </style>
}

@section scripts {
    <script src="~/Pages/HoaLinh/Customers/index.js" asp-append-version="true"></script>
}

<abp-card>
    <abp-card-header>
        <abp-row>
            <abp-column size-md="_6">
                <h4 class="mb-0"><i class="fa fa-users me-2"></i>@L["Menu:AppHlCustomers"]</h4>
            </abp-column>
            <abp-column size-md="_6" class="text-end">
                <button id="BtnRefresh" class="btn btn-outline-secondary btn-sm">
                    <i class="fa fa-sync-alt"></i> Refresh
                </button>
            </abp-column>
        </abp-row>
    </abp-card-header>
    <abp-card-body>
        <div class="row mb-3 align-items-center g-2">
            <div class="col-md-3">
                <input type="text" id="FilterText" class="form-control form-control-sm" placeholder="Tìm theo tên, SĐT, mã KH, NV Sales..." />
            </div>
            <div class="col-md-2">
                <select id="FilterChannel" class="form-select form-select-sm">
                    <option value="">Tất cả kênh</option>
                    <option value="GT">GT</option>
                    <option value="OTC">OTC</option>
                </select>
            </div>
            <div class="col-md-2">
                <select id="FilterGkhl" class="form-select form-select-sm">
                    <option value="">Tất cả GKHL</option>
                    <option value="true">Có GKHL</option>
                    <option value="false">Không GKHL</option>
                </select>
            </div>
            <div class="col-md-2">
                <select id="FilterSource" class="form-select form-select-sm">
                    <option value="">Tất cả nguồn</option>
                    <option value="5">Hoa Linh (DMS)</option>
                    <option value="1">Genora (Mini App)</option>
                    <option value="2">Nhập tay</option>
                    <option value="3">Import</option>
                    <option value="4">Khác</option>
                </select>
            </div>
            <div class="col-md-1">
                <button id="BtnSearch" class="btn btn-primary btn-sm w-100"><i class="fa fa-search"></i></button>
            </div>
        </div>

        <div id="CustomerTableContainer">
            <table id="HlCustomersTable" class="table table-hover table-bordered table-sm w-100">
                <thead class="table-light">
                    <tr>
                        <th style="width:70px" class="text-center">Thao tác</th>
                        <th>Mã KH</th>
                        <th>Tên khách hàng</th>
                        <th>SĐT</th>
                        <th>Kênh</th>
                        <th>Nhóm</th>
                        <th>NV Sales</th>
                        <th class="text-center">GKHL</th>
                        <th class="text-center">Hạng TV</th>
                        <th class="text-end">Điểm</th>
                        <th class="text-center">Nguồn</th>
                    </tr>
                </thead>
                <tbody></tbody>
            </table>
        </div>

        <div class="d-flex justify-content-between align-items-center mt-3">
            <div id="PagingInfo" class="text-muted small"></div>
            <div class="d-flex align-items-center gap-2">
                <select id="PageSize" class="form-select form-select-sm" style="width:auto">
                    <option value="10">10</option>
                    <option value="20" selected>20</option>
                    <option value="50">50</option>
                    <option value="100">100</option>
                </select>
                <nav><ul id="Pagination" class="pagination pagination-sm mb-0"></ul></nav>
            </div>
        </div>
    </abp-card-body>
</abp-card>
