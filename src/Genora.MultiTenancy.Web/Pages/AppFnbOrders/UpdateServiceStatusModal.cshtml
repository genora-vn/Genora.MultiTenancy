@page
@using Genora.MultiTenancy.Enums
@using Genora.MultiTenancy.Localization
@using Genora.MultiTenancy.Web.Helpers
@using Genora.MultiTenancy.Web.Pages.AppFnbOrders
@using Microsoft.Extensions.Localization
@using Volo.Abp.AspNetCore.Mvc.UI.Bootstrap.TagHelpers.Modal
@model UpdateServiceStatusModalModel
@inject IStringLocalizer<MultiTenancyResource> L

@{
    Layout = null;
}

<form asp-page="/AppFnbOrders/UpdateServiceStatusModal" method="post">
    <input type="hidden" asp-for="Id" />
    <abp-modal>
        <abp-modal-header title="@L["UpdateServiceStatus"]"></abp-modal-header>
        <abp-modal-body>
            <abp-select asp-for="Input.ServiceStatus"
                        label="@L["ServiceStatus"]"
                        asp-items="EnumSelectList.GetLocalizedEnumSelectList<FnbServiceStatus>(L)" />
        </abp-modal-body>
        <abp-modal-footer buttons="@(AbpModalButtons.Cancel | AbpModalButtons.Save)"></abp-modal-footer>
    </abp-modal>
</form>