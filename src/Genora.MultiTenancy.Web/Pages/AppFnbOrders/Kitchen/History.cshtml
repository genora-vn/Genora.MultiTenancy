@page
@model Genora.MultiTenancy.Web.Pages.AppFnbOrders.Kitchen.HistoryModel
@using System.Text.Json

@section styles {
    <abp-style src="/pages/fnb/fnb-shared.css" />
}

@section scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
    <abp-script src="/pages/fnb/fnb-notify.js" />
    <abp-script src="/pages/fnb/fnb-bill-print.js" />
    <abp-script src="/pages/fnb/fnb-bill-export.js" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>
    <script>
        window.genoraFnbNotify.init({
            viewAllUrl: '/AppFnbOrders',
            detailUrl: function (id) {
                return '/AppFnbOrders/Kitchen/Detail?id=' + id;
            },
            onUpdated: function (payload) {
                if (!payload) return;
                if (String(payload.id) !== String('@Model.Id')) return;
                if ($('.modal.show').length) return;

                window.location.reload();
            }
        });

        const historyRows = @Html.Raw(JsonSerializer.Serialize(
                    Model.Data.PagedActivities.Items.Select(x => new
                    {
                            time = x.Time.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss"),
                            performedBy = x.PerformedBy,
                            actionTypeText = x.ActionTypeText,
                            title = x.Title,
                            description = x.Description
                    })
            ));

    const orderPrintPayload = @Html.Raw(JsonSerializer.Serialize(new
    {
            shopName = Model.ShopName,
            shopAddress = Model.ShopAddress,
            shopPhone = Model.ShopPhone,
            kioskLabel = Model.KioskLabel,
            cashierName = Model.CashierName,
            orderCode = Model.OrderDetail.OrderCode,
            creationTimeText = Model.OrderDetail.CreationTime.ToLocalTime().ToString("dd/MM/yyyy HH:mm"),
            customerName = !string.IsNullOrWhiteSpace(Model.OrderDetail.CustomerName) ? Model.OrderDetail.CustomerName : "Khách lẻ",
            customerTypeName = !string.IsNullOrWhiteSpace(Model.Data.CustomerTypeName) ? Model.Data.CustomerTypeName : "Khách lẻ",
            bagTag = Model.OrderDetail.BagTag,
            subtotal = Model.OrderDetail.Items.Sum(x => x.Price * x.Quantity),
            serviceFee = 0,
            vat = 0,
            discount = 0,
            total = Model.OrderDetail.TotalAmount,
            serviceStatusText = Model.GetServiceStatusText(),
            note = !string.IsNullOrWhiteSpace(Model.OrderDetail.Note) ? Model.OrderDetail.Note : "—",
            qrText = !string.IsNullOrWhiteSpace(Model.PaymentQrText) ? Model.PaymentQrText : "Quét mã để thanh toán nhanh",
            qrBankCode = Model.PaymentQrBankCode,
            qrBankAccount = Model.PaymentQrBankAccount,
            qrBankDisplay = Model.PaymentQrBankDisplay,
            qrAccountName = Model.ShopName,
            qrAddInfo = $"Thanh toan Bill {Model.OrderDetail.OrderCode}",
            items = Model.OrderDetail.Items.Select(x => new
            {
                    itemName = x.ItemName,
                    quantity = x.Quantity,
                    price = x.Price,
                    amount = x.Price * x.Quantity
            })
    }));

    function printOrderBill(paperWidth) {
        window.fnbPrintOrderBill(orderPrintPayload, paperWidth || 80);
    }

        function exportOrderPdf(paperWidth) {
            window.fnbExportOrderPdf(orderPrintPayload, paperWidth || 80);
        }

        function exportHistoryCsv() {
            const rows = [];
            rows.push(["Thời gian", "Người thực hiện", "Loại thao tác", "Tiêu đề", "Mô tả"]);

            historyRows.forEach(function (x) {
                rows.push([
                    x.time || "",
                    x.performedBy || "",
                    x.actionTypeText || "",
                    x.title || "",
                    x.description || ""
                ]);
            });

            const csvContent = "\uFEFF" + rows.map(r => r.map(x => `"${String(x).replace(/"/g, '""')}"`).join(",")).join("\n");
            const blob = new Blob([csvContent], { type: "text/csv;charset=utf-8;" });
            const url = URL.createObjectURL(blob);

            const a = document.createElement("a");
            a.href = url;
            a.download = "lich-su-thao-tac-@(Model.Data.OrderCode).csv";
            a.click();

            URL.revokeObjectURL(url);
        }
    </script>
}
<div class="order-history-page">
    <div class="order-history-wrap">
        <div class="lpx-topbar order-history-topbar">
            <div>
                <div class="order-history-breadcrumb">
                    <a href="/AppFnbOrders">Quản lý đơn hàng Fnb</a>
                    <span>/</span>
                    <a href="/AppFnbOrders/Kitchen/Detail?id=@Model.Data.OrderId">Đơn hàng</a>
                    <span>/</span>
                    <span>@Model.Data.OrderCode Tất cả Lịch sử thao tác</span>
                </div>

                <div class="order-history-head">
                    <div class="order-history-title-row">
                        <h1 class="order-history-title">Lịch sử thao tác #@Model.Data.OrderCode</h1>
                        <span class="order-history-status">@Model.GetServiceStatusText()</span>
                    </div>

                    <div class="order-history-subtitle">
                        Nhật ký hoạt động chi tiết của đơn hàng, phục vụ tra cứu và đối soát nội bộ.
                    </div>
                </div>
            </div>

            <div class="order-history-toolbar">
                <button type="button" class="order-history-icon-btn" onclick="exportHistoryCsv()" title="Xuất CSV">
                    <i class="fa fa-download"></i>
                </button>

                <button type="button" class="order-history-icon-btn" onclick="exportOrderPdf(80)" title="Xuất PDF">
                    <i class="fa fa-file-pdf-o"></i>
                </button>

                <button type="button" class="order-history-icon-btn" onclick="printOrderBill(80)" title="In K80">
                    <i class="fa fa-print"></i>
                </button>

                <button type="button" class="order-history-icon-btn" onclick="printOrderBill(57)" title="In K57">
                    <i class="fa fa-receipt"></i>
                </button>

                <a class="order-history-back" href="/AppFnbOrders/Kitchen/Detail?id=@Model.Data.OrderId">
                    <i class="fa fa-arrow-left"></i>
                    <span>Quay lại đơn hàng</span>
                </a>
            </div>
        </div>

        <div class="row g-3 order-history-metrics">
            <div class="col-md-3">
                <div class="order-history-metric-card">
                    <div class="order-history-metric-head">
                        <div class="order-history-metric-label">Tổng số thao tác</div>
                        <div class="order-history-metric-icon">
                            <i class="fa fa-history"></i>
                        </div>
                    </div>
                    <div class="order-history-metric-value">@Model.Data.TotalActions</div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="order-history-metric-card">
                    <div class="order-history-metric-head">
                        <div class="order-history-metric-label">Hoạt động gần nhất</div>
                        <div class="order-history-metric-icon">
                            <i class="fa fa-clock-o"></i>
                        </div>
                    </div>
                    <div class="order-history-metric-value">
                        @(Model.Data.LastActivityTime.HasValue
                                                ? Model.Data.LastActivityTime.Value.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                                : "—")
                    </div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="order-history-metric-card">
                    <div class="order-history-metric-head">
                        <div class="order-history-metric-label">Độ tin cậy nhật ký</div>
                        <div class="order-history-metric-icon">
                            <i class="fa fa-check-circle"></i>
                        </div>
                    </div>
                    <div class="order-history-metric-value">100% Xác thực</div>
                </div>
            </div>

            <div class="col-md-3">
                <div class="order-history-metric-card">
                    <div class="order-history-metric-head">
                        <div class="order-history-metric-label">Khách hàng</div>
                        <div class="order-history-metric-icon">
                            <i class="fa fa-check-circle"></i>
                        </div>
                    </div>
                    <div class="order-history-metric-value">
                        @(!string.IsNullOrWhiteSpace(Model.Data.CustomerName) ? Model.Data.CustomerName : "Khách lẻ")
                    </div>
                </div>
            </div>
        </div>

        <div class="order-history-filter-card">
            <form method="get" class="row g-3 align-items-end">
                <input type="hidden" name="id" value="@Model.Id" />
                <input type="hidden" name="currentPage" value="1" />

                <div class="col-md-4">
                    <label class="form-label">Lọc theo loại thao tác</label>
                    <select name="actionType" class="form-select">
                        @foreach (var opt in Model.Data.ActionTypeOptions)
                        {
                            if (string.Equals(opt.Value ?? "", Model.ActionType ?? "", StringComparison.OrdinalIgnoreCase))
                            {
                                <option value="@opt.Value" selected>@opt.Text</option>
                            }
                            else
                            {
                                <option value="@opt.Value">@opt.Text</option>
                            }
                        }
                    </select>
                </div>

                <div class="col-md-2">
                    <label class="form-label">Số dòng / trang</label>
                    <select name="pageSize" class="form-select">
                        @foreach (var size in new[] { 5, 10, 20, 50 })
                        {
                            if (Model.PageSize == size)
                            {
                                <option value="@size" selected>@size</option>
                            }
                            else
                            {
                                <option value="@size">@size</option>
                            }
                        }
                    </select>
                </div>

                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary w-50">
                        <i class="fa fa-search me-1"></i> Áp dụng
                    </button>
                </div>
            </form>
        </div>

        <div class="order-history-table-card">
            <div class="table-responsive">
                <table class="table order-history-table">
                    <thead>
                        <tr>
                            <th>Thời gian</th>
                            <th>Người thực hiện</th>
                            <th>Loại thao tác</th>
                            <th>Chi tiết & ngữ cảnh</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.Data.PagedActivities != null && Model.Data.PagedActivities.Items.Any())
                        {
                            @foreach (var item in Model.Data.PagedActivities.Items)
                            {
                                <tr>
                                    <td>@item.Time.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")</td>
                                    <td>
                                        <div class="order-history-actor">
                                            <span class="order-history-actor-icon">
                                                <i class="fa fa-user"></i>
                                            </span>
                                            <span>@item.PerformedBy</span>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="order-history-badge @item.ActionTypeClass">
                                            @item.ActionTypeText
                                        </span>
                                    </td>
                                    <td>
                                        <div class="order-history-detail-title">@item.Title</div>
                                        <div class="order-history-detail-desc">@item.Description</div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center text-muted py-4">
                                    Chưa có dữ liệu lịch sử thao tác.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="order-history-footer">
            <div>
                Hiển thị @Model.Data.PagedActivities.Items.Count / @Model.Data.PagedActivities.TotalCount bản ghi.
            </div>

            <div class="order-history-pagination">
                @{
                    var prevPage = Model.CurrentPage - 1;
                    var nextPage = Model.CurrentPage + 1;
                }

                @if (Model.CurrentPage > 1)
                {
                    <a class="order-history-page-btn"
                       href="/AppFnbOrders/Kitchen/History?id=@Model.Id&actionType=@Model.ActionType&pageSize=@Model.PageSize&currentPage=@prevPage">
                        <i class="fa fa-angle-left"></i>
                    </a>
                }

                @for (var p = 1; p <= Model.TotalPages; p++)
                {
                    <a class="order-history-page-btn @(p == Model.CurrentPage ? "active" : "")"
                       href="/AppFnbOrders/Kitchen/History?id=@Model.Id&actionType=@Model.ActionType&pageSize=@Model.PageSize&currentPage=@p">
                        @p
                    </a>
                }

                @if (Model.CurrentPage < Model.TotalPages)
                {
                    <a class="order-history-page-btn"
                       href="/AppFnbOrders/Kitchen/History?id=@Model.Id&actionType=@Model.ActionType&pageSize=@Model.PageSize&currentPage=@nextPage">
                        <i class="fa fa-angle-right"></i>
                    </a>
                }
            </div>
        </div>
    </div>
</div>