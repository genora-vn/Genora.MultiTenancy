@page
@using Genora.MultiTenancy.Enums
@using Genora.MultiTenancy.Localization
@using Genora.MultiTenancy.Web.Pages.AppFnbOrders
@using Microsoft.Extensions.Localization
@using Volo.Abp.AspNetCore.Mvc.UI.Bootstrap.TagHelpers.Modal
@model UpdatePaymentStatusModalModel
@inject IStringLocalizer<MultiTenancyResource> L

@{
    Layout = null;
}

<form asp-page="/AppFnbOrders/UpdatePaymentStatusModal" method="post" class="fnb-item-modal-form">
    <input type="hidden" asp-for="Id" />
    <input type="hidden" name="CurrentPaymentStatus" value="@Model.Input.PaymentStatus" />

    <abp-modal size="Large">
        <abp-modal-body class="p-0">
            <div class="fnb-item-modal fnb-item-modal--compact fnb-item-modal--fit">
                <div class="fnb-item-modal__header">
                    <div class="fnb-item-modal__title-wrap">
                        <div class="fnb-item-modal__title-row">
                            <div class="fnb-item-modal__icon">
                                <i class="fa fa-credit-card"></i>
                            </div>
                            <div>
                                <h3 class="fnb-item-modal__title">@L["OrderStatusModal:FnbPaymentTitle"]</h3>
                                <div class="fnb-item-modal__subtitle">@L["OrderStatusModal:FnbPaymentSubtitle"]</div>
                            </div>
                        </div>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                </div>

                <div class="fnb-item-modal__body">
                    <div class="mb-3">
                        <label class="fnb-label">@L["OrderStatusModal:PaymentStatusLabel"] <span class="text-danger">*</span></label>

                        <div class="fnb-radio-grid">
                            @foreach (var item in Enum.GetValues<FnbPaymentStatus>())
                            {
                                var checkedCurrent = Model.Input.PaymentStatus == item;
                                var disabled = checkedCurrent;

                                <label class="fnb-radio-card @(disabled ? "disabled" : "")">
                                    <input type="radio"
                                           asp-for="Input.PaymentStatus"
                                           value="@item"
                                           checked="@(checkedCurrent ? "checked" : null)"
                                           disabled="@(disabled ? "disabled" : null)" />
                                    <span>@L[$"FnbPaymentStatus:{item}"]</span>
                                </label>
                            }
                        </div>

                        <span asp-validation-for="Input.PaymentStatus" class="text-danger"></span>
                    </div>
                </div>

                <div class="fnb-item-modal__footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                        @L["OrderStatusModal:CancelLong"]
                    </button>
                    <button type="submit" class="btn btn-primary">
                        @L["OrderStatusModal:Confirm"]
                    </button>
                </div>
            </div>
        </abp-modal-body>
    </abp-modal>
</form>

<script>
    (function () {
        var form = document.querySelector('.fnb-item-modal-form');
        if (!form) return;

        var submitBtn = form.querySelector('button[type="submit"]');
        var radios = form.querySelectorAll('input[type="radio"][name="Input.PaymentStatus"]');
        var currentInput = form.querySelector('input[name="CurrentPaymentStatus"]');
        var currentStatus = (currentInput && currentInput.value) || '';

        function updateSubmitState() {
            var selected = form.querySelector('input[type="radio"][name="Input.PaymentStatus"]:checked');
            var hasValidSelection = selected && String(selected.value) !== String(currentStatus);
            submitBtn.disabled = !hasValidSelection;
        }

        radios.forEach(function (r) {
            r.addEventListener('change', updateSubmitState);
        });

        updateSubmitState();
    })();
</script>