@page
@using System.Text.Json
@using Genora.MultiTenancy.Localization
@using Microsoft.Extensions.Localization
@using Volo.Abp.AspNetCore.Mvc.UI.Bootstrap.TagHelpers.Modal
@using Genora.MultiTenancy.Web.Pages.SalonBeautyTimeSlots
@model EditModalModel
@inject IStringLocalizer<MultiTenancyResource> L
@{
    Layout = null;
    var locationsJson = JsonSerializer.Serialize(Model.Locations.Select(x => new {
        id = x.Id,
        name = x.Name,
        openTime = $"{x.OpenTime.Hours:D2}:{x.OpenTime.Minutes:D2}",
        closeTime = $"{x.CloseTime.Hours:D2}:{x.CloseTime.Minutes:D2}",
        slotDuration = x.SlotDuration,
        bufferTime = x.BufferTime,
        maxCapacityPerSlot = x.MaxCapacityPerSlot
    }));
    var rangesJson = JsonSerializer.Serialize(Model.Ranges.Select(r => new {
        startTime = $"{r.StartTime.Hours:D2}:{r.StartTime.Minutes:D2}",
        endTime = $"{r.EndTime.Hours:D2}:{r.EndTime.Minutes:D2}",
        capacity = r.Capacity,
        isPeakHour = r.IsPeakHour
    }));
    var fromDateStr = Model.FromDate.HasValue ? Model.FromDate.Value.ToString("dd/MM/yyyy") : string.Empty;
    var toDateStr = Model.ToDate.HasValue ? Model.ToDate.Value.ToString("dd/MM/yyyy") : string.Empty;
}

<form id="EditTimeSlotForm" class="timeslot-form" method="post" autocomplete="off" novalidate>
    <input type="hidden" id="EditTimeSlotStylistId" value="@Model.StylistId" />
    <abp-modal size="Large">
        <abp-modal-body class="p-0">
            <div class="timeslot-modal"
                 data-locations='@Html.Raw(locationsJson)'
                 data-ranges='@Html.Raw(rangesJson)'
                 data-weekday-mask="@Model.WeekdayMask"
                 data-status="@Model.Status"
                 data-show-on-app="@(Model.IsShowOnApp ? "true" : "false")">
                <div class="timeslot-modal-header">
                    <div class="timeslot-modal-title-wrap">
                        <h3>@L["SalonBeautyTimeSlots:EditTitle"]</h3>
                        <p>@L["SalonBeautyTimeSlots:EditSubTitle"]</p>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@L["Close"]"></button>
                </div>

                <div class="timeslot-modal-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="timeslot-form-label">@L["SalonBeautyTimeSlots:Location"] <span class="text-danger">*</span></label>
                            <select id="EditTimeSlotLocationSelect" asp-items="Model.LocationItems" class="form-select timeslot-form-select timeslot-location-select" required>
                                <option value="">@L["SalonBeautyTimeSlots:LocationPlaceholder"]</option>
                            </select>
                            <small class="text-muted d-block mt-1 timeslot-location-hint"></small>
                        </div>
                        <div class="col-md-6">
                            <label class="timeslot-form-label">@L["SalonBeautyTimeSlots:Stylist"]</label>
                            <input type="text" class="form-control timeslot-form-control timeslot-stylist-display" value="@Model.StylistName" disabled />
                        </div>
                        <div class="col-md-6">
                            <label class="timeslot-form-label">@L["SalonBeautyTimeSlots:FromDate"] <span class="text-danger">*</span></label>
                            <input id="EditTimeSlotFromDate" type="text" class="form-control timeslot-form-control timeslot-from-date" placeholder="dd/mm/yyyy" autocomplete="off" required value="@fromDateStr" />
                        </div>
                        <div class="col-md-6">
                            <label class="timeslot-form-label">@L["SalonBeautyTimeSlots:ToDate"] <span class="text-danger">*</span></label>
                            <input id="EditTimeSlotToDate" type="text" class="form-control timeslot-form-control timeslot-to-date" placeholder="dd/mm/yyyy" autocomplete="off" required value="@toDateStr" />
                        </div>

                        <div class="col-12">
                            <label class="timeslot-form-label">@L["SalonBeautyTimeSlots:WeekdayMask"]</label>
                            <div class="timeslot-weekday-row">
                                <span class="timeslot-weekday-chip" data-day="1">@L["Day:Mon"]</span>
                                <span class="timeslot-weekday-chip" data-day="2">@L["Day:Tue"]</span>
                                <span class="timeslot-weekday-chip" data-day="3">@L["Day:Wed"]</span>
                                <span class="timeslot-weekday-chip" data-day="4">@L["Day:Thu"]</span>
                                <span class="timeslot-weekday-chip" data-day="5">@L["Day:Fri"]</span>
                                <span class="timeslot-weekday-chip" data-day="6">@L["Day:Sat"]</span>
                                <span class="timeslot-weekday-chip" data-day="0">@L["Day:Sun"]</span>
                            </div>
                            <input type="hidden" class="timeslot-weekday-mask" value="@Model.WeekdayMask" />
                        </div>

                        <div class="col-12">
                            <div class="d-flex align-items-center justify-content-between">
                                <label class="timeslot-form-label mb-0">@L["SalonBeautyTimeSlots:TimeRanges"] <span class="text-danger">*</span></label>
                                <button type="button" class="timeslot-auto-generate-btn" data-auto-generate>
                                    <i class="fa fa-magic"></i> @L["SalonBeautyTimeSlots:AutoGenerate"]
                                </button>
                            </div>
                            <small class="text-muted d-block mt-1 mb-2">@L["SalonBeautyTimeSlots:AutoGenerateHint"]</small>
                            <div class="timeslot-ranges-list" data-ranges-list></div>
                            <button type="button" class="timeslot-add-range-btn" data-add-range>
                                <i class="fa fa-plus"></i> @L["SalonBeautyTimeSlots:AddRange"]
                            </button>
                        </div>

                        <div class="col-12">
                            <label class="timeslot-form-label">@L["SalonBeautyTimeSlots:Note"]</label>
                            <textarea rows="2" maxlength="500" class="form-control timeslot-form-control timeslot-note">@Model.Note</textarea>
                        </div>

                        <div class="col-12">
                            <div class="timeslot-status-box">
                                <div class="timeslot-status-icon"><i class="fa fa-shield"></i></div>
                                <div class="flex-grow-1">
                                    <strong>@L["SalonBeautyTimeSlots:StatusBoxTitle"]</strong>
                                    <span>@L["SalonBeautyTimeSlots:StatusBoxDescription"]</span>
                                </div>
                                <input type="hidden" class="timeslot-status-value" value="@Model.Status" />
                                <div class="timeslot-switch-wrap">
                                    <label class="timeslot-switch">
                                        <input type="checkbox" class="timeslot-status-toggle" @(Model.Status != 0 ? "checked" : "") />
                                        <span class="timeslot-switch-slider"></span>
                                    </label>
                                    <strong class="timeslot-status-toggle-text"
                                            data-active="@L["Enum:SalonBeautyTimeSlotStatus.On"]"
                                            data-inactive="@L["Enum:SalonBeautyTimeSlotStatus.Off"]">
                                        @(Model.Status != 0 ? L["Enum:SalonBeautyTimeSlotStatus.On"] : L["Enum:SalonBeautyTimeSlotStatus.Off"])
                                    </strong>
                                </div>
                            </div>
                        </div>

                        <div class="col-12">
                            <div class="timeslot-status-box">
                                <div class="timeslot-status-icon"><i class="fa fa-mobile"></i></div>
                                <div class="flex-grow-1">
                                    <strong>@L["SalonBeautyTimeSlots:ShowOnAppBoxTitle"]</strong>
                                    <span>@L["SalonBeautyTimeSlots:ShowOnAppBoxDescription"]</span>
                                </div>
                                <input type="hidden" class="timeslot-showonapp-value" value="@(Model.IsShowOnApp ? "true" : "false")" />
                                <div class="timeslot-switch-wrap">
                                    <label class="timeslot-switch">
                                        <input type="checkbox" class="timeslot-showonapp-toggle" @(Model.IsShowOnApp ? "checked" : "") />
                                        <span class="timeslot-switch-slider"></span>
                                    </label>
                                    <strong class="timeslot-showonapp-toggle-text"
                                            data-active="@L["Yes"]"
                                            data-inactive="@L["No"]">
                                        @(Model.IsShowOnApp ? L["Yes"] : L["No"])
                                    </strong>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="timeslot-modal-footer">
                    <button type="button" class="btn timeslot-btn-secondary" data-bs-dismiss="modal">@L["Cancel"]</button>
                    <button type="button" class="btn timeslot-btn-primary timeslot-submit-button" id="EditTimeSlotSubmit"><i class="fa fa-save"></i> @L["Save"]</button>
                </div>
            </div>
        </abp-modal-body>
    </abp-modal>
</form>

<script>
    (function () {
        var l = abp.localization.getResource('MultiTenancy');
        var slotService = genora.multiTenancy.appServices.salonBeauties.salonBeautyTimeSlot;

        var $form = $('#EditTimeSlotForm');
        var $modalRoot = $form.find('.timeslot-modal');
        var locations = $modalRoot.data('locations') || [];
        var initialRanges = $modalRoot.data('ranges') || [];
        var initialMask = parseInt($modalRoot.data('weekday-mask'), 10) || 127;

        function pad2(n) { return String(n).padStart(2, '0'); }
        function htmlEncode(v) { return $('<div/>').text(v || '').html(); }

        function getCfg(id) {
            for (var i = 0; i < locations.length; i++) if (locations[i].id === id) return locations[i];
            return null;
        }

        function timeToMin(t) {
            if (!t) return 0;
            var p = String(t).split(':');
            return (parseInt(p[0], 10) || 0) * 60 + (parseInt(p[1], 10) || 0);
        }
        function minToTime(m) {
            m = Math.max(0, Math.min(24 * 60, parseInt(m, 10) || 0));
            return pad2(Math.floor(m / 60)) + ':' + pad2(m % 60);
        }
        function toIsoDate(v) {
            if (!v) return null;
            var s = (v || '').trim();
            if (/^\d{4}-\d{2}-\d{2}$/.test(s)) return s;
            var m = s.match(/^(\d{1,2})\/(\d{1,2})\/(\d{4})$/);
            if (m) return m[3] + '-' + pad2(m[2]) + '-' + pad2(m[1]);
            return s;
        }

        function updateLocationHint() {
            var cfg = getCfg($('#EditTimeSlotLocationSelect').val());
            var $hint = $form.find('.timeslot-location-hint');
            if (!cfg) { $hint.text(''); return; }
            $hint.text(cfg.openTime + ' - ' + cfg.closeTime
                + ' · ' + l('SalonBeautyLocations:SlotDuration') + ': ' + cfg.slotDuration + 'p'
                + ' · ' + l('SalonBeautyLocations:BufferTime') + ': ' + cfg.bufferTime + 'p'
                + ' · ' + l('SalonBeautyLocations:MaxCapacityPerSlot') + ': ' + cfg.maxCapacityPerSlot);
        }

        function buildRangeRow(start, end, capacity, bookedCount, maxCap, isPeak) {
            var max = Math.max(1, maxCap || 1);
            var cap = capacity > 0 ? capacity : 1;
            if (cap > max) cap = max;
            var disableBtn = max <= 1 ? ' disabled' : '';
            var peakChecked = isPeak ? ' checked' : '';
            return '<div class="timeslot-range-row" data-range-row>'
                + '<input type="time" class="form-control timeslot-form-control timeslot-range-start" value="' + htmlEncode(start) + '" />'
                + '<input type="time" class="form-control timeslot-form-control timeslot-range-end" value="' + htmlEncode(end) + '" />'
                + '<div class="timeslot-capacity-wrap">'
                + '<button type="button" class="timeslot-cap-btn timeslot-cap-dec" tabindex="-1"' + disableBtn + '><i class="fa fa-minus"></i></button>'
                + '<input type="number" min="1" max="' + max + '" class="form-control timeslot-form-control timeslot-range-capacity" value="' + cap + '"' + (max <= 1 ? ' readonly' : '') + ' />'
                + '<button type="button" class="timeslot-cap-btn timeslot-cap-inc" tabindex="-1"' + disableBtn + '><i class="fa fa-plus"></i></button>'
                + '<span class="timeslot-capacity-hint"><span class="timeslot-capacity-current">' + cap + '</span>/<span class="timeslot-capacity-max">' + max + '</span></span>'
                + '</div>'
                + '<label class="timeslot-peak-wrap" title="' + l('SalonBeautyTimeSlots:PeakHourHint') + '">'
                + '<span class="timeslot-peak-label">' + l('SalonBeautyTimeSlots:PeakHourLabel') + '</span>'
                + '<span class="timeslot-switch timeslot-peak-switch">'
                + '<input type="checkbox" class="timeslot-range-peak"' + peakChecked + ' />'
                + '<span class="timeslot-switch-slider"></span>'
                + '</span>'
                + '</label>'
                + '<button type="button" class="timeslot-remove-range-btn"><i class="fa fa-trash"></i></button>'
                + '</div>';
        }

        function setRangesFromInitial() {
            var cfg = getCfg($('#EditTimeSlotLocationSelect').val());
            var maxCap = cfg ? cfg.maxCapacityPerSlot : 1;
            var $list = $form.find('[data-ranges-list]').empty();
            if (!initialRanges || !initialRanges.length) {
                if (cfg) {
                    var openMin = timeToMin(cfg.openTime);
                    var closeMin = timeToMin(cfg.closeTime);
                    var endMin = Math.min(openMin + (cfg.slotDuration || 60), closeMin);
                    $list.append(buildRangeRow(minToTime(openMin), minToTime(endMin), 1, 0, maxCap, false));
                } else {
                    $list.append(buildRangeRow('08:00', '09:00', 1, 0, 1, false));
                }
                return;
            }
            initialRanges.forEach(function (r) {
                $list.append(buildRangeRow(r.startTime, r.endTime, r.capacity || 1, 0, maxCap, !!r.isPeakHour));
            });
        }

        function resetRangesByLocation() {
            var cfg = getCfg($('#EditTimeSlotLocationSelect').val());
            var $list = $form.find('[data-ranges-list]').empty();
            if (!cfg) return;
            var openMin = timeToMin(cfg.openTime);
            var closeMin = timeToMin(cfg.closeTime);
            var endMin = Math.min(openMin + (cfg.slotDuration || 60), closeMin);
            $list.append(buildRangeRow(minToTime(openMin), minToTime(endMin), 1, 0, cfg.maxCapacityPerSlot, false));
        }

        function getRanges() {
            var ranges = [];
            $form.find('[data-range-row]').each(function () {
                var s = $(this).find('.timeslot-range-start').val();
                var e = $(this).find('.timeslot-range-end').val();
                var cap = parseInt($(this).find('.timeslot-range-capacity').val(), 10);
                var isPeak = $(this).find('.timeslot-range-peak').is(':checked');
                if (s && e) ranges.push({
                    startTime: s + ':00',
                    endTime: e + ':00',
                    capacity: isNaN(cap) || cap < 1 ? null : cap,
                    isPeakHour: isPeak
                });
            });
            return ranges;
        }

        function recalcWeekdayMask() {
            var mask = 0;
            $form.find('.timeslot-weekday-chip.active').each(function () {
                mask |= (1 << parseInt($(this).data('day'), 10));
            });
            $form.find('.timeslot-weekday-mask').val(mask || 127);
        }

        function applyWeekdayMask(mask) {
            if (!mask) mask = 127;
            $form.find('.timeslot-weekday-chip').each(function () {
                var bit = 1 << parseInt($(this).data('day'), 10);
                $(this).toggleClass('active', (mask & bit) !== 0);
            });
            $form.find('.timeslot-weekday-mask').val(mask);
        }

        function syncToggles() {
            var on = $form.find('.timeslot-status-toggle').is(':checked');
            $form.find('.timeslot-status-value').val(on ? '1' : '0');
            var $t1 = $form.find('.timeslot-status-toggle-text');
            $t1.text(on ? $t1.data('active') : $t1.data('inactive'));
            var on2 = $form.find('.timeslot-showonapp-toggle').is(':checked');
            $form.find('.timeslot-showonapp-value').val(on2 ? 'true' : 'false');
            var $t2 = $form.find('.timeslot-showonapp-toggle-text');
            $t2.text(on2 ? $t2.data('active') : $t2.data('inactive'));
        }

        // Init flatpickr
        if (window.flatpickr) {
            flatpickr('#EditTimeSlotFromDate', { dateFormat: 'd/m/Y', allowInput: true });
            flatpickr('#EditTimeSlotToDate', { dateFormat: 'd/m/Y', allowInput: true });
        }

        applyWeekdayMask(initialMask);
        updateLocationHint();
        setRangesFromInitial();
        syncToggles();

        $('#EditTimeSlotLocationSelect').on('change', function () {
            updateLocationHint();
            resetRangesByLocation();
        });

        $form.on('click', '.timeslot-weekday-chip', function () {
            $(this).toggleClass('active');
            recalcWeekdayMask();
        });

        $form.on('change', '.timeslot-status-toggle, .timeslot-showonapp-toggle', syncToggles);

        $form.on('click', '[data-add-range]', function () {
            var cfg = getCfg($('#EditTimeSlotLocationSelect').val());
            if (!cfg) { abp.notify.warn(l('SalonBeautyTimeSlots:LocationRequired')); return; }
            var closeMin = timeToMin(cfg.closeTime);
            var slotDur = parseInt(cfg.slotDuration, 10) || 60;
            var buffer = parseInt(cfg.bufferTime, 10) || 0;
            var $rows = $form.find('[data-range-row]');
            var lastEndMin = $rows.length ? timeToMin($rows.last().find('.timeslot-range-end').val()) : timeToMin(cfg.openTime);
            var startMin = lastEndMin + buffer;
            if (startMin >= closeMin) { abp.notify.warn(l('SalonBeautyTimeSlots:RangeOutsideLocation')); return; }
            var endMin = Math.min(startMin + slotDur, closeMin);
            if (endMin - startMin < 5) { abp.notify.warn(l('SalonBeautyTimeSlots:RangeOutsideLocation')); return; }
            $form.find('[data-ranges-list]').append(
                buildRangeRow(minToTime(startMin), minToTime(endMin), 1, 0, cfg.maxCapacityPerSlot, false));
        });

        $form.on('click', '[data-auto-generate]', function () {
            var locId = $('#EditTimeSlotLocationSelect').val();
            if (!locId) { abp.notify.warn(l('SalonBeautyTimeSlots:LocationRequired')); return; }
            var $btn = $(this).prop('disabled', true);
            slotService.generateRangesByLocation(locId).then(function (items) {
                var cfg = getCfg(locId);
                var maxCap = cfg ? cfg.maxCapacityPerSlot : 1;
                var $list = $form.find('[data-ranges-list]').empty();
                (items || []).forEach(function (r) {
                    var s = r.startTime ? r.startTime.substring(0, 5) : '08:00';
                    var e = r.endTime ? r.endTime.substring(0, 5) : '09:00';
                    $list.append(buildRangeRow(s, e, r.capacity || 1, r.bookedCount || 0, maxCap, !!r.isPeakHour));
                });
            }).always(function () { $btn.prop('disabled', false); });
        });

        $form.on('click', '.timeslot-cap-inc', function () {
            if ($(this).is(':disabled')) return;
            var $row = $(this).closest('[data-range-row]');
            var $cap = $row.find('.timeslot-range-capacity');
            var max = parseInt($cap.attr('max'), 10) || 1;
            var v = Math.min(max, (parseInt($cap.val(), 10) || 0) + 1);
            $cap.val(v); $row.find('.timeslot-capacity-current').text(v);
        });
        $form.on('click', '.timeslot-cap-dec', function () {
            if ($(this).is(':disabled')) return;
            var $row = $(this).closest('[data-range-row]');
            var $cap = $row.find('.timeslot-range-capacity');
            var v = Math.max(1, (parseInt($cap.val(), 10) || 1) - 1);
            $cap.val(v); $row.find('.timeslot-capacity-current').text(v);
        });
        $form.on('input change', '.timeslot-range-capacity', function () {
            var v = parseInt($(this).val(), 10);
            var max = parseInt($(this).attr('max'), 10) || 1;
            if (isNaN(v) || v < 1) v = 1;
            if (v > max) v = max;
            $(this).val(v).closest('[data-range-row]').find('.timeslot-capacity-current').text(v);
        });

        $form.on('click', '.timeslot-remove-range-btn', function () {
            var $row = $(this).closest('[data-range-row]');
            if ($form.find('[data-range-row]').length <= 1) {
                abp.notify.warn(l('SalonBeautyTimeSlots:TimeRangeRequired')); return;
            }
            $row.remove();
        });

        $('#EditTimeSlotSubmit').on('click', function () {
            var stylistId = $('#EditTimeSlotStylistId').val();
            var locId = $('#EditTimeSlotLocationSelect').val();
            var fromDate = toIsoDate($('#EditTimeSlotFromDate').val());
            var toDate = toIsoDate($('#EditTimeSlotToDate').val());
            var ranges = getRanges();
            var weekdayMask = parseInt($form.find('.timeslot-weekday-mask').val(), 10) || 127;
            var status = parseInt($form.find('.timeslot-status-value').val(), 10);
            if (isNaN(status)) status = 1;
            var isShowOnApp = $form.find('.timeslot-showonapp-value').val() === 'true';
            var note = $form.find('.timeslot-note').val() || null;

            if (!locId) { abp.notify.warn(l('SalonBeautyTimeSlots:LocationRequired')); return; }
            if (!fromDate || !toDate) { abp.notify.warn(l('SalonBeautyTimeSlots:DateRangeRequired')); return; }
            if (new Date(fromDate) > new Date(toDate)) { abp.notify.warn(l('SalonBeautyTimeSlots:DateRangeInvalid')); return; }
            if (!ranges.length) { abp.notify.warn(l('SalonBeautyTimeSlots:TimeRangeRequired')); return; }
            for (var i = 0; i < ranges.length; i++) {
                if (ranges[i].startTime >= ranges[i].endTime) {
                    abp.notify.warn(l('SalonBeautyTimeSlots:TimeRangeInvalid')); return;
                }
            }

            var $btn = $(this).prop('disabled', true).addClass('disabled');
            slotService.updateByStylist(stylistId, {
                locationId: locId,
                stylistId: stylistId,
                fromDate: fromDate,
                toDate: toDate,
                ranges: ranges,
                weekdayMask: weekdayMask,
                isShowOnApp: isShowOnApp,
                status: status,
                note: note
            }).then(function () {
                abp.notify.success(l('SavedSuccessfully'));
                var modalEl = $form.find('.modal')[0] || $form.closest('.modal')[0];
                if (modalEl && window.bootstrap && bootstrap.Modal) {
                    bootstrap.Modal.getOrCreateInstance(modalEl).hide();
                } else if (modalEl && $.fn.modal) {
                    $(modalEl).modal('hide');
                } else {
                    $form.find('[data-bs-dismiss="modal"]').first().trigger('click');
                }
                if (window.salonTimeSlotReload) window.salonTimeSlotReload();
            }).always(function () {
                $btn.prop('disabled', false).removeClass('disabled');
            });
        });
    })();
</script>
