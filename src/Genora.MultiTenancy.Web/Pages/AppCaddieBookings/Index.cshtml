@page
@using Genora.MultiTenancy.Permissions
@using Microsoft.AspNetCore.Authorization
@using Genora.MultiTenancy.Web.Pages.AppCaddieBookings
@inject IAuthorizationService AuthorizationService
@inject Volo.Abp.MultiTenancy.ICurrentTenant CurrentTenant
@model IndexModel

@section styles {
    <abp-style src="/pages/caddie/caddie-shared.css" />
}

@section scripts {
    <abp-script src="/Pages/AppCaddieBookings/index.js" />
}

@{
    var canEdit = CurrentTenant.IsAvailable
        ? await AuthorizationService.IsGrantedAsync(MultiTenancyPermissions.AppCaddieBookings.Edit)
        : await AuthorizationService.IsGrantedAsync(MultiTenancyPermissions.HostAppCaddieBookings.Edit);
    var canDelete = CurrentTenant.IsAvailable
        ? await AuthorizationService.IsGrantedAsync(MultiTenancyPermissions.AppCaddieBookings.Delete)
        : await AuthorizationService.IsGrantedAsync(MultiTenancyPermissions.HostAppCaddieBookings.Delete);
}

<div class="caddie-page">
    <div class="caddie-header-row">
        <div>
            <h1 class="caddie-page-title">Lịch sử đặt Caddy</h1>
            <p class="caddie-page-subtitle">Quản lý và theo dõi toàn bộ booking caddie trong hệ thống.</p>
        </div>
    </div>

    <!-- Filters -->
    <div class="d-flex flex-wrap gap-3 mb-4">
        <div class="caddie-schedule-filter-group">
            <label class="caddie-schedule-filter-label">Tìm kiếm</label>
            <input id="BookingFilter" class="form-control caddie-form-control" style="min-width:200px;" placeholder="Mã booking, tên KH, SĐT..." />
        </div>
        <div class="caddie-schedule-filter-group">
            <label class="caddie-schedule-filter-label">Trạng thái</label>
            <select id="BookingStatusFilter" class="form-select caddie-form-control" style="min-width:150px;">
                <option value="">Tất cả</option>
                <option value="1">Mới</option>
                <option value="2">Đã xác nhận</option>
                <option value="3">Hoàn thành</option>
                <option value="4">Đã hủy</option>
            </select>
        </div>
        <div class="caddie-schedule-filter-group">
            <label class="caddie-schedule-filter-label">Thanh toán</label>
            <select id="BookingPaymentFilter" class="form-select caddie-form-control" style="min-width:150px;">
                <option value="">Tất cả</option>
                <option value="1">Chưa thanh toán</option>
                <option value="2">Đã thanh toán</option>
            </select>
        </div>
        <div class="caddie-schedule-filter-group">
            <label class="caddie-schedule-filter-label">Từ ngày</label>
            <input type="date" id="BookingFromDate" class="form-control caddie-form-control" style="min-width:140px;" />
        </div>
        <div class="caddie-schedule-filter-group">
            <label class="caddie-schedule-filter-label">Đến ngày</label>
            <input type="date" id="BookingToDate" class="form-control caddie-form-control" style="min-width:140px;" />
        </div>
        <div class="caddie-schedule-filter-group d-flex align-items-end">
            <button id="BtnSearch" class="btn-caddie-primary" style="padding:10px 20px;"><i class="fa fa-search"></i> Tìm</button>
        </div>
    </div>

    <!-- Table -->
    <div class="caddie-table-container">
        <div class="table-responsive">
            <table id="CaddieBookingsTable" class="caddie-table"></table>
        </div>
    </div>
</div>

<!-- Status Update Modal -->
<div class="modal fade" id="statusUpdateModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content" style="border-radius:12px;border:none;">
            <div class="modal-header" style="border-bottom:1px solid rgba(192,199,212,0.1);padding:20px 24px;">
                <h5 class="modal-title" style="font-family:'Manrope';font-weight:800;">Cập nhật trạng thái</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" style="padding:24px;">
                <input type="hidden" id="statusBookingId" />
                <div class="mb-3">
                    <label class="caddie-form-label">Trạng thái booking</label>
                    <select id="statusNewValue" class="form-select caddie-form-control">
                        <option value="2">Đã xác nhận</option>
                        <option value="3">Hoàn thành</option>
                        <option value="4">Đã hủy</option>
                    </select>
                </div>
                <div class="mb-3" id="cancelReasonGroup" style="display:none;">
                    <label class="caddie-form-label">Lý do hủy <span class="text-danger">*</span></label>
                    <textarea id="cancelReasonInput" class="form-control caddie-form-control" rows="2" style="resize:none;" placeholder="Nhập lý do hủy..."></textarea>
                </div>
            </div>
            <div class="modal-footer" style="border-top:1px solid rgba(192,199,212,0.1);padding:16px 24px;">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal" style="font-weight:700;">Hủy</button>
                <button type="button" class="btn-caddie-primary" id="btnConfirmStatus"><i class="fa fa-check"></i> Xác nhận</button>
            </div>
        </div>
    </div>
</div>

<input type="hidden" id="CanEdit" value="@canEdit.ToString().ToLower()" />
<input type="hidden" id="CanDelete" value="@canDelete.ToString().ToLower()" />
