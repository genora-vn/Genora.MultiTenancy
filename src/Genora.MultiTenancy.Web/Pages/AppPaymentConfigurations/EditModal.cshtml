@page
@using Genora.MultiTenancy.Localization
@using Genora.MultiTenancy.Web.Pages.AppPaymentConfigurations
@using Microsoft.Extensions.Localization
@using Volo.Abp.AspNetCore.Mvc.UI.Bootstrap.TagHelpers.Modal
@model EditModalModel
@inject IStringLocalizer<MultiTenancyResource> L

@{
    Layout = null;
}

<form asp-page="/AppPaymentConfigurations/EditModal" method="post">
    <abp-modal>
        <abp-modal-header title="@L["EditPaymentConfiguration"]"></abp-modal-header>
        <abp-modal-body>
            <input asp-for="Id" type="hidden" />
            <div class="row g-3">
                <div class="col-md-8">
                    <abp-input asp-for="Config.PaymentProviderName"
                               label="Nhà cung cấp thanh toán"
                               placeholder="Ví dụ: VietQR, PayOS, Momo" />
                </div>
                <div class="col-md-4">
                    <abp-input asp-for="Config.DisplayOrder"
                               label="Thứ tự hiển thị" />
                </div>
                <div class="col-md-4">
                    <abp-input asp-for="Config.BankBin"
                               label="Mã BIN ngân hàng"
                               placeholder="Ví dụ: 970436" />
                </div>
                <div class="col-md-4">
                    <abp-input asp-for="Config.AccountNumber"
                               label="Số tài khoản"
                               placeholder="Ví dụ: 1234567890" />
                </div>
                <div class="col-md-4">
                    <abp-input asp-for="Config.AccountName"
                               label="Tên chủ tài khoản"
                               placeholder="Ví dụ: NGUYEN VAN A" />
                </div>
                <div class="col-md-6">
                    <abp-input asp-for="Config.MerchantId"
                               label="Merchant ID"
                               placeholder="Dùng cho cổng thanh toán (tùy chọn)" />
                </div>
                <div class="col-md-6">
                    <abp-input asp-for="Config.ApiKey"
                               label="API Key"
                               placeholder="Khóa bảo mật (tùy chọn)" />
                </div>
                <div class="col-md-8">
                    <abp-input asp-for="Config.Description"
                               label="Mô tả hiển thị"
                               placeholder="Ví dụ: Vietcombank - QR thanh toán nhanh" />
                </div>
                <div class="col-md-4">
                    <abp-input asp-for="Config.LogoUrl"
                               label="URL Logo"
                               placeholder="https://..." />
                </div>
                <div class="col-md-12">
                    <abp-input asp-for="Config.IsActive"
                               label="Đang hoạt động" />
                </div>
            </div>
        </abp-modal-body>
        <abp-modal-footer buttons="@(AbpModalButtons.Cancel | AbpModalButtons.Save)"></abp-modal-footer>
    </abp-modal>
</form>
