@page
@using Genora.MultiTenancy.Localization
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<MultiTenancyResource> L
@model Genora.MultiTenancy.Web.Pages.Hlg.Questions.IndexModel
@section styles { <link rel="stylesheet" href="/libs/select2/css/select2.min.css" /> }
@section scripts {
    <abp-script src="/libs/select2/js/select2.full.min.js" />
    <abp-script src="/Pages/Hlg/editor.js" />
    <abp-script src="/Pages/Hlg/admin.js" />
    <abp-script src="/Pages/Hlg/Questions/index.js" />
}
@{
    var canCreate = await Model.GrantedAsync(".Create");
    var canEdit = await Model.GrantedAsync(".Edit");
    var canDelete = await Model.GrantedAsync(".Delete");
}
<div id="HlgAdmin" data-create="@canCreate.ToString().ToLowerInvariant()" data-edit="@canEdit.ToString().ToLowerInvariant()" data-delete="@canDelete.ToString().ToLowerInvariant()" data-parent-id="@Model.ParentId">
    <a asp-page="/Hlg/Games/Index">@L["Hlg:Games"]</a><p class="text-muted">@Model.ParentName</p>
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1>@L["Hlg:Questions"]</h1>
        <div class="d-flex gap-2 flex-wrap justify-content-end">
            <button id="HlgDownloadQuestionTemplate" class="btn btn-outline-secondary" type="button">
                <i class="fa fa-download"></i> @L["DownloadTemplateBtn"]
            </button>
            @if (canCreate && canEdit)
            {
                <button id="HlgImportQuestions" class="btn btn-outline-secondary" type="button">
                    <i class="fa fa-upload"></i> @L["ImportExcel"]
                </button>
                <input id="HlgQuestionExcelFile" type="file" accept=".xlsx" class="d-none" />
            }
            @if (canCreate)
            {
                <button id="HlgCreate" class="btn btn-primary" type="button">@L["Hlg:Create"]</button>
            }
        </div>
    </div>
    <div id="HlgError" role="alert" class="alert alert-danger d-none"></div>
    <div class="card mb-3">
        <div class="card-body">
            <form id="HlgFilter" class="row g-3 align-items-end">
                <div class="col-md-6"><label for="HlgSearch" class="form-label">@L["Hlg:Search"]</label><input id="HlgSearch" class="form-control" placeholder="@L["Hlg:SearchPlaceholder"]" /></div>
                <div class="col-md-3"><label for="HlgActive" class="form-label">@L["Hlg:IsActive"]</label><select id="HlgActive" class="form-select"><option value="">@L["Hlg:All"]</option><option value="true">@L["Hlg:Active"]</option><option value="false">@L["Hlg:Inactive"]</option></select></div>
                <div class="col-md-3"><button type="submit" class="btn btn-primary">@L["Hlg:Search"]</button> <button id="HlgReset" type="button" class="btn btn-outline-secondary">@L["Hlg:Reset"]</button></div>
            </form>
        </div>
    </div>
    <div class="card"><div class="card-body"><table id="HlgTable" class="table table-striped w-100"></table></div></div>
</div>
