@page
@using Genora.MultiTenancy.Localization
@using Microsoft.Extensions.Localization
@using Volo.Abp.AspNetCore.Mvc.UI.Bootstrap.TagHelpers.Modal
@inject IStringLocalizer<MultiTenancyResource> L
@model Genora.MultiTenancy.Web.Pages.Hlg.Ranking.CreateModalModel
@{
    Layout = null;
}
<form method="post" asp-page="/Hlg/Ranking/CreateModal" id="CreateHlgRanking">
    <abp-modal size="Large">
        <abp-modal-header title="@L["Hlg:Create"].Value"></abp-modal-header>
        <abp-modal-body>
            <div asp-validation-summary="All" class="text-danger"></div>
            <div class="mb-3">
                <label asp-for="Input.Title" class="form-label">@L["Hlg:Title"]</label>
                <input asp-for="Input.Title" type="text" class="form-control" />
                <span asp-validation-for="Input.Title" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Input.Description" class="form-label">@L["Hlg:Description"]</label>
<textarea asp-for="Input.Description" rows="4" class="form-control"></textarea>
                <span asp-validation-for="Input.Description" class="text-danger"></span>
            </div>
            <div class="mb-3 row">
                <div class="col-md-6">
                    <label asp-for="Input.StartAt" class="form-label">@L["Hlg:StartAt"]</label>
                    <input asp-for="Input.StartAt" type="text" class="form-control flatpickr-datetime" asp-format="{0:yyyy-MM-dd HH:mm}" autocomplete="off" />
                    <span asp-validation-for="Input.StartAt" class="text-danger"></span>
                </div>
                <div class="col-md-6">
                    <label asp-for="Input.EndAt" class="form-label">@L["Hlg:EndAt"]</label>
                    <input asp-for="Input.EndAt" type="text" class="form-control flatpickr-datetime" asp-format="{0:yyyy-MM-dd HH:mm}" autocomplete="off" />
                    <span asp-validation-for="Input.EndAt" class="text-danger"></span>
                </div>
            </div>
            <div class="mb-3">
                <label asp-for="Input.IsActive" class="form-label">@L["Hlg:IsActive"]</label>
                <input asp-for="Input.IsActive" class="form-check-input ms-2" />
                <span asp-validation-for="Input.IsActive" class="text-danger"></span>
            </div>
<input asp-for="Input.GameId" type="hidden" />
            <div class="mb-3">
                <label asp-for="Input.GameIds" class="form-label">Các trò chơi thuộc chiến dịch</label>
                <select asp-for="Input.GameIds" class="form-select hlg-game-select" multiple asp-items="Model.GameOptions"></select>
                <div class="form-text">Chọn một hoặc nhiều trò chơi thuộc chiến dịch (có tìm kiếm). Dùng cho mẫu số "Đã tham gia" và phạm vi xếp hạng.</div>
                <span asp-validation-for="Input.GameIds" class="text-danger"></span>
            </div>
        </abp-modal-body><abp-modal-footer buttons="@(AbpModalButtons.Cancel | AbpModalButtons.Save)"></abp-modal-footer>
    </abp-modal>
</form>
<script>
    (function () {
        if (window.flatpickr) {
            flatpickr('#CreateHlgRanking .flatpickr-datetime', {
                enableTime: true,
                dateFormat: 'Y-m-d H:i',
                time_24hr: true,
                allowInput: true,
                static: true,
                minuteIncrement: 1
            });
        }
        var $ = window.jQuery;
        if ($ && $.fn.select2) {
            var $sel = $('#CreateHlgRanking .hlg-game-select');
            $sel.select2({
                width: '100%',
                placeholder: 'Chọn trò chơi...',
                closeOnSelect: false,
                allowClear: true,
                dropdownParent: $sel.closest('.modal').length ? $sel.closest('.modal') : $(document.body)
            });
        }
    })();
</script>
