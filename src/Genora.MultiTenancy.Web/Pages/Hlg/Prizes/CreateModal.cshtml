@page
@using Genora.MultiTenancy.Localization
@using Microsoft.Extensions.Localization
@using Volo.Abp.AspNetCore.Mvc.UI.Bootstrap.TagHelpers.Modal
@inject IStringLocalizer<MultiTenancyResource> L
@model Genora.MultiTenancy.Web.Pages.Hlg.Prizes.CreateModalModel
@{ Layout=null; }
<form method="post" asp-page="/Hlg/Prizes/CreateModal"><input asp-for="Id" type="hidden" />
<abp-modal size="Large"><abp-modal-header title="@L["Hlg:Create"].Value" /><abp-modal-body>
<div asp-validation-summary="All" class="text-danger"></div><div class="mb-3"><label asp-for="Input.EventId" class="form-label">@L["Hlg:EventId"]</label><select asp-for="Input.EventId" class="form-select" data-hlg-lookup="events"><option value="">@L["Hlg:Select"]</option>@if (Model.Input.EventId != Guid.Empty) { <option value="@Model.Input.EventId" selected>@Model.Input.EventId</option> }</select><span asp-validation-for="Input.EventId" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="Input.RewardId" class="form-label">@L["Hlg:RewardId"]</label><select asp-for="Input.RewardId" class="form-select" data-hlg-lookup="rewards"><option value="">@L["Hlg:Select"]</option>@if (Model.Input.RewardId != Guid.Empty) { <option value="@Model.Input.RewardId" selected>@Model.Input.RewardId</option> }</select><span asp-validation-for="Input.RewardId" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="Input.Title" class="form-label">@L["Hlg:Title"]</label><input asp-for="Input.Title" type="text" class="form-control" /><span asp-validation-for="Input.Title" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="Input.Quantity" class="form-label">@L["Hlg:Quantity"]</label><input asp-for="Input.Quantity" type="number" class="form-control" /><span asp-validation-for="Input.Quantity" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="Input.DisplayOrder" class="form-label">@L["Hlg:DisplayOrder"]</label><input asp-for="Input.DisplayOrder" type="number" class="form-control" /><span asp-validation-for="Input.DisplayOrder" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="Input.IsActive" class="form-label">@L["Hlg:IsActive"]</label><input asp-for="Input.IsActive" class="form-check-input ms-2" /><span asp-validation-for="Input.IsActive" class="text-danger"></span></div>
</abp-modal-body><abp-modal-footer buttons="@(AbpModalButtons.Cancel | AbpModalButtons.Save)" /></abp-modal></form>
