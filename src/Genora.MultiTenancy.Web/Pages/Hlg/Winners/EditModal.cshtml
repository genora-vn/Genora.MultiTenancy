@page
@using Genora.MultiTenancy.Localization
@using Microsoft.Extensions.Localization
@using Volo.Abp.AspNetCore.Mvc.UI.Bootstrap.TagHelpers.Modal
@inject IStringLocalizer<MultiTenancyResource> L
@model Genora.MultiTenancy.Web.Pages.Hlg.Winners.EditModalModel
@{
    Layout = null;
}
<form method="post" asp-page="/Hlg/Winners/EditModal">
    <input asp-for="Id" type="hidden" />
    <input asp-for="Input.EventId" type="hidden" />
    <abp-modal size="Large">
        <abp-modal-header title="@L["Hlg:Edit"].Value"></abp-modal-header>
        <abp-modal-body>
            <div asp-validation-summary="All" class="text-danger"></div>
            <div class="alert alert-info">@L["Hlg:WinnerPublicationHint"]</div>
            <div class="mb-3">
                <label asp-for="Input.GameId" class="form-label">@L["Hlg:GameId"]</label>
                <select asp-for="Input.GameId" class="form-select">
                    <option value="">@L["Hlg:Select"]</option>
                    @foreach (var g in Model.EndedGames)
                    {
                        <option value="@g.Id">@g.Name</option>
                    }
                </select>
                <span asp-validation-for="Input.GameId" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Input.PrizeId" class="form-label">@L["Hlg:PrizeId"]</label>
                <select asp-for="Input.PrizeId" class="form-select" data-hlg-lookup="prizes">
                    <option value="">@L["Hlg:Select"]</option>
                    @if (Model.Input.PrizeId != Guid.Empty)
                    {
                        <option value="@Model.Input.PrizeId" selected>@Model.Input.PrizeId</option>
                    }
                </select>
                <span asp-validation-for="Input.PrizeId" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Input.CustomerId" class="form-label">@L["Hlg:CustomerId"]</label>
                <select asp-for="Input.CustomerId" class="form-select" data-hlg-lookup="customers">
                    <option value="">@L["Hlg:Select"]</option>
                    @if (Model.Input.CustomerId != Guid.Empty)
                    {
                        <option value="@Model.Input.CustomerId" selected>@Model.Input.CustomerId</option>
                    }
                </select>
                <span asp-validation-for="Input.CustomerId" class="text-danger"></span>
            </div>
            <div class="mb-3 form-check">
                <input asp-for="Input.IsActive" class="form-check-input" />
                <label asp-for="Input.IsActive" class="form-check-label">@L["Hlg:Published"]</label>
            </div>
        </abp-modal-body>
        <abp-modal-footer buttons="@(AbpModalButtons.Cancel | AbpModalButtons.Save)"></abp-modal-footer>
    </abp-modal>
</form>
