@page
@using System.Linq
@using Genora.MultiTenancy.Localization
@using Microsoft.Extensions.Localization
@using Volo.Abp.AspNetCore.Mvc.UI.Bootstrap.TagHelpers.Modal
@inject IStringLocalizer<MultiTenancyResource> L
@model Genora.MultiTenancy.Web.Pages.Hlg.Winners.CreateModalModel
@{
    Layout = null;
}
<form method="post" asp-page="/Hlg/Winners/CreateModal">
    <input asp-for="Id" type="hidden" />
    <input asp-for="Input.EventId" type="hidden" />
    <abp-modal size="Large">
        <abp-modal-header title="@L["Hlg:AwardByGame"].Value"></abp-modal-header>
        <abp-modal-body>
            <div asp-validation-summary="All" class="text-danger"></div>
            <div class="alert alert-info">@L["Hlg:WinnerBatchHint"]</div>
            <div class="mb-3">
                <label asp-for="Input.GameId" class="form-label">@L["Hlg:GameId"]</label>
                <select asp-for="Input.GameId" class="form-select">
                    <option value="">@L["Hlg:Select"]</option>
                    @foreach (var g in Model.EndedGames)
                    {
                        <option value="@g.Id">@g.Name</option>
                    }
                </select>
                @if (!Model.EndedGames.Any())
                {
                    <div class="form-text text-warning">@L["Hlg:NoEndedGame"]</div>
                }
                <span asp-validation-for="Input.GameId" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Input.PrizeId" class="form-label">@L["Hlg:PrizeId"]</label>
                <select asp-for="Input.PrizeId" class="form-select" data-hlg-lookup="prizes">
                    <option value="">@L["Hlg:Select"]</option>
                </select>
                <span asp-validation-for="Input.PrizeId" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Input.CustomerIds" class="form-label">@L["Hlg:Players"]</label>
                <select asp-for="Input.CustomerIds" class="form-select" multiple data-hlg-lookup="customers"></select>
                <div class="form-text">@L["Hlg:PlayersHint"]</div>
                <span asp-validation-for="Input.CustomerIds" class="text-danger"></span>
            </div>
            <div class="mb-3 form-check">
                <input asp-for="Input.IsActive" class="form-check-input" />
                <label asp-for="Input.IsActive" class="form-check-label">@L["Hlg:Published"]</label>
            </div>
        </abp-modal-body>
        <abp-modal-footer buttons="@(AbpModalButtons.Cancel | AbpModalButtons.Save)"></abp-modal-footer>
    </abp-modal>
</form>
