@page
@using Genora.MultiTenancy.Localization
@using Microsoft.Extensions.Localization
@using Volo.Abp.AspNetCore.Mvc.UI.Bootstrap.TagHelpers.Modal
@inject IStringLocalizer<MultiTenancyResource> L
@model Genora.MultiTenancy.Web.Pages.Hlg.Games.EditModalModel
@{
    Layout = null;
}
<form method="post" asp-page="/Hlg/Games/EditModal">
    <abp-modal size="Large">
        <abp-modal-header title="@L["Hlg:Edit"].Value"></abp-modal-header>
        <abp-modal-body>
            <div asp-validation-summary="All" class="text-danger"></div>
            <input asp-for="Id" type="hidden" />
            <div class="mb-3">
                <label asp-for="Input.Name" class="form-label">@L["Hlg:Name"]</label>
                <input asp-for="Input.Name" type="text" class="form-control" />
                <span asp-validation-for="Input.Name" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Input.Type" class="form-label">@L["Hlg:Type"]</label>
                <select asp-for="Input.Type" class="form-select">
                    <option value="1">@L["Hlg:Quiz"]</option>
                    <option value="2">@L["Hlg:PictureToWord"]</option>
                    <option value="3">@L["Hlg:KingOfVietnamese"]</option>
                    <option value="4">@L["Hlg:SpinWheel"]</option>
                    <option value="5">@L["Hlg:TileFlip"]</option>
                </select>
                <span asp-validation-for="Input.Type" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Input.ImageUrl" class="form-label">@L["Hlg:ImageUrl"]</label>
                <input asp-for="Input.ImageUrl" type="text" class="form-control" />
                <span asp-validation-for="Input.ImageUrl" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Input.Description" class="form-label">@L["Hlg:Description"]</label>
<textarea asp-for="Input.Description" rows="4" class="form-control"></textarea>
                <span asp-validation-for="Input.Description" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Input.Rules" class="form-label">@L["Hlg:Rules"]</label>
<textarea asp-for="Input.Rules" rows="4" class="form-control"></textarea>
                <span asp-validation-for="Input.Rules" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Input.RewardDescription" class="form-label">@L["Hlg:RewardDescription"]</label>
<textarea asp-for="Input.RewardDescription" rows="4" class="form-control"></textarea>
                <span asp-validation-for="Input.RewardDescription" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Input.Status" class="form-label">@L["Hlg:Status"]</label>
                <select asp-for="Input.Status" class="form-select">
                    <option value="1">@L["Hlg:Upcoming"]</option>
                    <option value="2">@L["Hlg:Ongoing"]</option>
                    <option value="3">@L["Hlg:Ended"]</option>
                </select>
                <span asp-validation-for="Input.Status" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Input.StartAt" class="form-label">@L["Hlg:StartAt"]</label>
                <input asp-for="Input.StartAt" type="datetime-local" class="form-control" asp-format="{0:yyyy-MM-ddTHH:mm}" />
                <span asp-validation-for="Input.StartAt" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Input.EndAt" class="form-label">@L["Hlg:EndAt"]</label>
                <input asp-for="Input.EndAt" type="datetime-local" class="form-control" asp-format="{0:yyyy-MM-ddTHH:mm}" />
                <span asp-validation-for="Input.EndAt" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Input.BaseScorePerQuestion" class="form-label">@L["Hlg:BaseScorePerQuestion"]</label>
                <input asp-for="Input.BaseScorePerQuestion" type="number" class="form-control" min="0" />
                <span asp-validation-for="Input.BaseScorePerQuestion" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Input.DisplayOrder" class="form-label">@L["Hlg:DisplayOrder"]</label>
                <input asp-for="Input.DisplayOrder" type="number" class="form-control" />
                <span asp-validation-for="Input.DisplayOrder" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Input.IsActive" class="form-label">@L["Hlg:IsActive"]</label>
                <input asp-for="Input.IsActive" class="form-check-input ms-2" />
                <span asp-validation-for="Input.IsActive" class="text-danger"></span>
            </div>
        </abp-modal-body><abp-modal-footer buttons="@(AbpModalButtons.Cancel | AbpModalButtons.Save)"></abp-modal-footer>
    </abp-modal>
</form>
