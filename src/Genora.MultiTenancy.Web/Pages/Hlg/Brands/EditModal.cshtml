@page
@using Genora.MultiTenancy.Localization
@using Microsoft.Extensions.Localization
@using Volo.Abp.AspNetCore.Mvc.UI.Bootstrap.TagHelpers.Modal
@inject IStringLocalizer<MultiTenancyResource> L
@model Genora.MultiTenancy.Web.Pages.Hlg.Brands.EditModalModel
@{ Layout=null; }
<form method="post" asp-page="/Hlg/Brands/EditModal"><input asp-for="Id" type="hidden" />
<abp-modal size="Large"><abp-modal-header title="@L["Hlg:Edit"].Value" /><abp-modal-body>
<div asp-validation-summary="All" class="text-danger"></div><div class="mb-3"><label asp-for="Input.CategoryId" class="form-label">@L["Hlg:CategoryId"]</label><select asp-for="Input.CategoryId" class="form-select" data-hlg-lookup="categories"><option value="">@L["Hlg:Select"]</option>@if (Model.Input.CategoryId != Guid.Empty) { <option value="@Model.Input.CategoryId" selected>@Model.Input.CategoryId</option> }</select><span asp-validation-for="Input.CategoryId" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="Input.Name" class="form-label">@L["Hlg:Name"]</label><input asp-for="Input.Name" type="text" class="form-control" /><span asp-validation-for="Input.Name" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="Input.DisplayOrder" class="form-label">@L["Hlg:DisplayOrder"]</label><input asp-for="Input.DisplayOrder" type="number" class="form-control" /><span asp-validation-for="Input.DisplayOrder" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="Input.IsActive" class="form-label">@L["Hlg:IsActive"]</label><input asp-for="Input.IsActive" class="form-check-input ms-2" /><span asp-validation-for="Input.IsActive" class="text-danger"></span></div>
</abp-modal-body><abp-modal-footer buttons="@(AbpModalButtons.Cancel | AbpModalButtons.Save)" /></abp-modal></form>
