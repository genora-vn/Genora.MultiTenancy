@page
@using Genora.MultiTenancy.Permissions
@using Microsoft.AspNetCore.Authorization
@using Genora.MultiTenancy.Web.Pages.AppCaddieSchedules
@inject IAuthorizationService AuthorizationService
@inject Volo.Abp.MultiTenancy.ICurrentTenant CurrentTenant
@model IndexModel

@section styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css" />
    <abp-style src="/pages/caddie/caddie-shared.css" />
}

@section scripts {
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <abp-script src="/Pages/AppCaddieSchedules/index.js" />
}

@{
    var canCreate = CurrentTenant.IsAvailable
        ? await AuthorizationService.IsGrantedAsync(MultiTenancyPermissions.AppCaddieSchedules.Create)
        : await AuthorizationService.IsGrantedAsync(MultiTenancyPermissions.HostAppCaddieSchedules.Create);
    var canEdit = CurrentTenant.IsAvailable
        ? await AuthorizationService.IsGrantedAsync(MultiTenancyPermissions.AppCaddieSchedules.Edit)
        : await AuthorizationService.IsGrantedAsync(MultiTenancyPermissions.HostAppCaddieSchedules.Edit);

    var weekDays = Enumerable.Range(0, 7).Select(i => Model.CurrentWeekStart.AddDays(i)).ToList();
    var today = DateTime.Today;
    var prevWeek = Model.CurrentWeekStart.AddDays(-7);
    var nextWeek = Model.CurrentWeekStart.AddDays(7);
}

<div class="caddie-schedule-page">
    <!-- Header -->
    <div class="caddie-header-row">
        <div>
            <h1 class="caddie-page-title">Lịch làm việc Caddy</h1>
            <p class="caddie-page-subtitle">Quản lý và theo dõi lịch phục vụ của đội ngũ Caddy.</p>
        </div>
    </div>

    <!-- Filters & View Toggle -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div class="d-flex flex-wrap align-items-center gap-2">
            <div class="caddie-schedule-filter-group" style="margin-bottom:0;">
                @* <label class="caddie-schedule-filter-label">Trạng thái</label> *@
                <select id="FilterStatus" class="form-select caddie-form-control" style="min-width:140px;">
                    <option value="">Mọi trạng thái</option>
                    <option value="1">Trống lịch</option>
                    <option value="2">Đang phục vụ</option>
                    <option value="3">Nghỉ</option>
                </select>
            </div>
            @if (canEdit)
            {
                <button type="button" id="btnDeleteRange" class="btn btn-sm btn-outline-danger" style="font-weight:600;border-radius:6px;white-space:nowrap;" title="Xóa lịch làm việc">
                    <i class="fa fa-trash me-1"></i> Xóa lịch
                </button>
                <button type="button" id="btnSaveTemplate" class="btn btn-sm btn-outline-warning" style="font-weight:600;border-radius:6px;white-space:nowrap;" title="Lưu lịch tuần hiện tại làm template">
                    <i class="fa fa-save me-1"></i> Lưu Template
                </button>
                <button type="button" id="btnApplyTemplate" class="btn btn-sm btn-outline-info" style="font-weight:600;border-radius:6px;white-space:nowrap;" title="Áp dụng template cho tuần tiếp theo">
                    <i class="fa fa-magic me-1"></i> Áp dụng Template
                </button>
            }
            <!-- Excel buttons inline -->
            <a href="/api/app/caddie-schedule-excel/download-template" class="btn btn-sm btn-outline-secondary" style="font-weight:600;border-radius:6px;white-space:nowrap;" title="Tải file mẫu">
                <i class="fa fa-file-excel me-1"></i> File mẫu
            </a>
            <button type="button" id="btnImportExcel" class="btn btn-sm btn-outline-primary" style="font-weight:600;border-radius:6px;white-space:nowrap;" title="Nhập từ Excel">
                <i class="fa fa-upload me-1"></i> Nhập Excel
            </button>
            <a href="/api/app/caddie-schedule-excel/export?fromDate=@Model.CurrentWeekStart.ToString("yyyy-MM-dd")&toDate=@Model.CurrentWeekStart.AddDays(Model.CurrentView == "month" ? 30 : 6).ToString("yyyy-MM-dd")" class="btn btn-sm btn-outline-success" style="font-weight:600;border-radius:6px;white-space:nowrap;" title="Xuất Excel">
                <i class="fa fa-download me-1"></i> Xuất Excel
            </a>
            <input type="file" id="excelFileInput" accept=".xlsx,.xls" style="display:none;" />
        </div>
        <div class="d-flex align-items-center gap-3">
            <!-- Navigation -->
            <div class="d-flex align-items-center gap-2">
                <a href="/AppCaddieSchedules?weekStart=@prevWeek.ToString("yyyy-MM-dd")&view=@Model.CurrentView" class="btn btn-sm btn-light"><i class="fa fa-chevron-left"></i></a>
                <span style="font-weight:700;font-size:0.875rem;white-space:nowrap;" id="dateRangeLabel">@Model.CurrentWeekStart.ToString("dd/MM") — @Model.CurrentWeekStart.AddDays(6).ToString("dd/MM/yyyy")</span>
                <a href="/AppCaddieSchedules?weekStart=@nextWeek.ToString("yyyy-MM-dd")&view=@Model.CurrentView" class="btn btn-sm btn-light"><i class="fa fa-chevron-right"></i></a>
            </div>
            <!-- View Toggle -->
            <div class="caddie-schedule-view-toggle">
                <a href="/AppCaddieSchedules?weekStart=@Model.CurrentWeekStart.ToString("yyyy-MM-dd")&view=day" class="caddie-schedule-view-btn @(Model.CurrentView == "day" ? "active" : "")">Ngày</a>
                <a href="/AppCaddieSchedules?weekStart=@Model.CurrentWeekStart.ToString("yyyy-MM-dd")&view=week" class="caddie-schedule-view-btn @(Model.CurrentView == "week" ? "active" : "")">Tuần</a>
                <a href="/AppCaddieSchedules?weekStart=@Model.CurrentWeekStart.ToString("yyyy-MM-dd")&view=month" class="caddie-schedule-view-btn @(Model.CurrentView == "month" ? "active" : "")">Tháng</a>
            </div>
        </div>
    </div>

    <!-- Legend -->
    <div class="caddie-schedule-legend">
        <span class="caddie-schedule-legend-label">Chú giải:</span>
        <div class="caddie-schedule-legend-item">
            <div class="caddie-schedule-legend-dot available"></div>
            <span>Trống lịch</span>
        </div>
        <div class="caddie-schedule-legend-item">
            <div class="caddie-schedule-legend-dot booked"></div>
            <span>Đang phục vụ</span>
        </div>
        <div class="caddie-schedule-legend-item">
            <div class="caddie-schedule-legend-dot off"></div>
            <span>Nghỉ</span>
        </div>
    </div>

    <!-- Calendar Grid -->
    @if (Model.CurrentView == "day")
    {
        <!-- Day View: show only today or selected day -->
        var selectedDay = Model.CurrentWeekStart;
        var daySchedules = Model.Schedules.Where(s => s.WorkDate.Date == selectedDay.Date).ToList();
        var dayName = selectedDay.DayOfWeek switch
        {
            DayOfWeek.Monday => "Thứ 2",
            DayOfWeek.Tuesday => "Thứ 3",
            DayOfWeek.Wednesday => "Thứ 4",
            DayOfWeek.Thursday => "Thứ 5",
            DayOfWeek.Friday => "Thứ 6",
            DayOfWeek.Saturday => "Thứ 7",
            DayOfWeek.Sunday => "Chủ Nhật",
            _ => ""
        };
        <div class="caddie-calendar">
            <div class="caddie-calendar-header">
                <div class="caddie-calendar-header-cell today" style="flex:1;">
                    <div class="day-name">@dayName</div>
                    <div class="day-num">@selectedDay.Day/@selectedDay.Month/@selectedDay.Year</div>
                </div>
            </div>
            <div class="caddie-calendar-body" style="grid-template-columns:1fr;">
                <div class="caddie-calendar-day today" style="min-height:400px;">
                    @if (daySchedules.Any())
                    {
                        @foreach (var schedule in daySchedules)
                        {
                            var cardClass = schedule.SlotStatus switch { 2 => "booked", 3 => "off", _ => "" };
                            var codeClass = schedule.SlotStatus switch { 2 => "booked", 3 => "off", _ => "available" };
                            <div class="caddie-schedule-card @cardClass" data-id="@schedule.Id" data-caddie-id="@schedule.CaddieId" data-status="@schedule.SlotStatus">
                                <div class="caddie-schedule-card-header">
                                    <span class="caddie-schedule-card-name">@schedule.CaddieName</span>
                                    <span class="caddie-schedule-card-code @codeClass">@schedule.CaddieCode</span>
                                </div>
                                <div class="caddie-schedule-card-info">
                                    <i class="fa fa-clock" style="font-size:11px;"></i>
                                    <span>@schedule.StartTime.ToString(@"hh\:mm") - @schedule.EndTime.ToString(@"hh\:mm")</span>
                                </div>
                                <div class="caddie-schedule-card-info">
                                    <span>Ca: @schedule.ShiftCodeText</span>
                                </div>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-center text-muted py-5">Không có lịch trong ngày này</div>
                    }
                </div>
            </div>
        </div>
    }
    else if (Model.CurrentView == "month")
    {
        <!-- Month View: simplified grid showing count per day -->
        var monthStart = new DateTime(Model.CurrentWeekStart.Year, Model.CurrentWeekStart.Month, 1);
        var daysInMonth = DateTime.DaysInMonth(monthStart.Year, monthStart.Month);
        <div class="caddie-calendar">
            <div class="caddie-calendar-header">
                <div class="caddie-calendar-header-cell">T2</div>
                <div class="caddie-calendar-header-cell">T3</div>
                <div class="caddie-calendar-header-cell">T4</div>
                <div class="caddie-calendar-header-cell">T5</div>
                <div class="caddie-calendar-header-cell">T6</div>
                <div class="caddie-calendar-header-cell weekend">T7</div>
                <div class="caddie-calendar-header-cell weekend">CN</div>
            </div>
            <div class="caddie-calendar-body" style="grid-template-columns:repeat(7,1fr);">
                @{
                    // Padding for start of month
                    var firstDayOfWeek = ((int)monthStart.DayOfWeek + 6) % 7; // Mon=0
                    for (int p = 0; p < firstDayOfWeek; p++)
                    {
                        <div class="caddie-calendar-day" style="min-height:80px;opacity:0.3;"></div>
                    }
                    for (int d = 1; d <= daysInMonth; d++)
                    {
                        var thisDay = new DateTime(monthStart.Year, monthStart.Month, d);
                        var isToday2 = thisDay.Date == today;
                        var dayScheds = Model.Schedules.Where(s => s.WorkDate.Date == thisDay.Date).ToList();
                        var availCount = dayScheds.Count(s => s.SlotStatus == 1);
                        var bookedCount = dayScheds.Count(s => s.SlotStatus == 2);
                        var offCount = dayScheds.Count(s => s.SlotStatus == 3);
                        <div class="caddie-calendar-day @(isToday2 ? "today" : "")" style="min-height:80px;padding:8px;cursor:pointer;" onclick="window.location.href='/AppCaddieSchedules?weekStart=@thisDay.ToString("yyyy-MM-dd")&view=day'">
                            <div style="font-weight:@(isToday2 ? "800" : "600");font-size:13px;margin-bottom:4px;">@d</div>
                            @if (dayScheds.Any())
                            {
                                @if (availCount > 0) { <div style="font-size:10px;color:#166534;">●@availCount trống</div> }
                                @if (bookedCount > 0) { <div style="font-size:10px;color:#1e40af;">●@bookedCount phục vụ</div> }
                                @if (offCount > 0) { <div style="font-size:10px;color:#991b1b;">●@offCount nghỉ</div> }
                            }
                        </div>
                    }
                }
            </div>
        </div>
    }
    else
    {
        <!-- Week View (default) -->
        <div class="caddie-calendar">
            <div class="caddie-calendar-header">
                @foreach (var day in weekDays)
                {
                    var isToday3 = day.Date == today;
                    var isWeekend = day.DayOfWeek == DayOfWeek.Saturday || day.DayOfWeek == DayOfWeek.Sunday;
                    var cellClass = isToday3 ? "today" : (isWeekend ? "weekend" : "");
                    var dayName2 = day.DayOfWeek switch
                    {
                        DayOfWeek.Monday => "Thứ 2",
                        DayOfWeek.Tuesday => "Thứ 3",
                        DayOfWeek.Wednesday => "Thứ 4",
                        DayOfWeek.Thursday => "Thứ 5",
                        DayOfWeek.Friday => "Thứ 6",
                        DayOfWeek.Saturday => "Thứ 7",
                        DayOfWeek.Sunday => "Chủ Nhật",
                        _ => ""
                    };
                    <div class="caddie-calendar-header-cell @cellClass">
                        <div class="day-name">@dayName2</div>
                        <div class="day-num">@day.Day</div>
                    </div>
                }
            </div>
            <div class="caddie-calendar-body">
                @foreach (var day in weekDays)
                {
                    var isToday4 = day.Date == today;
                    var isWeekend2 = day.DayOfWeek == DayOfWeek.Saturday || day.DayOfWeek == DayOfWeek.Sunday;
                    var dayClass = isToday4 ? "today" : (isWeekend2 ? "weekend" : "");
                    var daySchedules2 = Model.Schedules.Where(s => s.WorkDate.Date == day.Date).ToList();

                    <div class="caddie-calendar-day @dayClass">
                        @if (daySchedules2.Any())
                        {
                            @foreach (var schedule in daySchedules2)
                            {
                                var cardClass = schedule.SlotStatus switch { 2 => "booked", 3 => "off", _ => "" };
                                var codeClass = schedule.SlotStatus switch { 2 => "booked", 3 => "off", _ => "available" };
                                <div class="caddie-schedule-card @cardClass" data-id="@schedule.Id" data-caddie-id="@schedule.CaddieId" data-status="@schedule.SlotStatus">
                                    <div class="caddie-schedule-card-header">
                                        <span class="caddie-schedule-card-name">@schedule.CaddieName</span>
                                        <span class="caddie-schedule-card-code @codeClass">@schedule.CaddieCode</span>
                                    </div>
                                    @if (schedule.SlotStatus == 3)
                                    {
                                        <div class="caddie-schedule-card-info">
                                            <span>@(schedule.Note ?? "Nghỉ")</span>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="caddie-schedule-card-info">
                                            <i class="fa fa-clock" style="font-size:11px;"></i>
                                            <span>@schedule.StartTime.ToString(@"hh\:mm") - @schedule.EndTime.ToString(@"hh\:mm")</span>
                                        </div>
                                        <div class="caddie-schedule-card-info">
                                            <span>Ca: @schedule.ShiftCodeText</span>
                                        </div>
                                    }
                                </div>
                            }
                        }
                    </div>
                }
            </div>
        </div>
    }

    <!-- FAB: Add Schedule -->
    @if (canCreate)
    {
        <button class="caddie-fab" id="NewScheduleButton" style="width:auto;border-radius:28px;padding:0 24px;gap:8px;">
            <i class="fa fa-plus"></i>
            <span style="font-weight:700;font-size:0.875rem;">Xếp lịch mới</span>
        </button>
    }
</div>

<!-- Schedule Detail Modal -->
<div class="modal fade" id="scheduleDetailModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius:12px;border:none;">
            <div class="modal-header" style="border-bottom:1px solid rgba(192,199,212,0.1);padding:20px 24px;">
                <div>
                    <h5 class="modal-title" style="font-weight:800;">Chi tiết ca làm việc</h5>
                    <p style="font-size:12px;color:var(--caddie-on-surface-variant);margin:2px 0 0;">Thông tin điều phối Caddy trong ngày</p>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" style="padding:24px;">
                <div class="d-flex align-items-center gap-3 p-3 mb-4" style="background:rgba(0,94,164,0.03);border-radius:12px;border:1px solid rgba(0,94,164,0.1);">
                    <img id="modalCaddieAvatar" src="/images/default-avatar.png" class="rounded" style="width:64px;height:64px;object-fit:cover;" />
                    <div>
                        <h4 id="modalCaddieName" style="font-weight:700;font-size:1.1rem;margin:0;">—</h4>
                        <div class="d-flex align-items-center gap-2 mt-1">
                            <span id="modalCaddieCode" style="font-size:12px;font-weight:700;padding:2px 8px;background:var(--caddie-primary);color:#fff;border-radius:4px;">—</span>
                        </div>
                    </div>
                </div>
                <div class="row g-3">
                    <div class="col-6">
                        <div style="padding:16px;background:var(--caddie-surface-container-low);border-radius:12px;">
                            <div style="font-size:10px;font-weight:700;text-transform:uppercase;color:var(--caddie-on-surface-variant);margin-bottom:4px;">Thời gian</div>
                            <div id="modalTime" style="font-size:0.875rem;font-weight:600;">—</div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div style="padding:16px;background:var(--caddie-surface-container-low);border-radius:12px;">
                            <div style="font-size:10px;font-weight:700;text-transform:uppercase;color:var(--caddie-on-surface-variant);margin-bottom:4px;">Trạng thái</div>
                            <div id="modalStatus" style="font-size:0.875rem;font-weight:600;">—</div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div style="padding:16px;background:var(--caddie-surface-container-low);border-radius:12px;">
                            <div style="font-size:10px;font-weight:700;text-transform:uppercase;color:var(--caddie-on-surface-variant);margin-bottom:4px;">Ca làm việc</div>
                            <div id="modalShift" style="font-size:0.875rem;font-weight:600;">—</div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div style="padding:16px;background:var(--caddie-surface-container-low);border-radius:12px;">
                            <div style="font-size:10px;font-weight:700;text-transform:uppercase;color:var(--caddie-on-surface-variant);margin-bottom:4px;">Ghi chú</div>
                            <div id="modalNote" style="font-size:0.875rem;font-weight:600;">—</div>
                        </div>
                    </div>
                </div>
            </div>
            @if (canEdit)
            {
                <div class="modal-footer" style="border-top:1px solid rgba(192,199,212,0.1);padding:16px 24px;">
                    <button type="button" class="btn btn-outline-danger" id="btnDeleteSchedule" style="font-weight:700;"><i class="fa fa-trash me-1"></i> Xóa ca</button>
                    <button type="button" class="btn-caddie-primary" id="btnEditSchedule"><i class="fa fa-pencil"></i> Chỉnh sửa</button>
                    <button type="button" class="btn btn-light" style="font-weight:700;" data-bs-dismiss="modal">Đóng</button>
                </div>
            }
        </div>
    </div>
</div>

<!-- Delete Range Modal -->
<div class="modal fade" id="deleteRangeModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius:12px;border:none;">
            <div class="modal-header" style="padding:20px 24px;border-bottom:1px solid rgba(192,199,212,0.1);">
                <div>
                    <h5 class="modal-title" style="font-weight:800;">Xóa lịch làm việc</h5>
                    <p style="font-size:12px;color:var(--caddie-on-surface-variant);margin:2px 0 0;">Xóa lịch theo khoảng ngày/giờ. Ca đã có booking sẽ được bỏ qua.</p>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" style="padding:24px;">
                <div class="row g-3">
                    <div class="col-6">
                        <label class="caddie-form-label">Từ ngày <span class="text-danger">*</span></label>
                        <input type="text" id="deleteFromDate" class="form-control caddie-form-control" placeholder="dd/mm/yyyy" />
                    </div>
                    <div class="col-6">
                        <label class="caddie-form-label">Đến ngày <span class="text-danger">*</span></label>
                        <input type="text" id="deleteToDate" class="form-control caddie-form-control" placeholder="dd/mm/yyyy" />
                    </div>
                    <div class="col-6">
                        <label class="caddie-form-label">Từ giờ (tùy chọn)</label>
                        <input type="time" id="deleteFromTime" class="form-control caddie-form-control" />
                    </div>
                    <div class="col-6">
                        <label class="caddie-form-label">Đến giờ (tùy chọn)</label>
                        <input type="time" id="deleteToTime" class="form-control caddie-form-control" />
                    </div>
                </div>
            </div>
            <div class="modal-footer" style="padding:16px 24px;border-top:1px solid rgba(192,199,212,0.1);">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal" style="font-weight:700;">Hủy</button>
                <button type="button" class="btn btn-danger" id="btnConfirmDeleteRange" style="font-weight:700;border-radius:8px;"><i class="fa fa-trash me-1"></i> Xóa lịch</button>
            </div>
        </div>
    </div>
</div>

<!-- Import Preview Modal -->
<div class="modal fade" id="importPreviewModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content" style="border-radius:12px;border:none;">
            <div class="modal-header" style="padding:20px 24px;border-bottom:1px solid rgba(192,199,212,0.1);">
                <div>
                    <h5 class="modal-title" style="font-weight:800;">Xem trước dữ liệu Import</h5>
                    <p style="font-size:12px;color:var(--caddie-on-surface-variant);margin:2px 0 0;">Kiểm tra dữ liệu trước khi lưu vào hệ thống. Tổng: <strong id="importPreviewCount">0</strong></p>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" style="padding:24px;max-height:400px;overflow-y:auto;">
                <div id="importPreviewContent">
                    <p class="text-muted">Đang tải...</p>
                </div>
            </div>
            <div class="modal-footer" style="padding:16px 24px;border-top:1px solid rgba(192,199,212,0.1);">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal" style="font-weight:700;">Hủy</button>
                <button type="button" class="btn-caddie-primary" id="btnConfirmImport"><i class="fa fa-check me-1"></i> Xác nhận Import</button>
            </div>
        </div>
    </div>
</div>

<!-- Save Template Modal -->
<div class="modal fade" id="saveTemplateModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius:12px;border:none;">
            <div class="modal-header" style="padding:20px 24px;border-bottom:1px solid rgba(192,199,212,0.1);">
                <div>
                    <h5 class="modal-title" style="font-weight:800;">Lưu Template lịch tuần</h5>
                    <p style="font-size:12px;color:var(--caddie-on-surface-variant);margin:2px 0 0;">Lưu lịch tuần hiện tại thành mẫu để áp dụng cho các tuần tiếp theo.</p>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" style="padding:24px;">
                <div class="mb-3">
                    <label class="caddie-form-label">Chọn Caddie <span class="text-danger">*</span></label>
                    <select id="templateCaddieId" class="form-select caddie-form-control">
                        <option value="">-- Chọn Caddie --</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="caddie-form-label">Tên template (tùy chọn)</label>
                    <input type="text" id="templateName" class="form-control caddie-form-control" placeholder="VD: Ca chuẩn tuần" />
                </div>
                <p style="font-size:12px;color:var(--caddie-on-surface-variant);"><i class="fa fa-info-circle me-1"></i> Hệ thống sẽ lưu tất cả lịch trong tuần hiện tại (<strong id="saveTemplateWeekLabel"></strong>) của Caddie được chọn làm mẫu.</p>
            </div>
            <div class="modal-footer" style="padding:16px 24px;border-top:1px solid rgba(192,199,212,0.1);">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal" style="font-weight:700;">Hủy</button>
                <button type="button" class="btn btn-warning" id="btnConfirmSaveTemplate" style="font-weight:700;border-radius:8px;"><i class="fa fa-save me-1"></i> Lưu Template</button>
            </div>
        </div>
    </div>
</div>

<!-- Apply Template Modal -->
<div class="modal fade" id="applyTemplateModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius:12px;border:none;">
            <div class="modal-header" style="padding:20px 24px;border-bottom:1px solid rgba(192,199,212,0.1);">
                <div>
                    <h5 class="modal-title" style="font-weight:800;">Áp dụng Template lịch</h5>
                    <p style="font-size:12px;color:var(--caddie-on-surface-variant);margin:2px 0 0;">Tự động tạo lịch cho tuần mới từ template đã lưu.</p>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" style="padding:24px;">
                <div class="mb-3">
                    <label class="caddie-form-label">Chọn Caddie <span class="text-danger">*</span></label>
                    <select id="applyCaddieId" class="form-select caddie-form-control">
                        <option value="">-- Chọn Caddie --</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="caddie-form-label">Tuần bắt đầu từ ngày <span class="text-danger">*</span></label>
                    <input type="text" id="applyTargetWeek" class="form-control caddie-form-control" placeholder="dd/mm/yyyy" />
                </div>
                <p style="font-size:12px;color:var(--caddie-on-surface-variant);"><i class="fa fa-info-circle me-1"></i> Lịch sẽ được generate từ template đã lưu. Nếu trùng khung giờ đã có booking sẽ bị bỏ qua.</p>
            </div>
            <div class="modal-footer" style="padding:16px 24px;border-top:1px solid rgba(192,199,212,0.1);">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal" style="font-weight:700;">Hủy</button>
                <button type="button" class="btn btn-info text-white" id="btnConfirmApplyTemplate" style="font-weight:700;border-radius:8px;"><i class="fa fa-magic me-1"></i> Áp dụng</button>
            </div>
        </div>
    </div>
</div>

<input type="hidden" id="CanEdit" value="@canEdit.ToString().ToLower()" />
<input type="hidden" id="WeekStart" value="@Model.CurrentWeekStart.ToString("yyyy-MM-dd")" />
<input type="hidden" id="CurrentView" value="@Model.CurrentView" />

<!-- Caddie Items for Create Modal -->
<script>
    window.__caddieItems = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CaddieItems.Select(x => new { value = x.Value, text = x.Text })));
</script>
