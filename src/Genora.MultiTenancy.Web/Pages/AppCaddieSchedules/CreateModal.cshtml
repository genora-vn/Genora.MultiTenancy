@page
@using Genora.MultiTenancy.Web.Pages.AppCaddieSchedules
@model CreateModalModel
@{ Layout = null; }

<form method="post" asp-page="/AppCaddieSchedules/CreateModal" id="scheduleForm">
    @if (Model.Id.HasValue)
    {
        <input type="hidden" asp-for="Id" />
    }
    <abp-modal size="Large">
        <abp-modal-header>
            <div class="caddie-modal-header">
                <h5 class="modal-title">@(Model.IsEdit ? "Chỉnh sửa lịch làm việc" : "Xếp lịch mới")</h5>
                <p class="caddie-modal-subtitle">@(Model.IsEdit ? "Cập nhật thông tin ca làm việc" : "Tạo ca làm việc cho Caddy (có thể tạo hàng loạt)")</p>
            </div>
        </abp-modal-header>
        <abp-modal-body>
            <div class="row g-4">
                <!-- Caddie -->
                <div class="col-md-12">
                    <label class="caddie-form-label">Caddy <span class="text-danger">*</span></label>
                    <select asp-for="Schedule.CaddieId" asp-items="Model.CaddieItems" class="form-select caddie-form-control">
                        <option value="">-- Chọn Caddy --</option>
                    </select>
                </div>

                @if (!Model.IsEdit)
                {
                    <!-- Auto-generate: From/To date range -->
                    <div class="col-md-6">
                        <label class="caddie-form-label">Từ ngày <span class="text-danger">*</span></label>
                        <input type="text" id="WorkDateFromPicker" class="form-control caddie-form-control" placeholder="dd/mm/yyyy" autocomplete="off" />
                        <input type="hidden" asp-for="Schedule.WorkDate" id="WorkDateFromHidden" />
                    </div>
                    <div class="col-md-6">
                        <label class="caddie-form-label">Đến ngày <small class="text-muted">(bỏ trống = chỉ 1 ngày)</small></label>
                        <input type="text" id="WorkDateToPicker" class="form-control caddie-form-control" placeholder="dd/mm/yyyy" autocomplete="off" />
                        <input type="hidden" id="WorkDateToHidden" name="WorkDateTo" />
                    </div>
                }
                else
                {
                    <!-- Edit: single date -->
                    <div class="col-md-6">
                        <label class="caddie-form-label">Ngày làm việc <span class="text-danger">*</span></label>
                        <input type="text" id="WorkDateFromPicker" class="form-control caddie-form-control" placeholder="dd/mm/yyyy" autocomplete="off" />
                        <input type="hidden" asp-for="Schedule.WorkDate" id="WorkDateFromHidden" />
                    </div>
                }

                <!-- Ca làm việc (Select2 multiple khi Create, single khi Edit) -->
                @if (!Model.IsEdit)
                {
                    <div class="col-md-6">
                        <label class="caddie-form-label">Ca làm việc <span class="text-danger">*</span></label>
                        <select id="shiftMultiSelect" class="form-select caddie-form-control" multiple>
                            @foreach (var item in Model.ShiftItems)
                            {
                                <option value="@item.Value">@item.Text</option>
                            }
                        </select>
                        <div id="shiftHiddens"></div>
                        <input type="hidden" asp-for="Schedule.ShiftCode" id="ShiftCodeHidden" />
                    </div>
                }
                else
                {
                    <div class="col-md-6">
                        <label class="caddie-form-label">Ca làm việc <span class="text-danger">*</span></label>
                        <select asp-for="Schedule.ShiftCode" asp-items="Model.ShiftItems" class="form-select caddie-form-control"></select>
                    </div>
                }

                <!-- Giờ bắt đầu -->
                <div class="col-md-6">
                    <label class="caddie-form-label">Giờ bắt đầu <span class="text-danger">*</span></label>
                    <input type="time" asp-for="Schedule.StartTime" class="form-control caddie-form-control" />
                </div>
                <!-- Giờ kết thúc -->
                <div class="col-md-6">
                    <label class="caddie-form-label">Giờ kết thúc <span class="text-danger">*</span></label>
                    <input type="time" asp-for="Schedule.EndTime" class="form-control caddie-form-control" />
                </div>
                <!-- Trạng thái -->
                <div class="col-md-6">
                    <label class="caddie-form-label">Trạng thái</label>
                    <select asp-for="Schedule.SlotStatus" asp-items="Model.StatusItems" class="form-select caddie-form-control"></select>
                </div>
                <!-- Ca tối -->
                <div class="col-md-6">
                    <label class="caddie-form-label">Ca tối (Night Shift)</label>
                    <select asp-for="Schedule.IsNightShift" class="form-select caddie-form-control">
                        <option value="false">Không</option>
                        <option value="true">Có</option>
                    </select>
                </div>
                <!-- Ghi chú -->
                <div class="col-12">
                    <label class="caddie-form-label">Ghi chú</label>
                    <textarea asp-for="Schedule.Note" class="form-control caddie-form-control" rows="2" style="resize:none;" placeholder="VD: Nghỉ phép năm, Vòng đặc biệt, Tăng ca..."></textarea>
                </div>

                @if (!Model.IsEdit)
                {
                    <div class="col-12">
                        <div class="alert alert-info" style="font-size:12px;border-radius:8px;margin:0;">
                            <i class="fa fa-info-circle me-1"></i>
                            <strong>Tự động xếp lịch:</strong> Chọn khoảng ngày + ca → hệ thống tạo lịch cho tất cả ngày trong khoảng.
                            Nếu chọn nhiều ca, mỗi ngày sẽ tạo nhiều record tương ứng.
                        </div>
                    </div>
                }
            </div>
        </abp-modal-body>
        <abp-modal-footer>
            <button type="button" class="btn btn-light px-4" data-bs-dismiss="modal" style="font-weight:700;">Hủy</button>
            <button type="submit" class="btn-caddie-primary" id="btnSubmitSchedule"><i class="fa fa-save"></i> @(Model.IsEdit ? "Cập nhật" : "Xếp lịch")</button>
        </abp-modal-footer>
    </abp-modal>
</form>

<script>
(function () {
    var isEdit = @(Model.IsEdit ? "true" : "false");

    // ── Flatpickr for dates ──────────────────────────────────────────
    var fpFrom = flatpickr('#WorkDateFromPicker', {
        dateFormat: 'd/m/Y',
        defaultDate: isEdit ? '@(Model.Schedule.WorkDate.ToString("dd/MM/yyyy"))' : null,
        onChange: function (selectedDates) {
            if (selectedDates.length) {
                var d = selectedDates[0];
                var iso = d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');
                $('#WorkDateFromHidden').val(iso);
            } else {
                $('#WorkDateFromHidden').val('');
            }
        }
    });

    @if (Model.IsEdit)
    {
        <text>
        // Set initial date for edit mode
        var initFromDate = '@Model.Schedule.WorkDate.ToString("yyyy-MM-dd")';
        if (initFromDate) {
            fpFrom.setDate(new Date(initFromDate), false);
            $('#WorkDateFromHidden').val(initFromDate);
        }
        </text>
    }

    @if (!Model.IsEdit)
    {
        <text>
        flatpickr('#WorkDateToPicker', {
            dateFormat: 'd/m/Y',
            onChange: function (selectedDates) {
                if (selectedDates.length) {
                    var d = selectedDates[0];
                    var iso = d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0');
                    $('#WorkDateToHidden').val(iso);
                } else {
                    $('#WorkDateToHidden').val('');
                }
            }
        });

        // ── Select2 for shifts (multiple) ─────────────────────────────
        var $shiftSel = $('#shiftMultiSelect');
        $shiftSel.select2({
            placeholder: '-- Chọn ca làm việc --',
            allowClear: true,
            width: '100%',
            tags: false,
            dropdownParent: $shiftSel.closest('.modal-content').length ? $shiftSel.closest('.modal-content') : $(document.body)
        });

        $shiftSel.next('.select2-container').find('.select2-selection--multiple').css({
            'min-height': '38px',
            'padding': '4px 8px'
        });

        $shiftSel.on('change', function () {
            var vals = $(this).val() || [];
            // Set first value as main ShiftCode for single-record fallback
            $('#ShiftCodeHidden').val(vals.length > 0 ? vals[0] : '');
            // Populate hidden inputs for multi-shift
            var container = document.getElementById('shiftHiddens');
            container.innerHTML = '';
            vals.forEach(function (v, i) {
                var inp = document.createElement('input');
                inp.type = 'hidden';
                inp.name = 'SelectedShiftCodes[' + i + ']';
                inp.value = v;
                container.appendChild(inp);
            });
        });
        </text>
    }
})();
</script>
