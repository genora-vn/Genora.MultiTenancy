@page
@using Genora.MultiTenancy.Web.Pages.AppCaddieSchedules
@model CreateModalModel
@{ Layout = null; }

<form method="post" asp-page="/AppCaddieSchedules/CreateModal">
    @if (Model.Id.HasValue)
    {
        <input type="hidden" asp-for="Id" />
    }
    <abp-modal>
        <abp-modal-header>
            <div class="caddie-modal-header">
                <h5 class="modal-title">@(Model.IsEdit ? "Chỉnh sửa lịch làm việc" : "Xếp lịch mới")</h5>
                <p class="caddie-modal-subtitle">@(Model.IsEdit ? "Cập nhật thông tin ca làm việc" : "Tạo ca làm việc mới cho Caddy")</p>
            </div>
        </abp-modal-header>
        <abp-modal-body>
            <div class="row g-4">
                <!-- Caddie -->
                <div class="col-md-12">
                    <label class="caddie-form-label">Caddy <span class="text-danger">*</span></label>
                    <select asp-for="Schedule.CaddieId" asp-items="Model.CaddieItems" class="form-select caddie-form-control">
                        <option value="">-- Chọn Caddy --</option>
                    </select>
                </div>
                <!-- Ngày làm việc -->
                <div class="col-md-6">
                    <label class="caddie-form-label">Ngày làm việc <span class="text-danger">*</span></label>
                    <input type="date" asp-for="Schedule.WorkDate" class="form-control caddie-form-control" />
                </div>
                <!-- Ca làm việc -->
                <div class="col-md-6">
                    <label class="caddie-form-label">Ca làm việc <span class="text-danger">*</span></label>
                    <select asp-for="Schedule.ShiftCode" asp-items="Model.ShiftItems" class="form-select caddie-form-control">
                    </select>
                </div>
                <!-- Giờ bắt đầu -->
                <div class="col-md-6">
                    <label class="caddie-form-label">Giờ bắt đầu <span class="text-danger">*</span></label>
                    <input type="time" asp-for="Schedule.StartTime" class="form-control caddie-form-control" />
                </div>
                <!-- Giờ kết thúc -->
                <div class="col-md-6">
                    <label class="caddie-form-label">Giờ kết thúc <span class="text-danger">*</span></label>
                    <input type="time" asp-for="Schedule.EndTime" class="form-control caddie-form-control" />
                </div>
                <!-- Trạng thái -->
                <div class="col-md-6">
                    <label class="caddie-form-label">Trạng thái</label>
                    <select asp-for="Schedule.SlotStatus" asp-items="Model.StatusItems" class="form-select caddie-form-control">
                    </select>
                </div>
                <!-- Ca tối -->
                <div class="col-md-6">
                    <label class="caddie-form-label">Ca tối (Night Shift)</label>
                    <select asp-for="Schedule.IsNightShift" class="form-select caddie-form-control">
                        <option value="false">Không</option>
                        <option value="true">Có</option>
                    </select>
                </div>
                <!-- Ghi chú -->
                <div class="col-12">
                    <label class="caddie-form-label">Ghi chú</label>
                    <textarea asp-for="Schedule.Note" class="form-control caddie-form-control" rows="2" style="resize:none;" placeholder="VD: Nghỉ phép năm, Vòng đặc biệt, Tăng ca..."></textarea>
                </div>
            </div>
        </abp-modal-body>
        <abp-modal-footer>
            <button type="button" class="btn btn-light px-4" data-bs-dismiss="modal" style="font-weight:700;">Hủy</button>
            <button type="submit" class="btn-caddie-primary"><i class="fa fa-save"></i> @(Model.IsEdit ? "Cập nhật" : "Xếp lịch")</button>
        </abp-modal-footer>
    </abp-modal>
</form>
