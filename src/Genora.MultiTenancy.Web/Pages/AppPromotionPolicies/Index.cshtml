@page
@using Genora.MultiTenancy.Localization
@using Genora.MultiTenancy.Permissions
@using Genora.MultiTenancy.Web.Pages.AppPromotionPolicies
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<MultiTenancyResource> L
@inject IAuthorizationService AuthorizationService
@inject Volo.Abp.MultiTenancy.ICurrentTenant CurrentTenant

@section styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/summernote@0.8.18/dist/summernote-lite.min.css" />
}

@section scripts {
    <script src="https://cdn.jsdelivr.net/npm/summernote@0.8.18/dist/summernote-lite.min.js"></script>
    <abp-script src="/Pages/AppPromotionPolicies/Index.js" />
    <abp-style src="/Pages/Index.css" />
}

@{
    var canCreate = CurrentTenant.IsAvailable
        ? await AuthorizationService.IsGrantedAsync(MultiTenancyPermissions.AppPromotionPolicies.Create)
        : await AuthorizationService.IsGrantedAsync(MultiTenancyPermissions.HostAppPromotionPolicies.Create);
}

<abp-card>
    <abp-card-header>
        <abp-row>
            <abp-column size-md="_6">
                <abp-card-title>@L["AppPromotionPolicies"]</abp-card-title>
            </abp-column>
            <abp-column size-md="_6" class="text-end">
                @if (canCreate)
                {
                    <abp-button id="NewPromotionPolicy"
                                text="@L["NewPromotionPolicy"].Value"
                                icon="plus"
                                button-type="Outline_Primary" />
                }
            </abp-column>
        </abp-row>
    </abp-card-header>
    <abp-card-body>
        <abp-table striped-rows="true" id="PromotionPolicyTable"></abp-table>
    </abp-card-body>
</abp-card>

<style type="text/css">
    #PromotionPolicyTable_wrapper .dt-scroll-body {
        max-height: 65vh !important;
        min-height: 60vh !important;
    }

    .promotion-policy-color-dot {
        display: inline-block;
        width: 10px;
        height: 10px;
        border-radius: 999px;
        margin-right: 6px;
        vertical-align: middle;
    }

    .promotion-policy-content-cell {
        max-width: 360px;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
</style>
