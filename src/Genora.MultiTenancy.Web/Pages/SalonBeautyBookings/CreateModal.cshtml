@page
@using Genora.MultiTenancy.Localization
@using Microsoft.Extensions.Localization
@using Volo.Abp.AspNetCore.Mvc.UI.Bootstrap.TagHelpers.Modal
@using Genora.MultiTenancy.Web.Pages.SalonBeautyBookings
@model CreateModalModel
@inject IStringLocalizer<MultiTenancyResource> L
@{
    Layout = null;
}

<form asp-page="/SalonBeautyBookings/CreateModal" id="CreateBookingForm" method="post" autocomplete="off" novalidate>
    <abp-modal size="Large">
        <abp-modal-body class="p-0">
            <div class="booking-modal">
                <div class="booking-modal-header">
                    <div>
                        <h3 class="booking-modal-title">Thêm mới đặt lịch</h3>
                        <p class="booking-modal-subtitle">Tạo lịch hẹn mới cho khách hàng</p>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="booking-modal-body">
                    <!-- Customer Search -->
                    <div class="mb-3">
                        <label class="booking-form-label">Chọn khách hàng <span class="text-danger">*</span></label>
                        <div class="position-relative">
                            <input type="text" id="CustomerSearchInput" class="form-control" placeholder="Tìm kiếm tên hoặc số điện thoại..." autocomplete="off" />
                            <div id="CustomerSearchDropdown" class="customer-search-dropdown" style="display:none;"></div>
                        </div>
                        <input type="hidden" asp-for="Booking.CustomerId" id="SelectedCustomerId" />
                        <div id="SelectedCustomerInfo" class="selected-customer-info" style="display:none;"></div>
                        <span asp-validation-for="Booking.CustomerId" class="text-danger"></span>
                    </div>

                    <!-- Booking Info Row -->
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="booking-form-label">@L["SalonBeautyLocation:PageTitle"] <span class="text-danger">*</span></label>
                            <select asp-for="Booking.LocationId" asp-items="Model.LocationItems" id="BookingLocationSelect" class="form-select">
                                <option value="">-- Chọn cơ sở --</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="booking-form-label">Stylist chính <span class="text-danger">*</span></label>
                            <select asp-for="Booking.StylistId" id="BookingStylistSelect" class="form-select">
                                <option value="">-- Chọn Stylist --</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="booking-form-label">Ngày hẹn <span class="text-danger">*</span></label>
                            <input type="text" id="BookingDatePicker" class="form-control" placeholder="dd/mm/yyyy" autocomplete="off" />
                            <input type="hidden" asp-for="Booking.BookingDate" id="BookingDateHidden" />
                            <small class="text-muted d-block mt-1" id="BookingDateHint">Chọn cơ sở và stylist để xem ngày khả dụng.</small>
                        </div>
                        <div class="col-md-6">
                            <label class="booking-form-label">@L["SalonBeautyBookings:TimeSlot"] <span class="text-danger">*</span></label>
                            <select id="BookingTimeSlotSelect" class="form-select" disabled>
                                <option value="">@L["SalonBeautyBookings:TimeSlotPlaceholder"]</option>
                            </select>
                            <input type="hidden" asp-for="Booking.TimeSlotId" id="BookingTimeSlotIdHidden" />
                            <input type="hidden" asp-for="Booking.StartTime" id="BookingStartTimeHidden" />
                            <input type="hidden" name="Booking.EndTime" id="BookingEndTimeHidden" />
                        </div>
                    </div>

                    <!-- Services List -->
                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <label class="booking-form-label mb-0">Danh sách dịch vụ <span class="text-danger">*</span></label>
                            <button type="button" id="AddServiceBtn" class="btn btn-link btn-sm p-0">
                                <i class="fa fa-plus-circle"></i> Thêm dịch vụ
                            </button>
                        </div>
                        <div class="booking-services-table">
                            <div class="booking-services-header row g-0">
                                <div class="col-5">Dịch vụ</div>
                                <div class="col-4">Thực hiện bởi</div>
                                <div class="col-2 text-end">Giá</div>
                                <div class="col-1"></div>
                            </div>
                            <div id="ServiceItemsContainer"></div>
                        </div>
                        <span id="ServiceItemsError" class="text-danger" style="display:none;">Vui lòng chọn ít nhất một dịch vụ.</span>
                    </div>

                    <!-- Notes -->
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="booking-form-label">Ghi chú của khách hàng</label>
                            <textarea asp-for="Booking.CustomerNote" class="form-control" rows="3" placeholder="VD: Khách thích nước lạnh, hay đi muộn 5p..."></textarea>
                        </div>
                        <div class="col-md-6">
                            <label class="booking-form-label">Ghi chú nội bộ</label>
                            <textarea asp-for="Booking.InternalNote" class="form-control" rows="3" placeholder="VD: Sắp xếp bàn số 4, ưu tiên gói trước..."></textarea>
                        </div>
                    </div>

                    <!-- Total -->
                    <div class="booking-total-row">
                        <span class="booking-total-label">Tạm tính (<span id="ServiceCountText">0</span> dịch vụ)</span>
                        <span class="booking-total-value" id="BookingSubTotal">0đ</span>
                    </div>
                </div>

                <div class="booking-modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Hủy</button>
                    <button type="button" id="ConfirmBookingBtn" class="btn btn-primary">
                        <i class="fa fa-check"></i> Xác nhận đặt lịch
                    </button>
                </div>
            </div>
        </abp-modal-body>
    </abp-modal>
</form>


<script>
    (function () {
        var services = [];
        var stylists = [];
        var serviceItems = [];
        var bookingService = genora.multiTenancy.appServices.salonBeauties.salonBeautyBooking;
        var slotService = genora.multiTenancy.appServices.salonBeauties.salonBeautyTimeSlot;
        var availableDateSet = {};            // 'YYYY-MM-DD' -> true
        var datePickerInstance = null;
        var loadDatesPromise = null;

        function formatCurrency(val) {
            return Number(val || 0).toLocaleString('vi-VN') + 'đ';
        }

        function loadLookups() {
            bookingService.getServiceLookup().then(function (data) {
                services = data || [];
                renderServiceItems();
            });
            loadStylistsByLocation($('#BookingLocationSelect').val());
        }

        function loadStylistsByLocation(locationId) {
            bookingService.getStylistLookup(locationId || null).then(function (data) {
                stylists = data || [];
                var $sel = $('#BookingStylistSelect');
                var prevVal = $sel.val();
                $sel.find('option:not(:first)').remove();
                $.each(stylists, function (i, s) {
                    $sel.append('<option value="' + s.id + '">' + s.displayName + (s.roleText ? ' (' + s.roleText + ')' : '') + '</option>');
                });
                if (prevVal && $sel.find('option[value="' + prevVal + '"]').length) {
                    $sel.val(prevVal);
                } else {
                    $sel.val('');
                }
                renderServiceItems();
                resetDateAndSlot();
            });
        }

        function pad2(n) { return String(n).padStart(2, '0'); }
        function toIsoDate(d) { return d.getFullYear() + '-' + pad2(d.getMonth() + 1) + '-' + pad2(d.getDate()); }

        function resetDateAndSlot() {
            availableDateSet = {};
            $('#BookingDatePicker').val('');
            $('#BookingDateHidden').val('');
            $('#BookingDateHint').text('Chọn cơ sở và stylist để xem ngày khả dụng.');
            resetSlot();
            if (datePickerInstance) {
                datePickerInstance.set('disable', [function () { return true; }]);
                datePickerInstance.clear();
            }
        }

        function resetSlot() {
            var $sel = $('#BookingTimeSlotSelect');
            $sel.find('option:not(:first)').remove();
            $sel.prop('disabled', true);
            $('#BookingTimeSlotIdHidden').val('');
            $('#BookingStartTimeHidden').val('');
            $('#BookingEndTimeHidden').val('');
        }

        function loadAvailableDates() {
            var locId = $('#BookingLocationSelect').val();
            var stylistId = $('#BookingStylistSelect').val();
            if (!stylistId) { resetDateAndSlot(); return; }

            var today = new Date();
            var to = new Date(); to.setDate(to.getDate() + 60);
            var fromIso = toIsoDate(today);
            var toIso = toIsoDate(to);

            $('#BookingDateHint').text('Đang tải ngày khả dụng...');
            loadDatesPromise = slotService.getAvailableDates(stylistId, fromIso, toIso, locId || null).then(function (dates) {
                availableDateSet = {};
                (dates || []).forEach(function (d) {
                    var dt = new Date(d);
                    availableDateSet[toIsoDate(dt)] = true;
                });
                if (datePickerInstance) {
                    datePickerInstance.set('disable', [function (date) {
                        return !availableDateSet[toIsoDate(date)];
                    }]);
                    datePickerInstance.clear();
                }
                $('#BookingDateHint').text(Object.keys(availableDateSet).length
                    ? 'Chỉ ngày sáng có cấu hình lịch mới chọn được.'
                    : 'Stylist chưa có lịch làm việc trong 60 ngày tới.');
            });
            return loadDatesPromise;
        }

        function loadAvailableSlots(isoDate) {
            var locId = $('#BookingLocationSelect').val();
            var stylistId = $('#BookingStylistSelect').val();
            resetSlot();
            if (!stylistId || !isoDate) return;
            slotService.getAvailableSlots(stylistId, isoDate, locId || null).then(function (slots) {
                var $sel = $('#BookingTimeSlotSelect');
                $sel.find('option:not(:first)').remove();
                if (!slots || slots.length === 0) {
                    $sel.append('<option value="" disabled>' + abp.localization.localize('SalonBeautyBookings:NoSlotForDate', 'MultiTenancy') + '</option>');
                    $sel.prop('disabled', true);
                    return;
                }
                slots.forEach(function (s) {
                    var st = (s.startTime || '00:00:00').substring(0, 5);
                    var et = (s.endTime || '00:00:00').substring(0, 5);
                    var label = st + ' - ' + et + (s.isPeakHour ? ' 🔥' : '');
                    $sel.append('<option value="' + s.id + '" data-start="' + s.startTime + '" data-end="' + s.endTime + '">' + label + '</option>');
                });
                $sel.prop('disabled', false);
            });
        }

        $('#BookingLocationSelect').on('change', function () {
            loadStylistsByLocation($(this).val());
        });

        $('#BookingStylistSelect').on('change', function () {
            loadAvailableDates();
        });

        $('#BookingTimeSlotSelect').on('change', function () {
            var $opt = $(this).find(':selected');
            $('#BookingTimeSlotIdHidden').val($(this).val() || '');
            $('#BookingStartTimeHidden').val($opt.data('start') || '');
            $('#BookingEndTimeHidden').val($opt.data('end') || '');
        });

        function renderServiceRow(idx, item) {
            var serviceOptions = services.map(function (s) {
                return '<option value="' + s.id + '" data-price="' + s.price + '" data-duration="' + s.duration + '"' +
                    (item.serviceId === s.id ? ' selected' : '') + '>' + s.name + (s.categoryName ? ' - ' + s.categoryName : '') + '</option>';
            }).join('');
            var stylistOptions = '<option value="">-- Stylist --</option>' + stylists.map(function (s) {
                return '<option value="' + s.id + '"' + (item.stylistId === s.id ? ' selected' : '') + '>' + s.displayName + '</option>';
            }).join('');

            return '<div class="booking-service-row row g-2 align-items-center" data-idx="' + idx + '">' +
                '<div class="col-5"><select class="form-select form-select-sm svc-select" data-idx="' + idx + '"><option value="">-- Chọn dịch vụ --</option>' + serviceOptions + '</select></div>' +
                '<div class="col-4"><select class="form-select form-select-sm svc-stylist" data-idx="' + idx + '">' + stylistOptions + '</select></div>' +
                '<div class="col-2 text-end"><span class="svc-price fw-bold" data-idx="' + idx + '">' + formatCurrency(item.price) + '</span></div>' +
                '<div class="col-1 text-center"><button type="button" class="btn btn-sm btn-link text-danger p-0 svc-remove" data-idx="' + idx + '"><i class="fa fa-trash"></i></button></div>' +
                '</div>';
        }

        function renderServiceItems() {
            var $c = $('#ServiceItemsContainer');
            $c.empty();
            if (serviceItems.length === 0) {
                $c.html('<div class="text-center text-muted py-3" style="font-size:13px;">Chưa có dịch vụ nào. Nhấn "+ Thêm dịch vụ" để thêm.</div>');
            } else {
                serviceItems.forEach(function (item, idx) {
                    $c.append(renderServiceRow(idx, item));
                });
            }
            updateTotal();
        }

        function updateTotal() {
            var total = serviceItems.reduce(function (s, i) { return s + (i.price || 0); }, 0);
            $('#BookingSubTotal').text(formatCurrency(total));
            $('#ServiceCountText').text(serviceItems.length);
        }

        function buildHiddenInputs() {
            $('[name^="Booking.Items"]').remove();
            serviceItems.forEach(function (item, idx) {
                $('<input>').attr({ type: 'hidden', name: 'Booking.Items[' + idx + '].ServiceId', value: item.serviceId }).appendTo('#CreateBookingForm');
                $('<input>').attr({ type: 'hidden', name: 'Booking.Items[' + idx + '].StylistId', value: item.stylistId || '' }).appendTo('#CreateBookingForm');
                $('<input>').attr({ type: 'hidden', name: 'Booking.Items[' + idx + '].Price', value: item.price || 0 }).appendTo('#CreateBookingForm');
                $('<input>').attr({ type: 'hidden', name: 'Booking.Items[' + idx + '].Duration', value: item.duration || 0 }).appendTo('#CreateBookingForm');
            });
        }

        function selectCustomer(c) {
            var initials = (c.name || 'K').charAt(0).toUpperCase();
            $('#SelectedCustomerId').val(c.id);
            $('#CustomerSearchInput').val(c.name);
            $('#CustomerSearchDropdown').hide();
            $('#SelectedCustomerInfo').html(
                '<div class="customer-search-avatar">' + initials + '</div>' +
                '<div><strong>' + c.name + '</strong> &nbsp; ' + (c.phone || '') +
                ((c.code || c.customerCode) ? ' &nbsp; <span class="booking-customer-code-badge">' + (c.code || c.customerCode) + '</span>' : '') +
                '</div>'
            ).show();
        }


        var searchTimer;
        $('#CustomerSearchInput').on('input', function () {
            clearTimeout(searchTimer);
            var q = $(this).val().trim();
            if (q.length < 2) { $('#CustomerSearchDropdown').hide(); return; }
            searchTimer = setTimeout(function () {
                bookingService.getCustomerLookup(q).then(function (data) {
                    var $dd = $('#CustomerSearchDropdown').empty().show();
                    if (!data.length) {
                        $dd.html('<div class="customer-search-item text-muted">Không tìm thấy khách hàng</div>');
                        return;
                    }
                    data.forEach(function (c) {
                        var initials = (c.name || 'K').charAt(0).toUpperCase();
                        var $item = $('<div class="customer-search-item">' +
                            '<div class="customer-search-avatar">' + initials + '</div>' +
                            '<div><div class="customer-search-name">' + c.name + '</div>' +
                            '<div class="customer-search-phone">' + (c.phone || '--') + '</div></div></div>');
                        $item.on('click', function () { selectCustomer(c); });
                        $dd.append($item);
                    });
                });
            }, 300);
        });

        $(document).on('click', function (e) {
            if (!$(e.target).closest('#CustomerSearchInput, #CustomerSearchDropdown').length) {
                $('#CustomerSearchDropdown').hide();
            }
        });

        $('#AddServiceBtn').on('click', function () {
            serviceItems.push({ serviceId: '', stylistId: '', price: 0, duration: 0 });
            renderServiceItems();
        });

        $(document).on('change', '.svc-select', function () {
            var idx = parseInt($(this).data('idx'));
            var $opt = $(this).find(':selected');
            serviceItems[idx].serviceId = $(this).val();
            serviceItems[idx].price = parseFloat($opt.data('price')) || 0;
            serviceItems[idx].duration = parseInt($opt.data('duration')) || 0;
            $(this).closest('.booking-service-row').find('.svc-price').text(formatCurrency(serviceItems[idx].price));
            updateTotal();
        });

        $(document).on('change', '.svc-stylist', function () {
            var idx = parseInt($(this).data('idx'));
            serviceItems[idx].stylistId = $(this).val();
        });

        $(document).on('click', '.svc-remove', function () {
            var idx = parseInt($(this).data('idx'));
            serviceItems.splice(idx, 1);
            renderServiceItems();
        });

        datePickerInstance = flatpickr('#BookingDatePicker', {
            dateFormat: 'd/m/Y',
            disable: [function () { return true; }],
            onChange: function (selectedDates) {
                if (selectedDates.length) {
                    var d = selectedDates[0];
                    var iso = toIsoDate(d);
                    $('#BookingDateHidden').val(iso);
                    loadAvailableSlots(iso);
                } else {
                    $('#BookingDateHidden').val('');
                    resetSlot();
                }
            }
        });

        $('#ConfirmBookingBtn').on('click', function () {
            var valid = true;
            if (!$('#SelectedCustomerId').val()) {
                abp.notify.warn('Vui lòng chọn khách hàng.');
                valid = false;
            }
            if (!$('#BookingLocationSelect').val()) {
                abp.notify.warn('Vui lòng chọn cơ sở.');
                valid = false;
            }
            if (!$('#BookingStylistSelect').val()) {
                abp.notify.warn('Vui lòng chọn stylist.');
                valid = false;
            }
            if (!$('#BookingDateHidden').val()) {
                abp.notify.warn('Vui lòng chọn ngày hẹn.');
                valid = false;
            }
            if (!$('#BookingTimeSlotIdHidden').val()) {
                abp.notify.warn(abp.localization.localize('SalonBeautyBookings:TimeSlotRequired', 'MultiTenancy'));
                valid = false;
            }
            if (serviceItems.length === 0 || serviceItems.some(function (i) { return !i.serviceId; })) {
                $('#ServiceItemsError').show();
                valid = false;
            } else {
                $('#ServiceItemsError').hide();
            }
            if (!valid) return;

            buildHiddenInputs();
            $('#ConfirmBookingBtn').prop('disabled', true);
            $('#CreateBookingForm').submit();
        });

        loadLookups();
        renderServiceItems();
    })();
</script>
