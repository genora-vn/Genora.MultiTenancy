@page
@using Genora.MultiTenancy.Localization
@using Microsoft.Extensions.Localization
@using Volo.Abp.AspNetCore.Mvc.UI.Bootstrap.TagHelpers.Modal
@using Genora.MultiTenancy.Web.Pages.SalonBeautyBookings
@model EditModalModel
@inject IStringLocalizer<MultiTenancyResource> L
@{
    Layout = null;
}

<form asp-page="/SalonBeautyBookings/EditModal" asp-route-id="@Model.BookingId" id="EditBookingForm" method="post" autocomplete="off" novalidate>
    <abp-modal size="Large">
        <abp-modal-body class="p-0">
            <div class="booking-modal">
                <div class="booking-modal-header">
                    <div>
                        <h3 class="booking-modal-title">Chỉnh sửa đặt lịch</h3>
                        <p class="booking-modal-subtitle">@Model.BookingCode</p>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>

                <div class="booking-modal-body">
                    <!-- Customer -->
                    <div class="mb-3">
                        <label class="booking-form-label">Khách hàng <span class="text-danger">*</span></label>
                        <div class="d-flex gap-2">
                            <div class="flex-grow-1 position-relative">
                                <input type="text" id="EditCustomerSearchInput" class="form-control" placeholder="Tìm kiếm tên hoặc số điện thoại..." autocomplete="off" />
                                <div id="EditCustomerSearchDropdown" class="customer-search-dropdown" style="display:none;"></div>
                            </div>
                        </div>
                        <input type="hidden" asp-for="Booking.CustomerId" id="EditSelectedCustomerId" value="@Model.Booking.CustomerId" />
                        <div id="EditSelectedCustomerInfo" class="selected-customer-info mt-2"></div>
                        <span asp-validation-for="Booking.CustomerId" class="text-danger"></span>
                    </div>

                    <!-- Booking Info -->
                    <div class="row g-3 mb-3">
                        <div class="col-md-3">
                            <label class="booking-form-label">Trạng thái</label>
                            <select asp-for="Booking.Status" asp-items="Model.StatusItems" class="form-select"></select>
                        </div>
                        <div class="col-md-3">
                            <label class="booking-form-label">Stylist chính</label>
                            <select asp-for="Booking.StylistId" id="EditBookingStylistSelect" class="form-select">
                                <option value="">-- Chọn Stylist --</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="booking-form-label">Ngày hẹn <span class="text-danger">*</span></label>
                            <input type="text" id="EditBookingDatePicker" class="form-control"
                                   value="@Model.Booking.BookingDate.ToString("dd/MM/yyyy")" />
                            <input type="hidden" asp-for="Booking.BookingDate" id="EditBookingDateHidden"
                                   value="@Model.Booking.BookingDate.ToString("yyyy-MM-dd")" />
                        </div>
                        <div class="col-md-3">
                            <label class="booking-form-label">Giờ bắt đầu</label>
                            <input type="time" asp-for="Booking.StartTime" class="form-control"
                                   value="@Model.Booking.StartTime.ToString(@"hh\:mm")" />
                        </div>
                    </div>

                    <!-- Services -->
                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <label class="booking-form-label mb-0">Danh sách dịch vụ <span class="text-danger">*</span></label>
                            <button type="button" id="EditAddServiceBtn" class="btn btn-link btn-sm p-0">
                                <i class="fa fa-plus-circle"></i> Thêm dịch vụ
                            </button>
                        </div>
                        <div class="booking-services-table">
                            <div class="booking-services-header row g-0">
                                <div class="col-5">Dịch vụ</div>
                                <div class="col-4">Thực hiện bởi</div>
                                <div class="col-2 text-end">Giá</div>
                                <div class="col-1"></div>
                            </div>
                            <div id="EditServiceItemsContainer"></div>
                        </div>
                        <span id="EditServiceItemsError" class="text-danger" style="display:none;">Vui lòng chọn ít nhất một dịch vụ.</span>
                    </div>

                    <!-- Notes -->
                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="booking-form-label">Ghi chú của khách hàng</label>
                            <textarea asp-for="Booking.CustomerNote" class="form-control" rows="3" placeholder="Ghi chú từ khách hàng..."></textarea>
                        </div>
                        <div class="col-md-6">
                            <label class="booking-form-label">Ghi chú nội bộ</label>
                            <textarea asp-for="Booking.InternalNote" class="form-control" rows="3" placeholder="Ghi chú nội bộ..."></textarea>
                        </div>
                    </div>

                    <!-- Total -->
                    <div class="booking-total-row">
                        <span class="booking-total-label">Tạm tính (<span id="EditServiceCountText">0</span> dịch vụ)</span>
                        <span class="booking-total-value" id="EditBookingSubTotal">0đ</span>
                    </div>
                </div>

                <div class="booking-modal-footer">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Hủy</button>
                    <button type="button" id="SaveBookingBtn" class="btn btn-primary">
                        <i class="fa fa-save"></i> Lưu thay đổi
                    </button>
                </div>
            </div>
        </abp-modal-body>
    </abp-modal>
</form>


<script>
    (function () {
        var services = [];
        var stylists = [];
        var serviceItems = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
            Model.Booking.Items.Select(x => new {
                serviceId = x.ServiceId.ToString(),
                stylistId = x.StylistId.HasValue ? x.StylistId.Value.ToString() : "",
                price = x.Price,
                duration = x.Duration
            })
        ));
        var bookingService = genora.multiTenancy.appServices.salonBeauties.salonBeautyBooking;

        function formatCurrency(val) {
            return Number(val || 0).toLocaleString('vi-VN') + 'đ';
        }

        function loadLookups(cb) {
            var p1 = bookingService.getServiceLookup().then(function (data) { services = data || []; });
            var p2 = bookingService.getStylistLookup().then(function (data) {
                stylists = data || [];
                var $sel = $('#EditBookingStylistSelect');
                $.each(stylists, function (i, s) {
                    var selected = s.id === '@Model.Booking.StylistId.ToString()' ? ' selected' : '';
                    $sel.append('<option value="' + s.id + '"' + selected + '>' + s.displayName + '</option>');
                });
            });
            $.when(p1, p2).done(function () { if (cb) cb(); });
        }

        function renderServiceRow(idx, item) {
            var serviceOptions = services.map(function (s) {
                return '<option value="' + s.id + '" data-price="' + s.price + '" data-duration="' + s.duration + '"' +
                    (item.serviceId === s.id ? ' selected' : '') + '>' + s.name + (s.categoryName ? ' - ' + s.categoryName : '') + '</option>';
            }).join('');
            var stylistOptions = '<option value="">-- Stylist --</option>' + stylists.map(function (s) {
                return '<option value="' + s.id + '"' + (item.stylistId === s.id ? ' selected' : '') + '>' + s.displayName + '</option>';
            }).join('');
            return '<div class="booking-service-row row g-2 align-items-center" data-idx="' + idx + '">' +
                '<div class="col-5"><select class="form-select form-select-sm edit-svc-select" data-idx="' + idx + '"><option value="">-- Chọn dịch vụ --</option>' + serviceOptions + '</select></div>' +
                '<div class="col-4"><select class="form-select form-select-sm edit-svc-stylist" data-idx="' + idx + '">' + stylistOptions + '</select></div>' +
                '<div class="col-2 text-end"><span class="edit-svc-price fw-bold" data-idx="' + idx + '">' + formatCurrency(item.price) + '</span></div>' +
                '<div class="col-1 text-center"><button type="button" class="btn btn-sm btn-link text-danger p-0 edit-svc-remove" data-idx="' + idx + '"><i class="fa fa-trash"></i></button></div>' +
                '</div>';
        }

        function renderServiceItems() {
            var $c = $('#EditServiceItemsContainer').empty();
            if (!serviceItems.length) {
                $c.html('<div class="text-center text-muted py-3" style="font-size:13px;">Chưa có dịch vụ nào.</div>');
            } else {
                serviceItems.forEach(function (item, idx) { $c.append(renderServiceRow(idx, item)); });
            }
            updateTotal();
        }

        function updateTotal() {
            var total = serviceItems.reduce(function (s, i) { return s + (i.price || 0); }, 0);
            $('#EditBookingSubTotal').text(formatCurrency(total));
            $('#EditServiceCountText').text(serviceItems.length);
        }

        function buildHiddenInputs() {
            $('[name^="Booking.Items"]').remove();
            serviceItems.forEach(function (item, idx) {
                $('<input>').attr({ type: 'hidden', name: 'Booking.Items[' + idx + '].ServiceId', value: item.serviceId }).appendTo('#EditBookingForm');
                $('<input>').attr({ type: 'hidden', name: 'Booking.Items[' + idx + '].StylistId', value: item.stylistId || '' }).appendTo('#EditBookingForm');
                $('<input>').attr({ type: 'hidden', name: 'Booking.Items[' + idx + '].Price', value: item.price || 0 }).appendTo('#EditBookingForm');
                $('<input>').attr({ type: 'hidden', name: 'Booking.Items[' + idx + '].Duration', value: item.duration || 0 }).appendTo('#EditBookingForm');
            });
        }

        // Load customer info for pre-selected from current page model, no external controller call.
        (function () {
            var currentCustomerName = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CurrentCustomerName ?? ""));
            var currentCustomerPhone = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CurrentCustomerPhone ?? ""));
            var currentCustomerCode = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.CurrentCustomerCode ?? ""));
            var initials = (currentCustomerName || 'K').charAt(0).toUpperCase();
            $('#EditCustomerSearchInput').val(currentCustomerName);
            $('#EditSelectedCustomerInfo').html(
                '<div class="customer-search-avatar">' + initials + '</div>' +
                '<div><strong>' + (currentCustomerName || '--') + '</strong> &nbsp; ' + (currentCustomerPhone || '') + (currentCustomerCode ? ' &nbsp; <span class="booking-customer-code-badge">' + currentCustomerCode + '</span>' : '') + '</div>'
            ).show();
        })();

        var searchTimer;
        $('#EditCustomerSearchInput').on('input', function () {
            clearTimeout(searchTimer);
            var q = $(this).val().trim();
            if (q.length < 2) { $('#EditCustomerSearchDropdown').hide(); return; }
            searchTimer = setTimeout(function () {
                bookingService.getCustomerLookup(q).then(function (data) {
                    var $dd = $('#EditCustomerSearchDropdown').empty().show();
                    if (!data.length) { $dd.html('<div class="customer-search-item text-muted">Không tìm thấy</div>'); return; }
                    data.forEach(function (c) {
                        var initials = (c.name || 'K').charAt(0).toUpperCase();
                        var $item = $('<div class="customer-search-item">' +
                            '<div class="customer-search-avatar">' + initials + '</div>' +
                            '<div><div class="customer-search-name">' + c.name + '</div>' +
                            '<div class="customer-search-phone">' + (c.phone || '--') + '</div></div></div>');
                        $item.on('click', function () {
                            $('#EditSelectedCustomerId').val(c.id);
                            $('#EditCustomerSearchInput').val(c.name);
                            $('#EditCustomerSearchDropdown').hide();
                            $('#EditSelectedCustomerInfo').html(
                                '<div class="customer-search-avatar">' + initials + '</div>' +
                                '<div><strong>' + c.name + '</strong> &nbsp; ' + (c.phone || '') + ((c.code || c.customerCode) ? ' &nbsp; <span class="booking-customer-code-badge">' + (c.code || c.customerCode) + '</span>' : '') + '</div>'
                            ).show();
                        });
                        $dd.append($item);
                    });
                });
            }, 300);
        });

        $(document).on('click', function (e) {
            if (!$(e.target).closest('#EditCustomerSearchInput, #EditCustomerSearchDropdown').length)
                $('#EditCustomerSearchDropdown').hide();
        });

        $('#EditAddServiceBtn').on('click', function () {
            serviceItems.push({ serviceId: '', stylistId: '', price: 0, duration: 0 });
            renderServiceItems();
        });

        $(document).on('change', '.edit-svc-select', function () {
            var idx = parseInt($(this).data('idx'));
            var $opt = $(this).find(':selected');
            serviceItems[idx].serviceId = $(this).val();
            serviceItems[idx].price = parseFloat($opt.data('price')) || 0;
            serviceItems[idx].duration = parseInt($opt.data('duration')) || 0;
            $(this).closest('.booking-service-row').find('.edit-svc-price').text(formatCurrency(serviceItems[idx].price));
            updateTotal();
        });

        $(document).on('change', '.edit-svc-stylist', function () {
            serviceItems[parseInt($(this).data('idx'))].stylistId = $(this).val();
        });

        $(document).on('click', '.edit-svc-remove', function () {
            serviceItems.splice(parseInt($(this).data('idx')), 1);
            renderServiceItems();
        });

        flatpickr('#EditBookingDatePicker', {
            dateFormat: 'd/m/Y',
            onChange: function (selectedDates) {
                if (selectedDates.length) {
                    var d = selectedDates[0];
                    $('#EditBookingDateHidden').val(d.getFullYear() + '-' + String(d.getMonth() + 1).padStart(2, '0') + '-' + String(d.getDate()).padStart(2, '0'));
                }
            }
        });

        $('#SaveBookingBtn').on('click', function () {
            if (!$('#EditSelectedCustomerId').val()) { abp.notify.warn('Vui lòng chọn khách hàng.'); return; }
            if (!serviceItems.length || serviceItems.some(function (i) { return !i.serviceId; })) {
                $('#EditServiceItemsError').show(); return;
            }
            $('#EditServiceItemsError').hide();
            buildHiddenInputs();
            $('#SaveBookingBtn').prop('disabled', true);
            $('#EditBookingForm').submit();
        });

        loadLookups(function () { renderServiceItems(); });
    })();
</script>
