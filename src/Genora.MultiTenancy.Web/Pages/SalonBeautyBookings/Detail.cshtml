@page
@using Genora.MultiTenancy.Enums
@using Genora.MultiTenancy.Localization
@using Microsoft.Extensions.Localization
@using Genora.MultiTenancy.Web.Pages.SalonBeautyBookings
@inject IStringLocalizer<MultiTenancyResource> L
@model DetailModel

@section styles {
    <link rel="stylesheet" href="~/pages/salon/booking-shared.css" asp-append-version="true" />
}

@section scripts {
    <script>
        (function () {
            var bookingService = genora.multiTenancy.appServices.salonBeauties.salonBeautyBooking;
            var bookingId = '@Model.Booking.Id';
            var currentStatus = @((byte)Model.Booking.Status);

            var statusNew = @((byte)SalonBeautyBookingStatus.New);
            var statusConfirmed = @((byte)SalonBeautyBookingStatus.Confirmed);
            var statusProcessing = @((byte)SalonBeautyBookingStatus.Processing);
            var statusCompleted = @((byte)SalonBeautyBookingStatus.Completed);
            var statusCancelled = @((byte)SalonBeautyBookingStatus.Cancelled);

            function showModal(selector) {
                var el = document.querySelector(selector);
                if (!el) return;
                if (window.bootstrap && bootstrap.Modal) {
                    bootstrap.Modal.getOrCreateInstance(el).show();
                    return;
                }
                if ($.fn.modal) {
                    $(selector).modal('show');
                }
            }

            function hideModal(selector) {
                var el = document.querySelector(selector);
                if (!el) return;
                if (window.bootstrap && bootstrap.Modal) {
                    bootstrap.Modal.getOrCreateInstance(el).hide();
                    return;
                }
                if ($.fn.modal) {
                    $(selector).modal('hide');
                }
            }

            function getNextStatus() {
                if (currentStatus === statusNew) return statusConfirmed;
                if (currentStatus === statusConfirmed) return statusProcessing;
                if (currentStatus === statusProcessing) return statusCompleted;
                return null;
            }

            function initStatusModal() {
                var nextStatus = getNextStatus();

                $('input[name="NextBookingStatus"]').prop('checked', false).prop('disabled', true);
                $('.sb-radio-card[data-status]').removeClass('is-selected is-current is-disabled');

                $('.sb-radio-card[data-status="' + currentStatus + '"]').addClass('is-current').find('input').prop('disabled', true);

                if (nextStatus !== null) {
                    $('.sb-radio-card[data-status="' + nextStatus + '"]').removeClass('is-disabled').find('input').prop('disabled', false);
                }

                $('.sb-radio-card[data-status]').each(function () {
                    var $card = $(this);
                    var status = parseInt($card.attr('data-status'));
                    var $input = $card.find('input');

                    if (status !== nextStatus || status === currentStatus) {
                        $card.addClass('is-disabled');
                        $input.prop('disabled', true);
                    }
                });

                $('#StatusInternalNoteInput').val('');
                $('#ConfirmStatusBtn').prop('disabled', true);
            }

            function initCancelModal() {
                $('input[name="CancelReason"]').prop('checked', false);
                $('.sb-radio-card[data-cancel-reason]').removeClass('is-selected');
                $('#CancelNoteInput').val('');
                $('#CancelNoteValidation').addClass('d-none');
                $('#ConfirmCancelBtn').prop('disabled', true);
            }

            function validateCancelModal() {
                var hasReason = $('input[name="CancelReason"]:checked').length > 0;
                var hasNote = $.trim($('#CancelNoteInput').val()).length > 0;
                $('#ConfirmCancelBtn').prop('disabled', !(hasReason && hasNote));

                if (hasNote) {
                    $('#CancelNoteValidation').addClass('d-none');
                }
            }

            $('body').on('change', 'input[name="NextBookingStatus"]', function () {
                $('.sb-radio-card[data-status]').removeClass('is-selected');
                $(this).closest('.sb-radio-card').addClass('is-selected');
                $('#ConfirmStatusBtn').prop('disabled', false);
            });

            $('body').on('change', 'input[name="CancelReason"]', function () {
                $('.sb-radio-card[data-cancel-reason]').removeClass('is-selected');
                $(this).closest('.sb-radio-card').addClass('is-selected');
                validateCancelModal();
            });

            $('body').on('input keyup change', '#CancelNoteInput', validateCancelModal);

            $('#StatusSelect').val(currentStatus);
            $('#PaymentStatusSelect').val('@((byte)Model.Booking.PaymentStatus)');
            @if (Model.Booking.PaymentMethod.HasValue)
            {
                <text>$('#PaymentMethodSelect').val('@((byte)Model.Booking.PaymentMethod.Value)');</text>
            }

            $('#BtnCheckin').on('click', function () {
                abp.message.confirm('Xác nhận khách hàng đã check-in?', 'Check-in', function (ok) {
                    if (!ok) return;
                    bookingService.checkin(bookingId)
                        .then(function () { abp.notify.success('Đã check-in thành công.'); location.reload(); })
                        .catch(function () { abp.notify.error('Check-in thất bại.'); });
                });
            });

            $('#BtnUpdatePayment').on('click', function () {
                showModal('#PaymentModal');
            });

            $('#ConfirmPaymentBtn').on('click', function () {
                var status = parseInt($('#PaymentStatusSelect').val());
                var method = $('#PaymentMethodSelect').val() ? parseInt($('#PaymentMethodSelect').val()) : null;

                $('#ConfirmPaymentBtn').prop('disabled', true);
                bookingService.updatePayment(bookingId, { paymentStatus: status, paymentMethod: method })
                    .then(function () { abp.notify.success('Cập nhật thanh toán thành công.'); location.reload(); })
                    .catch(function () {
                        abp.notify.error('Cập nhật thất bại.');
                        $('#ConfirmPaymentBtn').prop('disabled', false);
                    });
            });

            $(document).on('click', '#BtnCancel, #BtnCancelBooking', function () {
                if (currentStatus === statusCompleted) {
                    abp.notify.error('Không được hủy booking đã hoàn thành');
                    return;
                }

                initCancelModal();
                showModal('#CancelModal');
            });

            $('#ConfirmCancelBtn').on('click', function () {
                var hasReason = $('input[name="CancelReason"]:checked').length > 0;
                var note = $.trim($('#CancelNoteInput').val());

                if (!hasReason || !note) {
                    $('#CancelNoteValidation').removeClass('d-none');
                    $('#ConfirmCancelBtn').prop('disabled', true);
                    return;
                }

                var reason = parseInt($('input[name="CancelReason"]:checked').val());

                $('#ConfirmCancelBtn').prop('disabled', true);
                bookingService.cancel(bookingId, { cancelReason: reason, cancelNote: note })
                    .then(function () { abp.notify.success('Đã hủy lịch đặt.'); location.reload(); })
                    .catch(function (error) {
                        var message = error?.message || error?.responseJSON?.error?.message || 'Hủy thất bại.';
                        if (currentStatus === statusCompleted) {
                            message = 'Không được hủy booking đã hoàn thành';
                        }
                        abp.notify.error(message);
                        $('#ConfirmCancelBtn').prop('disabled', false);
                    });
            });

            $('#BtnUpdateStatus').on('click', function () {
                var nextStatus = getNextStatus();
                if (nextStatus === null) {
                    abp.notify.warn('Booking hiện tại không còn trạng thái tiếp theo để cập nhật.');
                    return;
                }

                initStatusModal();
                showModal('#StatusModal');
            });

            // Change Stylist
            var stylistsCache = null;
            var selectedStylistId = null;
            var currentStylistId = '@Model.Booking.StylistId';
            var currentLocationId = '@(Model.Booking.LocationId?.ToString() ?? "")';

            function renderStylistList(items, keyword) {
                var $list = $('#ChangeStylistList');
                $list.empty();
                if (!items || items.length === 0) {
                    $list.html('<div class="text-center text-muted py-3">Không có nhân viên phù hợp.</div>');
                    return;
                }

                var k = (keyword || '').toLowerCase().trim();
                var html = '';
                items.forEach(function (s) {
                    if (k && s.displayName.toLowerCase().indexOf(k) === -1) return;
                    var isCurrent = (s.id === currentStylistId);
                    var avatar = s.avatar
                        ? '<img src="' + s.avatar + '" alt="" />'
                        : '<i class="fa fa-user-o"></i>';
                    html += '<label class="sb-stylist-pick' + (isCurrent ? ' is-current' : '') + '" data-stylist-id="' + s.id + '">' +
                        '<input type="radio" name="ChangeStylistId" value="' + s.id + '" ' + (isCurrent ? 'disabled' : '') + ' />' +
                        '<span class="sb-stylist-pick-avatar">' + avatar + '</span>' +
                        '<span class="sb-stylist-pick-info">' +
                            '<span class="sb-stylist-pick-name">' + s.displayName + (isCurrent ? ' <small class="text-muted">(đang chọn)</small>' : '') + '</span>' +
                            (s.roleText ? '<span class="sb-stylist-pick-role">' + s.roleText + '</span>' : '') +
                        '</span>' +
                        '</label>';
                });
                $list.html(html || '<div class="text-center text-muted py-3">Không có nhân viên phù hợp.</div>');
            }

            $('#BtnChangeStylist').on('click', function () {
                selectedStylistId = null;
                $('#ChangeStylistKeyword').val('');
                $('#ChangeStylistNote').val('');
                $('#ConfirmChangeStylistBtn').prop('disabled', true);
                $('#ChangeStylistList').html('<div class="text-center text-muted py-3"><i class="fa fa-spinner fa-spin"></i> Đang tải...</div>');
                showModal('#ChangeStylistModal');

                var loc = currentLocationId ? currentLocationId : null;
                bookingService.getStylistLookup(loc)
                    .then(function (items) {
                        stylistsCache = items || [];
                        renderStylistList(stylistsCache, '');
                    })
                    .catch(function () {
                        $('#ChangeStylistList').html('<div class="text-center text-danger py-3">Không tải được danh sách nhân viên.</div>');
                    });
            });

            $('body').on('input keyup', '#ChangeStylistKeyword', function () {
                renderStylistList(stylistsCache || [], $(this).val());
            });

            $('body').on('change', 'input[name="ChangeStylistId"]', function () {
                selectedStylistId = $(this).val();
                $('.sb-stylist-pick').removeClass('is-selected');
                $(this).closest('.sb-stylist-pick').addClass('is-selected');
                $('#ConfirmChangeStylistBtn').prop('disabled', !selectedStylistId);
            });

            $('#ConfirmChangeStylistBtn').on('click', function () {
                if (!selectedStylistId) return;
                var note = $.trim($('#ChangeStylistNote').val());

                $('#ConfirmChangeStylistBtn').prop('disabled', true);
                bookingService.changeStylist(bookingId, { stylistId: selectedStylistId, note: note })
                    .then(function () {
                        abp.notify.success('Đã đổi stylist thành công.');
                        location.reload();
                    })
                    .catch(function (error) {
                        var message = error?.message || error?.responseJSON?.error?.message || 'Đổi stylist thất bại.';
                        abp.notify.error(message);
                        $('#ConfirmChangeStylistBtn').prop('disabled', false);
                    });
            });

            $('#ConfirmStatusBtn').on('click', function () {
                var $selected = $('input[name="NextBookingStatus"]:checked');
                if ($selected.length === 0) {
                    $('#ConfirmStatusBtn').prop('disabled', true);
                    return;
                }

                var status = parseInt($selected.val());
                var note = $.trim($('#StatusInternalNoteInput').val());

                $('#ConfirmStatusBtn').prop('disabled', true);
                bookingService.updateStatus(bookingId, {
                    status: status,
                    note: note,
                    internalNote: note,
                    reason: note
                })
                    .then(function () { abp.notify.success('Cập nhật trạng thái thành công.'); location.reload(); })
                    .catch(function (error) {
                        var message = error?.message || error?.responseJSON?.error?.message || 'Cập nhật thất bại.';
                        abp.notify.error(message);
                        $('#ConfirmStatusBtn').prop('disabled', false);
                    });
            });
        })();
    </script>
}

@{
    var currentStep = Model.GetCurrentStep();
    var isCancelled = Model.IsCancelled();
    var isCompleted = Model.Booking.Status == SalonBeautyBookingStatus.Completed;
    var canShowCancelButton = !isCancelled && !isCompleted;
    var canShowUpdateStatusButton = !isCancelled && !isCompleted;

    var statusClass = Model.Booking.Status switch
    {
        SalonBeautyBookingStatus.New => "sb-status-new",
        SalonBeautyBookingStatus.Confirmed => "sb-status-confirmed",
        SalonBeautyBookingStatus.Processing => "sb-status-processing",
        SalonBeautyBookingStatus.Completed => "sb-status-completed",
        SalonBeautyBookingStatus.Cancelled => "sb-status-cancelled",
        _ => "sb-status-new"
    };
    var paymentClass = Model.Booking.PaymentStatus switch
    {
        SalonBeautyPaymentStatus.Paid => "sb-payment-paid",
        SalonBeautyPaymentStatus.Refunded => "sb-payment-refunded",
        _ => "sb-payment-unpaid"
    };
    var checkinClass = Model.Booking.CheckinStatus switch
    {
        SalonBeautyCheckinStatus.CheckedIn => "sb-checkin-done",
        SalonBeautyCheckinStatus.NoShow => "sb-checkin-noshow",
        _ => "sb-checkin-not"
    };

    int progressStep = Model.Booking.Status switch
    {
        SalonBeautyBookingStatus.New => 1,
        SalonBeautyBookingStatus.Confirmed => 2,
        SalonBeautyBookingStatus.Processing => 3,
        SalonBeautyBookingStatus.Completed => 4,
        SalonBeautyBookingStatus.Cancelled => 2,
        _ => 1
    };

    string StepClass(int step) => isCancelled ? (step == 2 ? "is-cancelled" : "is-muted") : (progressStep > step ? "is-done" : (progressStep == step ? "is-active" : ""));
    var dateTimeText = $"{Model.Booking.BookingDate:dd/MM/yyyy} {Model.Booking.StartTime:hh\\:mm}";
    var initials = Model.GetCustomerInitials();

    string BookingStatusText(SalonBeautyBookingStatus status) => status switch
    {
        SalonBeautyBookingStatus.New => "Chờ xác nhận",
        SalonBeautyBookingStatus.Confirmed => "Đã xác nhận",
        SalonBeautyBookingStatus.Processing => "Đang thực hiện",
        SalonBeautyBookingStatus.Completed => "Hoàn thành",
        SalonBeautyBookingStatus.Cancelled => "Đã hủy",
        _ => status.ToString()
    };
}

<div class="sb-booking-detail-page">
    <div class="sb-detail-commandbar">
    <div class="sb-detail-command-left">
        <a href="/SalonBeautyBookings" class="sb-detail-back-icon" title="Quay lại danh sách đặt lịch">
            <i class="fa fa-arrow-left"></i>
        </a>
        <div class="sb-detail-breadcrumb">
            <i class="fa fa-calendar-check-o"></i>
            <span>Chi tiết đặt lịch</span>
            <strong>#@Model.Booking.BookingCode</strong>
        </div>
    </div>
    <div class="sb-detail-command-actions">
        @if (!isCancelled)
        {
            <button type="button" id="BtnCancelBooking" class="sb-btn sb-btn-outline">Hủy lịch</button>
        }
        @if (!isCancelled)
        {
            <button type="button" id="BtnUpdateStatus" class="sb-btn sb-btn-orange">Cập nhật trạng thái</button>
        }
    </div>
</div>

    <div class="sb-booking-detail-toolbar">
        <div>
            <div class="sb-booking-detail-meta-line">
                <span class="sb-booking-status-pill @statusClass">@Model.Booking.StatusText</span>
                <span class="sb-booking-date"><i class="fa fa-calendar-o"></i> @dateTimeText</span>
            </div>
            <h1 class="sb-booking-detail-title">Lịch đặt #@Model.Booking.BookingCode</h1>
        </div>
    </div>

    @if (isCancelled && Model.Booking.CancelReason.HasValue)
    {
        <div class="sb-cancel-box">
            <div class="sb-cancel-title"><i class="fa fa-exclamation-circle"></i> Lịch đặt đã bị hủy</div>
            <div class="sb-cancel-text">
                Lý do: @(Model.Booking.CancelReason switch {
                    SalonBeautyCancelReason.CustomerCancel => "Khách hàng hủy",
                    SalonBeautyCancelReason.SalonCancel => "Salon hủy",
                    SalonBeautyCancelReason.NoShow => "Khách không đến",
                    SalonBeautyCancelReason.Duplicate => "Trùng lịch",
                    _ => "Khác"
                })
                @if (!string.IsNullOrWhiteSpace(Model.Booking.CancelNote))
                {
                    <span> — @Model.Booking.CancelNote</span>
                }
            </div>
        </div>
    }

    <div class="sb-card sb-progress-card">
        <div class="sb-progress-card-top">
            <div>
                <div class="sb-progress-label">Ngày giờ sử dụng</div>
            </div>
            <div class="sb-progress-date"><i class="fa fa-calendar-o"></i> @dateTimeText</div>
        </div>

        <div class="sb-progress-track sb-progress-track-4 @(isCancelled ? "is-cancelled" : "")">
            <div class="sb-progress-line"></div>
            <div class="sb-progress-line-active step-@(isCancelled ? 2 : progressStep)"></div>

            <div class="sb-progress-step @StepClass(1)">
                <div class="sb-progress-icon"><i class="fa fa-check"></i></div>
                <div class="sb-progress-title">Đã đặt</div>
                <div class="sb-progress-time">@Model.Booking.CreationTime.ToString("HH:mm dd/MM")</div>
            </div>

            <div class="sb-progress-step @StepClass(2)">
                <div class="sb-progress-icon"><i class="fa @(isCancelled ? "fa-times" : "fa-calendar-check-o")"></i></div>
                <div class="sb-progress-title">@(isCancelled ? "Đã hủy" : "Đã xác nhận")</div>
                <div class="sb-progress-time">@(Model.Booking.LastModificationTime?.ToString("HH:mm dd/MM") ?? "--")</div>
            </div>

            <div class="sb-progress-step @StepClass(3)">
                <div class="sb-progress-icon"><i class="fa fa-scissors"></i></div>
                <div class="sb-progress-title">Đang thực hiện</div>
                <div class="sb-progress-time">@(Model.Booking.Status == SalonBeautyBookingStatus.Processing || Model.Booking.Status == SalonBeautyBookingStatus.Completed ? (Model.Booking.LastModificationTime?.ToString("HH:mm dd/MM") ?? "--") : "--")</div>
            </div>

            <div class="sb-progress-step @StepClass(4)">
                <div class="sb-progress-icon"><i class="fa fa-check-circle-o"></i></div>
                <div class="sb-progress-title">Hoàn thành</div>
                <div class="sb-progress-time">@(Model.Booking.Status == SalonBeautyBookingStatus.Completed ? (Model.Booking.LastModificationTime?.ToString("HH:mm dd/MM") ?? "--") : "--")</div>
            </div>
        </div>
    </div>

    <div class="sb-detail-layout">
        <main class="sb-detail-main">
            <section class="sb-card sb-services-card">
                <div class="sb-card-header">
                    <h2>Danh sách dịch vụ</h2>
                    <span>@Model.Booking.Items.Count dịch vụ</span>
                </div>

                <div class="sb-service-table-head">
                    <div>Dịch vụ</div>
                    <div>Thời gian</div>
                    <div>Đơn giá</div>
                    <div>Thành tiền</div>
                </div>

                @foreach (var item in Model.Booking.Items)
                {
                    <div class="sb-service-row">
                        <div class="sb-service-info">
                            <div class="sb-service-icon"><i class="fa fa-scissors"></i></div>
                            <div>
                                <div class="sb-service-name">@(item.ServiceName ?? "--")</div>
                                <div class="sb-service-note">
                                    @if (!string.IsNullOrWhiteSpace(item.ServiceCategoryName))
                                    {
                                        <span>@item.ServiceCategoryName</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(item.StylistName))
                                    {
                                        <span> • @item.StylistName</span>
                                    }
                                </div>
                            </div>
                        </div>
                        <div class="sb-service-duration">@item.Duration phút</div>
                        <div class="sb-service-price">@item.Price.ToString("N0")đ</div>
                        <div class="sb-service-total">@item.Price.ToString("N0")đ</div>
                    </div>
                }
            </section>

            <div class="sb-notes-grid">
                <section class="sb-card sb-note-card">
                    <h3><i class="fa fa-sticky-note-o"></i> Ghi chú khách hàng</h3>
                    <div class="sb-note-content">
                        @(string.IsNullOrWhiteSpace(Model.Booking.CustomerNote) ? "Không có ghi chú từ khách hàng." : Model.Booking.CustomerNote)
                    </div>
                </section>

                <section class="sb-card sb-note-card">
                    <h3><i class="fa fa-clipboard"></i> Ghi chú nội bộ</h3>
                    <textarea class="sb-internal-note" rows="4" readonly>@(Model.Booking.InternalNote ?? "")</textarea>
                </section>
            </div>
        </main>

        <aside class="sb-detail-side">
            <section class="sb-card sb-side-card">
                <h3>Thông tin khách hàng</h3>
                <div class="sb-customer-mini">
                    <div class="sb-customer-avatar">
                        @if (!string.IsNullOrWhiteSpace(Model.Booking.CustomerAvatar))
                        {
                            <img src="@Model.Booking.CustomerAvatar" alt="" />
                        }
                        else
                        {
                            @initials
                        }
                    </div>
                    <div>
                        <div class="sb-customer-name">@(Model.Booking.CustomerName ?? "--")</div>
                        <div class="sb-customer-type">Khách hàng thân thiết</div>
                    </div>
                </div>
                <div class="sb-info-list">
                    <div><span>Số điện thoại</span><strong>@(Model.Booking.CustomerPhoneMasked ?? Model.Booking.CustomerPhone ?? "--")</strong></div>
                    <div><span>Mã thành viên</span><strong class="sb-tag">@(Model.Booking.CustomerCode ?? "--")</strong></div>
                    <div><span>Điểm tích lũy</span><strong class="sb-orange-text">@Model.Booking.CustomerLoyaltyPoint điểm</strong></div>
                </div>
            </section>

            <section class="sb-card sb-side-card">
                <h3>Thông tin đặt lịch</h3>
                <div class="sb-info-list is-booking">
                    <div><span>Cơ sở</span><strong><i class="fa fa-building-o"></i> @(string.IsNullOrWhiteSpace(Model.Booking.LocationName) ? "--" : Model.Booking.LocationName)</strong></div>
                    <div><span>Ngày giờ sử dụng</span><strong><i class="fa fa-calendar-o"></i> @Model.Booking.BookingDate.ToString("dd/MM/yyyy")<br />@Model.Booking.StartTime.ToString(@"hh\:mm")</strong></div>
                </div>
                <div class="sb-side-divider"></div>
                <div class="sb-stylist-block-title">Stylist đã chọn</div>
                <div class="sb-stylist-mini">
                    <div class="sb-stylist-avatar">
                        @if (!string.IsNullOrWhiteSpace(Model.Booking.StylistAvatar))
                        {
                            <img src="@Model.Booking.StylistAvatar" alt="" />
                        }
                        else
                        {
                            <i class="fa fa-user-o"></i>
                        }
                    </div>
                    <div>
                        <div class="sb-stylist-name">@(Model.Booking.StylistName ?? "--")</div>
                        @if (!string.IsNullOrWhiteSpace(Model.Booking.StylistRoleText))
                        {
                            <span class="sb-stylist-role">@Model.Booking.StylistRoleText</span>
                        }
                    </div>
                </div>
                <div class="sb-info-list">
                    <div><span>Trạng thái check-in</span><strong class="sb-checkin-badge @checkinClass">@Model.Booking.CheckinStatusText</strong></div>
                    <div><span>Giờ check-in</span><strong>@(Model.Booking.CheckinTime?.ToString("HH:mm, dd/MM/yyyy") ?? "--")</strong></div>
                </div>
                @if (Model.CanCheckin && !isCancelled && Model.Booking.CheckinStatus != SalonBeautyCheckinStatus.CheckedIn)
                {
                    <button type="button" id="BtnCheckin" class="sb-side-action"><i class="fa fa-sign-in"></i> Check-in</button>
                }
                @if (!isCancelled && !isCompleted)
                {
                    <button type="button" id="BtnChangeStylist" class="sb-side-action"><i class="fa fa-refresh"></i> Thay đổi Stylist</button>
                }
            </section>

            <section class="sb-card sb-side-card sb-payment-card">
                <h3>Chi tiết thanh toán</h3>
                <div class="sb-payment-row"><span>Tạm tính</span><strong>@Model.Booking.SubTotal.ToString("N0")đ</strong></div>
                <div class="sb-payment-row"><span>Phụ phí</span><strong>@Model.Booking.Surcharge.ToString("N0")đ</strong></div>
                <div class="sb-payment-row"><span>Khuyến mãi</span><strong class="sb-green-text">-@Model.Booking.Discount.ToString("N0")đ</strong></div>
                <div class="sb-payment-total"><span>Tổng cộng</span><strong>@Model.Booking.TotalAmount.ToString("N0")đ</strong></div>

                <div class="sb-payment-paid @paymentClass">
                    <span><i class="fa fa-check-circle-o"></i> @Model.Booking.PaymentStatusText</span>
                    <strong>@(Model.Booking.PaidTime?.ToString("HH:mm dd/MM") ?? "--")</strong>
                </div>
                <div class="sb-payment-method"><span>Phương thức</span><strong><i class="fa fa-credit-card"></i> @(Model.Booking.PaymentMethodText ?? "--")</strong></div>

                @if (Model.CanUpdatePayment && !isCancelled)
                {
                    <button type="button" id="BtnUpdatePayment" class="sb-side-action mt-2"><i class="fa fa-credit-card"></i> Cập nhật thanh toán</button>
                }
            </section>

            <section class="sb-card sb-side-card sb-activity-card">
                <div class="sb-activity-head">
                    <h3>Lịch sử thao tác</h3>
                    <a href="/SalonBeautyBookings/History?id=@Model.Booking.Id">Xem thêm</a>
                </div>
                <div class="sb-activity-list">
                    @foreach (var activity in Model.Booking.Activities.Take(4))
                    {
                        <div class="sb-activity-item">
                            <span class="sb-activity-dot @(activity.IsDanger ? "is-danger" : "")"></span>
                            <div>
                                <div class="sb-activity-title">@activity.Title</div>
                                @if (!string.IsNullOrWhiteSpace(activity.Description))
                                {
                                    <div class="sb-activity-desc">@activity.Description</div>
                                }
                                <div class="sb-activity-time">@activity.Time.ToString("HH:mm, dd/MM/yyyy")</div>
                            </div>
                        </div>
                    }
                </div>
            </section>
        </aside>
    </div>
</div>

<!-- Payment Modal -->
<div class="modal fade sb-booking-action-modal" id="PaymentModal" tabindex="-1">
    <div class="modal-dialog modal-sm modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Cập nhật thanh toán</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label fw-semibold" style="font-size:13px;">Trạng thái thanh toán</label>
                    <select id="PaymentStatusSelect" class="form-select">
                        <option value="0">Chưa thanh toán</option>
                        <option value="1">Thanh toán một phần</option>
                        <option value="2">Đã thanh toán</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold" style="font-size:13px;">Phương thức</label>
                    <select id="PaymentMethodSelect" class="form-select">
                        <option value="">-- Chọn --</option>
                        <option value="0">Tiền mặt</option>
                        <option value="1">Chuyển khoản</option>
                        <option value="2">Thẻ</option>
                    </select>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Hủy</button>
                <button type="button" id="ConfirmPaymentBtn" class="btn btn-primary">Xác nhận</button>
            </div>
        </div>
    </div>
</div>

<!-- Cancel Modal -->
<div class="modal fade sb-booking-action-modal" id="CancelModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header sb-action-modal-header">
                <div class="sb-action-modal-icon is-danger">
                    <i class="fa fa-times"></i>
                </div>
                <div>
                    <h5 class="modal-title">Hủy lịch đặt</h5>
                    <div class="text-muted small">Vui lòng chọn lý do hủy và nhập lý do chi tiết.</div>
                </div>
                <button type="button" class="btn-close ms-auto" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="sb-radio-grid">
                    <label class="sb-radio-card" data-cancel-reason="@((byte)SalonBeautyCancelReason.CustomerCancel)">
                        <input type="radio" name="CancelReason" value="@((byte)SalonBeautyCancelReason.CustomerCancel)" />
                        <span>Khách hàng yêu cầu</span>
                    </label>
                    <label class="sb-radio-card" data-cancel-reason="@((byte)SalonBeautyCancelReason.SalonCancel)">
                        <input type="radio" name="CancelReason" value="@((byte)SalonBeautyCancelReason.SalonCancel)" />
                        <span>Salon hủy</span>
                    </label>
                    <label class="sb-radio-card" data-cancel-reason="@((byte)SalonBeautyCancelReason.NoShow)">
                        <input type="radio" name="CancelReason" value="@((byte)SalonBeautyCancelReason.NoShow)" />
                        <span>Khách không đến</span>
                    </label>
                    <label class="sb-radio-card" data-cancel-reason="@((byte)SalonBeautyCancelReason.Duplicate)">
                        <input type="radio" name="CancelReason" value="@((byte)SalonBeautyCancelReason.Duplicate)" />
                        <span>Trùng lịch</span>
                    </label>
                    <label class="sb-radio-card" data-cancel-reason="@((byte)SalonBeautyCancelReason.Other)">
                        <input type="radio" name="CancelReason" value="@((byte)SalonBeautyCancelReason.Other)" />
                        <span>Khác</span>
                    </label>
                </div>

                <div class="mt-3">
                    <label class="form-label fw-semibold" style="font-size:13px;">
                        Lý do hủy <span class="text-danger">*</span>
                    </label>
                    <textarea id="CancelNoteInput" class="form-control" rows="4" placeholder="Nhập lý do hủy booking..."></textarea>
                    <div id="CancelNoteValidation" class="text-danger small mt-1 d-none">Vui lòng nhập lý do</div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Hủy bỏ</button>
                <button type="button" id="ConfirmCancelBtn" class="btn btn-danger" disabled>Xác nhận hủy</button>
            </div>
        </div>
    </div>
</div>

<!-- Status Modal -->
<div class="modal fade sb-booking-action-modal" id="StatusModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header sb-action-modal-header">
                <div class="sb-action-modal-icon">
                    <i class="fa fa-refresh"></i>
                </div>
                <div>
                    <h5 class="modal-title">Cập nhật trạng thái lịch đặt</h5>
                    <div class="text-muted small">Chỉ được cập nhật sang trạng thái kế tiếp theo luồng: Chờ xác nhận → Đã xác nhận → Đang thực hiện → Hoàn thành.</div>
                </div>
                <button type="button" class="btn-close ms-auto" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <div class="text-muted small mb-2">Trạng thái hiện tại</div>
                    <span class="sb-current-status-pill @statusClass">@Model.Booking.StatusText</span>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold" style="font-size:13px;">Chọn trạng thái mới <span class="text-danger">*</span></label>
                    <div class="sb-radio-grid">
                        <label class="sb-radio-card" data-status="@((byte)SalonBeautyBookingStatus.New)">
                            <input type="radio" name="NextBookingStatus" value="@((byte)SalonBeautyBookingStatus.New)" />
                            <span>Chờ xác nhận</span>
                        </label>
                        <label class="sb-radio-card" data-status="@((byte)SalonBeautyBookingStatus.Confirmed)">
                            <input type="radio" name="NextBookingStatus" value="@((byte)SalonBeautyBookingStatus.Confirmed)" />
                            <span>Đã xác nhận</span>
                        </label>
                        <label class="sb-radio-card" data-status="@((byte)SalonBeautyBookingStatus.Processing)">
                            <input type="radio" name="NextBookingStatus" value="@((byte)SalonBeautyBookingStatus.Processing)" />
                            <span>Đang thực hiện</span>
                        </label>
                        <label class="sb-radio-card" data-status="@((byte)SalonBeautyBookingStatus.Completed)">
                            <input type="radio" name="NextBookingStatus" value="@((byte)SalonBeautyBookingStatus.Completed)" />
                            <span>Hoàn thành</span>
                        </label>
                    </div>
                </div>

                <div class="mt-3">
                    <label class="form-label fw-semibold" style="font-size:13px;">Ghi chú nội bộ</label>
                    <textarea id="StatusInternalNoteInput" class="form-control" rows="4" placeholder="Nhập ghi chú nội bộ cho lần cập nhật này..."></textarea>
                    <div class="text-muted small mt-1">Không bắt buộc nhập.</div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Hủy</button>
                <button type="button" id="ConfirmStatusBtn" class="btn btn-primary" disabled>Cập nhật</button>
            </div>
        </div>
    </div>
</div>

<!-- Change Stylist Modal -->
<div class="modal fade sb-booking-action-modal" id="ChangeStylistModal" tabindex="-1">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header sb-action-modal-header">
                <div class="sb-action-modal-icon">
                    <i class="fa fa-refresh"></i>
                </div>
                <div>
                    <h5 class="modal-title">Thay đổi nhân viên (Stylist)</h5>
                    <div class="text-muted small">Chọn stylist khác để gán cho lịch đặt này.</div>
                </div>
                <button type="button" class="btn-close ms-auto" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label fw-semibold" style="font-size:13px;">Tìm kiếm</label>
                    <input id="ChangeStylistKeyword" class="form-control" placeholder="Nhập tên stylist..." />
                </div>
                <div class="sb-stylist-pick-list" id="ChangeStylistList"></div>
                <div class="mt-3">
                    <label class="form-label fw-semibold" style="font-size:13px;">Ghi chú nội bộ</label>
                    <textarea id="ChangeStylistNote" class="form-control" rows="3" placeholder="Lý do đổi stylist (tùy chọn)..."></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">Hủy bỏ</button>
                <button type="button" id="ConfirmChangeStylistBtn" class="btn btn-primary" disabled>Cập nhật</button>
            </div>
        </div>
    </div>
</div>
