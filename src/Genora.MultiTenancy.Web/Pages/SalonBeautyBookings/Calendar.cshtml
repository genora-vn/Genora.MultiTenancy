@page
@using Genora.MultiTenancy.Localization
@using Microsoft.Extensions.Localization
@using Genora.MultiTenancy.Web.Pages.SalonBeautyBookings
@inject IStringLocalizer<MultiTenancyResource> L
@model CalendarModel

@section styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.11/main.min.css" />
    <link rel="stylesheet" href="/pages/salon/booking-shared.css" />
}

@section scripts {
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.11/index.global.min.js"></script>
    <abp-script src="/Pages/SalonBeautyBookings/calendar.js" />
}

<div class="salon-calendar-page">
    <div class="salon-calendar-main">
        <div class="salon-calendar-header">
            <div>
                <div class="salon-calendar-title">Lịch biểu đặt lịch Salon</div>
                <div class="salon-calendar-subtitle">Theo dõi lịch hẹn theo ngày, tuần, tháng và stylist</div>
            </div>
            <div class="salon-calendar-actions">
                <a href="/SalonBeautyBookings" class="btn btn-light btn-sm">
                    <i class="fa fa-arrow-left"></i> Quay lại danh sách
                </a>
                <button type="button" id="CalendarRefreshButton" class="btn btn-primary btn-sm">
                    <i class="fa fa-refresh"></i> Làm mới
                </button>
            </div>
        </div>
        <div class="salon-calendar-container">
            <div id="SalonCalendar"></div>
        </div>
    </div>

    <aside class="salon-calendar-sidebar">
        <div class="sidebar-section">
            <div class="sidebar-section-title">Stylist</div>
            <label class="sidebar-select-all">
                <input type="checkbox" id="SelectAllStylists" checked />
                <span>Tất cả stylist</span>
            </label>
            <ul id="StylistCheckboxList" class="stylist-checkbox-list"></ul>
        </div>

        <div class="sidebar-section">
            <div class="sidebar-section-title">Dịch vụ</div>
            <select id="ServiceFilterSelect" class="sidebar-filter-select">
                <option value="">Tất cả dịch vụ</option>
            </select>
        </div>

        <div class="sidebar-section">
            <div class="sidebar-section-title">Chú thích trạng thái</div>
            <ul class="legend-list">
                <li><span class="legend-dot is-pending"></span> Chờ xác nhận</li>
                <li><span class="legend-dot is-confirmed"></span> Đã xác nhận</li>
                <li><span class="legend-dot is-completed"></span> Hoàn thành</li>
                <li><span class="legend-dot is-cancelled"></span> Đã hủy</li>
            </ul>
        </div>
    </aside>
</div>
