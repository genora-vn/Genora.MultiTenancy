@page
@using Genora.MultiTenancy.Localization
@using Genora.MultiTenancy.Permissions
@using Genora.MultiTenancy.Web.Pages.AppFnbItems
@using Microsoft.AspNetCore.Authorization
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<MultiTenancyResource> L
@inject IAuthorizationService AuthorizationService
@inject Volo.Abp.MultiTenancy.ICurrentTenant CurrentTenant

@section scripts {
    <abp-script src="/Pages/AppFnbItems/index.js" />
    <abp-style src="/Pages/Index.css" />
}

@{
    var canCreate = CurrentTenant.IsAvailable
        ? await AuthorizationService.IsGrantedAsync(MultiTenancyPermissions.AppFnbItems.Create)
        : await AuthorizationService.IsGrantedAsync(MultiTenancyPermissions.HostAppFnbItems.Create);
}

<abp-card>
    <abp-card-header>
        <abp-row>
            <abp-column size-md="_6">
                <abp-card-title>@L["AppFnbItems"]</abp-card-title>
            </abp-column>
            <abp-column size-md="_6" class="text-end">
                @if (canCreate)
                {
                    <abp-button id="NewFnbItemButton"
                                text="@L["NewFnbItem"]"
                                icon="plus"
                                button-type="Outline_Primary" />
                }
            </abp-column>
        </abp-row>

        <abp-row class="mt-3">
            <abp-column size-md="_4">
                <div class="mb-3">
                    <label class="form-label" for="FnbItemFilterText">@L["FnbItemFilterText"]</label>
                    <input id="FnbItemFilterText" name="FnbItemFilterText" class="form-control" type="text" />
                </div>
            </abp-column>
            <abp-column size-md="_2">
                <div class="mb-3">
                    <label class="form-label" for="FnbItemCategoryIdFilter">@L["Category"]</label>
                    <select id="FnbItemCategoryIdFilter" class="form-select">
                        <option value="">@L["All"]</option>
                    </select>
                </div>
            </abp-column>
            <abp-column size-md="_2">
                <div class="mb-3">
                    <label class="form-label" for="FnbItemActiveFilter">@L["IsActive"]</label>
                    <select id="FnbItemActiveFilter" class="form-select">
                        <option value="">@L["All"]</option>
                        <option value="true">@L["Yes"]</option>
                        <option value="false">@L["No"]</option>
                    </select>
                </div>
            </abp-column>
            <abp-column size-md="_2">
                <div class="mb-3">
                    <label class="form-label" for="FnbItemAvailableFilter">@L["IsAvailable"]</label>
                    <select id="FnbItemAvailableFilter" class="form-select">
                        <option value="">@L["All"]</option>
                        <option value="true">@L["Yes"]</option>
                        <option value="false">@L["No"]</option>
                    </select>
                </div>
            </abp-column>
            <abp-column size-md="_2" class="d-flex align-items-end">
                <div class="mb-3 h-50">
                    <abp-button id="SearchFnbItemButton"
                                class="h-100"
                                text="@L["Search"]"
                                icon="search"
                                button-type="Outline_Primary" />
                </div>
            </abp-column>
        </abp-row>
    </abp-card-header>

    <abp-card-body>
        <abp-table striped-rows="true" id="FnbItemTable"></abp-table>
    </abp-card-body>
</abp-card>