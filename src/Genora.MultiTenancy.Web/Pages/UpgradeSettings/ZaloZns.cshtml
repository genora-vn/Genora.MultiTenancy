@page
@using Genora.MultiTenancy.Localization
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<MultiTenancyResource> L
@model Genora.MultiTenancy.Web.Pages.UpgradeSettings.ZaloZnsModel

<abp-card>
    <abp-card-body>
        <form method="post" asp-page="/UpgradeSettings/ZaloZns">
            <abp-card-body>
                <abp-row>
                    <abp-column size-md="_6" class="bor">
                        <div class="p-2 bg-body-tertiary">
                            <abp-card-header class="mb-3 p-0"
                                             title="@L["UpgradeSettings:ZaloZns:AppConfig:Title"].Value">
                                @L["UpgradeSettings:ZaloZns:AppConfig:Title"].Value
                            </abp-card-header>

                            <abp-input asp-for="Input.AppId" label="@L["UpgradeSettings:ZaloZns:AppId"].Value" />
                            <abp-input asp-for="Input.AppSecret" label="@L["UpgradeSettings:ZaloZns:AppSecret"].Value" />
                            <abp-input asp-for="Input.RedirectUri" label="@L["UpgradeSettings:ZaloZns:RedirectUri"].Value" />
                            <abp-input asp-for="Input.MiniAppId" label="@L["UpgradeSettings:ZaloZns:MiniAppId"].Value" />
                            <abp-input asp-for="Input.OaId" label="@L["UpgradeSettings:ZaloZns:OaId"].Value" />
                        </div>
                    </abp-column>

                    <abp-column size-md="_6">
                        <div class="p-2 bg-body-tertiary">
                            <abp-card-header class="mb-3 p-0"
                                             title="@L["UpgradeSettings:ZaloZns:Templates:Title"].Value">
                                @L["UpgradeSettings:ZaloZns:Templates:Title"].Value
                            </abp-card-header>

                            <abp-row>
                                <abp-column size-md="_6">
                                    <abp-input asp-for="Input.RegisterSuccess" label="@L["UpgradeSettings:ZaloZns:Template:RegisterSuccess"].Value" />
                                    <abp-input asp-for="Input.BookingCreated" label="@L["UpgradeSettings:ZaloZns:Template:BookingCreated"].Value" />
                                </abp-column>

                                <abp-column size-md="_6">
                                    <abp-input asp-for="Input.BookingCancelled" label="@L["UpgradeSettings:ZaloZns:Template:BookingCancelled"].Value" />
                                    <abp-input asp-for="Input.BookingReminder" label="@L["UpgradeSettings:ZaloZns:Template:BookingReminder"].Value" />
                                </abp-column>

                                <abp-column size-md="_6">
                                    <abp-input asp-for="Input.BookingChanged" label="@L["UpgradeSettings:ZaloZns:Template:BookingChanged"].Value" />
                                </abp-column>
                            </abp-row>

                            <abp-input asp-for="Input.ZbsEnabled" label="@L["UpgradeSettings:ZaloZns:ZbsEnabled"].Value" />
                        </div>
                    </abp-column>
                </abp-row>

                @* ── Checkout SDK Payment Config ────────────────────────── *@
                <abp-row class="mt-4">
                    <abp-column size-md="_12">
                        <div class="p-2 bg-body-tertiary">
                            <abp-card-header class="mb-3 p-0">
                                Checkout SDK — Cấu hình thanh toán
                            </abp-card-header>
                            <abp-row>
                                <abp-column size-md="_6">
                                    <div class="mb-3">
                                        <label class="form-label">Private Key (HMAC SHA256)</label>
                                        <input asp-for="Input.PaymentPrivateKey"
                                               type="password"
                                               class="form-control"
                                               placeholder="Nhập Private Key từ Zalo Developer Portal" />
                                        <div class="form-text text-muted">
                                            Để trống nếu không muốn thay đổi. Giá trị được mã hoá khi lưu.
                                        </div>
                                    </div>
                                </abp-column>
                            </abp-row>
                            <hr />
                            <p class="text-muted small mb-2">Thông tin tài khoản ngân hàng (hiển thị khi khách chọn Chuyển khoản)</p>
                            <abp-row>
                                <abp-column size-md="_3">
                                    <abp-input asp-for="Input.BankName" label="Tên ngân hàng" />
                                </abp-column>
                                <abp-column size-md="_3">
                                    <abp-input asp-for="Input.BankAccountNumber" label="Số tài khoản" />
                                </abp-column>
                                <abp-column size-md="_3">
                                    <abp-input asp-for="Input.BankAccountOwner" label="Chủ tài khoản" />
                                </abp-column>
                                <abp-column size-md="_3">
                                    <abp-input asp-for="Input.BankBranch" label="Chi nhánh" />
                                </abp-column>
                            </abp-row>
                        </div>
                    </abp-column>
                </abp-row>

                <div class="mt-3">
                    <button class="btn btn-primary" type="submit">
                        <i class="fa fa-save"></i>
                        @L["Save"].Value
                    </button>
                </div>
            </abp-card-body>
        </form>
    </abp-card-body>
</abp-card>