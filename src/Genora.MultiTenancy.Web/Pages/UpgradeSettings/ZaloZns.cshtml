@page
@using Genora.MultiTenancy.Localization
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<MultiTenancyResource> L
@model Genora.MultiTenancy.Web.Pages.UpgradeSettings.ZaloZnsModel

<abp-card>
    <abp-card-body>
        <form method="post" asp-page="/UpgradeSettings/ZaloZns">
            <abp-card-body>
                <abp-row>
                    <abp-column size-md="_4" class="bor">
                        <div class="p-2 bg-body-tertiary">
                            <abp-card-header class="mb-3 p-0"
                                             title="@L["UpgradeSettings:ZaloZns:AppConfig:Title"].Value">
                                @L["UpgradeSettings:ZaloZns:AppConfig:Title"].Value
                            </abp-card-header>

                            <abp-input asp-for="Input.AppId" label="@L["UpgradeSettings:ZaloZns:AppId"].Value" />
                            <abp-input asp-for="Input.AppSecret" label="@L["UpgradeSettings:ZaloZns:AppSecret"].Value" />
                            <abp-input asp-for="Input.RedirectUri" label="@L["UpgradeSettings:ZaloZns:RedirectUri"].Value" />
                            <abp-input asp-for="Input.MiniAppId" label="@L["UpgradeSettings:ZaloZns:MiniAppId"].Value" />
                            <abp-input asp-for="Input.OaId" label="@L["UpgradeSettings:ZaloZns:OaId"].Value" />
                        </div>
                    </abp-column>

                    <abp-column size-md="_8">
                        <div class="p-2 bg-body-tertiary">
                            <abp-card-header class="mb-3 p-0"
                                             title="@L["UpgradeSettings:ZaloZns:Templates:Title"].Value">
                                @L["UpgradeSettings:ZaloZns:Templates:Title"].Value
                            </abp-card-header>

                            <abp-row>
                                <abp-column size-md="_3">
                                    <abp-input asp-for="Input.RegisterSuccess" label="@L["UpgradeSettings:ZaloZns:Template:RegisterSuccess"].Value" />
                                    <abp-input asp-for="Input.BookingChanged" label="@L["UpgradeSettings:ZaloZns:Template:BookingChanged"].Value" />
                                    <abp-input asp-for="Input.BookingCancelled" label="@L["UpgradeSettings:ZaloZns:Template:BookingCancelled"].Value" />
                                    <abp-input asp-for="Input.BookingCreated" label="@L["UpgradeSettings:ZaloZns:Template:BookingCreated"].Value" />
                                    <abp-input asp-for="Input.BookingReminder" label="@L["UpgradeSettings:ZaloZns:Template:BookingReminder"].Value" />
                                    <abp-input asp-for="Input.ServiceReview" label="@L["UpgradeSettings:ZaloZns:Template:ServiceReview"].Value" />
                                </abp-column>

                                <abp-column size-md="_3">
                                    <abp-input asp-for="Input.FnbOrder" label="@L["UpgradeSettings:ZaloZns:Template:FnbOrder"].Value" />
                                    <abp-input asp-for="Input.ProshopOrder" label="@L["UpgradeSettings:ZaloZns:Template:ProshopOrder"].Value" />
                                    <abp-input asp-for="Input.CaddieBooking" label="@L["UpgradeSettings:ZaloZns:Template:CaddieBooking"].Value" />
                                </abp-column>

                                <abp-column size-md="_3">
                                    <abp-input asp-for="Input.FnbBookingPhoneNumber" label="@L["UpgradeSettings:ZaloZns:Template:FnbBookingPhoneNumber"].Value" />
                                    <abp-input asp-for="Input.ProshopOrderPhoneNumber" label="@L["UpgradeSettings:ZaloZns:Template:ProshopOrderPhoneNumber"].Value" />
                                    <abp-input asp-for="Input.CaddieBookingPhoneNumber" label="@L["UpgradeSettings:ZaloZns:Template:CaddieBookingPhoneNumber"].Value" />
                                    <abp-input asp-for="Input.GolfBookingPhoneNumber" label="@L["UpgradeSettings:ZaloZns:Template:GolfBookingPhoneNumber"].Value" />
                                </abp-column>

                                <abp-column size-md="_3">
                                    <abp-input asp-for="Input.OrderSuccess" label="@L["UpgradeSettings:ZaloZns:Template:OrderSuccess"].Value" />
                                    <abp-input asp-for="Input.RedeemPoint" label="@L["UpgradeSettings:ZaloZns:Template:RedeemPoint"].Value" />
                                    <abp-input asp-for="Input.ExchangeGift" label="@L["UpgradeSettings:ZaloZns:Template:ExchangeGift"].Value" />
                                </abp-column>
                            </abp-row>

                            <abp-input asp-for="Input.ZbsEnabled" label="@L["UpgradeSettings:ZaloZns:ZbsEnabled"].Value" />
                        </div>
                    </abp-column>
                </abp-row>

                @* ── Checkout SDK Payment Config ────────────────────────── *@
                <abp-row class="mt-4">
                    <abp-column size-md="_12">
                        <div class="p-2 bg-body-tertiary">
                            <abp-card-header class="mb-3 p-0">
                                @L["UpgradeSettings:ZaloZns:Payment:Title"].Value
                            </abp-card-header>
                            <abp-row>
                                <abp-column size-md="_6">
                                    <div class="mb-3">
                                        <label class="form-label">@L["UpgradeSettings:ZaloZns:Payment:PrivateKey"].Value</label>
                                        <input asp-for="Input.PaymentPrivateKey"
                                               type="password"
                                               class="form-control"
                                               placeholder="@L["UpgradeSettings:ZaloZns:Payment:PrivateKeyPlaceholder"].Value" />
                                        <div class="form-text text-muted">
                                            @L["UpgradeSettings:ZaloZns:Payment:PrivateKeyHint"].Value
                                        </div>
                                    </div>
                                </abp-column>
                            </abp-row>
                            <hr />
                            <p class="text-muted small mb-2">@L["UpgradeSettings:ZaloZns:Payment:BankInfoNote"].Value</p>
                            <abp-row>
                                <abp-column size-md="_3">
                                    <abp-input asp-for="Input.BankName" label="@L["UpgradeSettings:ZaloZns:Payment:BankName"].Value" />
                                </abp-column>
                                <abp-column size-md="_3">
                                    <abp-input asp-for="Input.BankAccountNumber" label="@L["UpgradeSettings:ZaloZns:Payment:BankAccountNumber"].Value" />
                                </abp-column>
                                <abp-column size-md="_3">
                                    <abp-input asp-for="Input.BankAccountOwner" label="@L["UpgradeSettings:ZaloZns:Payment:BankAccountOwner"].Value" />
                                </abp-column>
                                <abp-column size-md="_3">
                                    <abp-input asp-for="Input.BankBranch" label="@L["UpgradeSettings:ZaloZns:Payment:BankBranch"].Value" />
                                </abp-column>
                            </abp-row>

                            <hr />
                            <p class="text-muted small mb-2">@L["UpgradeSettings:ZaloZns:Payment:MethodsNote"].Value</p>
                            <abp-row>
                                <abp-column size-md="_6">
                                    <div class="form-check form-switch mb-2">
                                        <input class="form-check-input"
                                               type="checkbox"
                                               role="switch"
                                               id="IsPayAtCounterEnabled"
                                               asp-for="Input.IsPayAtCounterEnabled" />
                                        <label class="form-check-label" for="IsPayAtCounterEnabled">
                                            @L["UpgradeSettings:ZaloZns:Payment:IsPayAtCounterEnabled"].Value
                                        </label>
                                    </div>
                                </abp-column>
                                <abp-column size-md="_6">
                                    <div class="form-check form-switch mb-2">
                                        <input class="form-check-input"
                                               type="checkbox"
                                               role="switch"
                                               id="IsPayBankTransferEnabled"
                                               asp-for="Input.IsPayBankTransferEnabled" />
                                        <label class="form-check-label" for="IsPayBankTransferEnabled">
                                            @L["UpgradeSettings:ZaloZns:Payment:IsPayBankTransferEnabled"].Value
                                        </label>
                                    </div>
                                </abp-column>
                            </abp-row>
                        </div>
                    </abp-column>
                </abp-row>

                <div class="mt-3">
                    <button class="btn btn-primary" type="submit">
                        <i class="fa fa-save"></i>
                        @L["Save"].Value
                    </button>
                </div>
            </abp-card-body>
        </form>
    </abp-card-body>
</abp-card>