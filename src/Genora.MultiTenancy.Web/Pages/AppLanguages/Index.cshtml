@page
@using Genora.MultiTenancy.Permissions
@using Microsoft.AspNetCore.Authorization
@using Genora.MultiTenancy.Web.Pages.AppLanguages
@inject IAuthorizationService AuthorizationService
@inject Volo.Abp.MultiTenancy.ICurrentTenant CurrentTenant
@model IndexModel

@section styles {
    <abp-style src="/pages/caddie/caddie-shared.css" />
}

@section scripts {
    <abp-script src="/Pages/AppLanguages/index.js" />
}

@{
    var canCreate = CurrentTenant.IsAvailable
        ? await AuthorizationService.IsGrantedAsync(MultiTenancyPermissions.AppLanguages.Create)
        : await AuthorizationService.IsGrantedAsync(MultiTenancyPermissions.HostAppLanguages.Create);
    var canEdit = CurrentTenant.IsAvailable
        ? await AuthorizationService.IsGrantedAsync(MultiTenancyPermissions.AppLanguages.Edit)
        : await AuthorizationService.IsGrantedAsync(MultiTenancyPermissions.HostAppLanguages.Edit);
    var canDelete = CurrentTenant.IsAvailable
        ? await AuthorizationService.IsGrantedAsync(MultiTenancyPermissions.AppLanguages.Delete)
        : await AuthorizationService.IsGrantedAsync(MultiTenancyPermissions.HostAppLanguages.Delete);
}

<div class="caddie-page">
    <div class="caddie-header-row">
        <div>
            <h1 class="caddie-page-title">Cấu hình ngôn ngữ (Languages)</h1>
            <p class="caddie-page-subtitle">Quản lý danh mục ngôn ngữ dùng cho hồ sơ Caddy.</p>
        </div>
        @if (canCreate)
        {
            <button type="button" id="NewLanguageButton" class="btn-caddie-primary">
                <i class="fa fa-plus"></i> Thêm ngôn ngữ
            </button>
        }
    </div>

    <div class="caddie-table-container">
        <div class="table-responsive">
            <table id="LanguagesTable" class="caddie-table"></table>
        </div>
    </div>
</div>

<input type="hidden" id="CanEdit" value="@canEdit.ToString().ToLower()" />
<input type="hidden" id="CanDelete" value="@canDelete.ToString().ToLower()" />
