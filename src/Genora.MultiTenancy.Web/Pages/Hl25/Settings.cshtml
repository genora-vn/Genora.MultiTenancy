@page
@using Genora.MultiTenancy.Localization
@using Microsoft.Extensions.Localization
@model Genora.MultiTenancy.Web.Pages.Hl25.SettingsModel
@inject IStringLocalizer<MultiTenancyResource> L

@section styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/summernote@0.8.18/dist/summernote-lite.min.css" />
    <style>
        .hl25-sticky-save { position: sticky; top: 80px; }
        #Hl25SettingsForm .card-header { font-weight: 600; background-color: #f8f9fa; }
        #Hl25SettingsForm .note-editor { margin-bottom: 0; }
    </style>
}

@section scripts {
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script src="https://cdn.jsdelivr.net/npm/summernote@0.8.18/dist/summernote-lite.min.js"></script>
    <script src="~/Pages/Hl25/Settings.js" asp-append-version="true"></script>
}

<div class="mb-4">
    <h4><i class="fa fa-gear me-2"></i>@L["Hl25Settings:PageTitle"] — @L["Menu:Hl25"]</h4>
    <p class="text-muted mb-0">@L["Hl25Settings:PageSubtitle"]</p>
</div>

<form method="post" id="Hl25SettingsForm">
    <div class="row g-3">
        <div class="col-lg-8">
            <div class="card mb-3">
                <div class="card-header py-2"><i class="fa fa-circle-info me-1"></i> @L["Hl25Settings:ProgramInfo"]</div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">@L["Hl25Settings:ProgramName"]</label>
                        <input asp-for="Input.ProgramName" class="form-control" maxlength="256" />
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-semibold">@L["Hl25Settings:StartTime"]</label>
                            <input asp-for="Input.StartTime" class="form-control flatpickr-datetime" autocomplete="off" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-semibold">@L["Hl25Settings:EndTime"]</label>
                            <input asp-for="Input.EndTime" class="form-control flatpickr-datetime" autocomplete="off" />
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-semibold">@L["Hl25Settings:Scope"]</label>
                            <input asp-for="Input.Scope" class="form-control" maxlength="256" placeholder="@L["Hl25Settings:ScopePlaceholder"]" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-semibold">@L["Hl25Settings:OrganizerName"]</label>
                            <input asp-for="Input.OrganizerName" class="form-control" maxlength="256" placeholder="@L["Hl25Settings:OrganizerPlaceholder"]" />
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">@L["Hl25Settings:Format"]</label>
                        <input asp-for="Input.Format" class="form-control" maxlength="512" placeholder="@L["Hl25Settings:FormatPlaceholder"]" />
                    </div>
                    <div class="mb-0">
                        <label class="form-label fw-semibold">@L["Hl25Settings:GiftDeliveryTime"]</label>
                        <input asp-for="Input.GiftDeliveryTime" class="form-control" maxlength="512" placeholder="@L["Hl25Settings:GiftDeliveryTimePlaceholder"]" />
                    </div>
                </div>
            </div>

            <div class="card mb-3">
                <div class="card-header py-2"><i class="fa fa-star me-1"></i> @L["Hl25Settings:Introduction"]</div>
                <div class="card-body">
                    <textarea asp-for="Input.IntroductionHtml" class="html-editor"></textarea>
                </div>
            </div>

            <div class="card mb-3">
                <div class="card-header py-2"><i class="fa fa-scroll me-1"></i> @L["Hl25Settings:Rules"]</div>
                <div class="card-body">
                    <textarea asp-for="Input.RulesHtml" class="html-editor"></textarea>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card hl25-sticky-save">
                <div class="card-body">
                    <div class="form-check form-switch mb-3">
                        <input asp-for="Input.IsActive" class="form-check-input" type="checkbox" role="switch" />
                        <label class="form-check-label fw-semibold" asp-for="Input.IsActive">@L["Hl25Settings:IsActive"]</label>
                    </div>
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="fa fa-save me-1"></i> @L["Hl25Settings:Save"]
                    </button>
                </div>
            </div>
        </div>
    </div>
</form>
