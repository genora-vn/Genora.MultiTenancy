@page
@using Genora.MultiTenancy.Localization
@using Microsoft.Extensions.Localization
@using Volo.Abp.AspNetCore.Mvc.UI.Bootstrap.TagHelpers.Modal
@model Genora.MultiTenancy.Web.Pages.Hl25.GiftCreateModalModel
@inject IStringLocalizer<MultiTenancyResource> L
@{
    Layout = null;
}
<form method="post" asp-page="/Hl25/GiftCreateModal" id="CreateHl25Gift" enctype="multipart/form-data">
    <abp-modal size="Large">
        <abp-modal-header title="@L["Hl25Gift:CreateTitle"].Value"></abp-modal-header>
        <abp-modal-body>
            <partial name="_GiftForm" model="Model" />
        </abp-modal-body>
        <abp-modal-footer buttons="@(AbpModalButtons.Cancel | AbpModalButtons.Save)"></abp-modal-footer>
    </abp-modal>
</form>
<script>
    genora.hl25GiftModal.init('#CreateHl25Gift');
</script>
