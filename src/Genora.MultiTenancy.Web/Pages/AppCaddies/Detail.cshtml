@page
@using Genora.MultiTenancy.Web.Pages.AppCaddies
@using Genora.MultiTenancy.Permissions
@using Microsoft.AspNetCore.Authorization
@inject IAuthorizationService AuthorizationService
@inject Volo.Abp.MultiTenancy.ICurrentTenant CurrentTenant
@model DetailModel

@section styles {
    <abp-style src="/pages/caddie/caddie-shared.css" />
}

@section scripts {
    <abp-script src="/Pages/AppCaddies/detail.js" />
}

@{
    var canEdit = CurrentTenant.IsAvailable
        ? await AuthorizationService.IsGrantedAsync(MultiTenancyPermissions.AppCaddies.Edit)
        : await AuthorizationService.IsGrantedAsync(MultiTenancyPermissions.HostAppCaddies.Edit);

    var statusClass = Model.Caddie.Status == 1 ? "caddie-profile-status-badge" : "caddie-profile-status-badge" ;
    var statusText = Model.Caddie.Status == 1 ? "Đang hoạt động" : "Ngừng hoạt động";
    var statusBg = Model.Caddie.Status == 1 ? "background:#22c55e;" : "background:#6b7280;";
}

<div class="caddie-detail-page">
    <!-- Top Row: Profile + Next Booking -->
    <div class="row g-4 mb-4">
        <!-- Profile Card -->
        <div class="col-lg-8">
            <div class="caddie-profile-card">
                <div class="caddie-profile-avatar-wrap">
                    <img src="@(Model.Caddie.Avatar ?? "/images/default-avatar.png")" class="caddie-profile-avatar" onerror="this.src='/images/default-avatar.png'" />
                    <span class="caddie-profile-status-badge" style="@statusBg">@statusText</span>
                </div>
                <div class="flex-grow-1">
                    <h2 class="caddie-profile-name">@Model.Caddie.CaddieName</h2>
                    <div class="mt-2 d-flex flex-column gap-2 align-items-start">
                        <div class="caddie-profile-code-badge">
                            <span style="color:var(--caddie-on-surface-variant);font-weight:500;font-size:0.875rem;">Mã caddie:</span>
                            <span class="code">@Model.Caddie.CaddieCode</span>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <span class="caddie-stars">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    if (i <= Math.Round(Model.Caddie.RatingAvg))
                                    {
                                        <i class="fa fa-star"></i>
                                    }
                                    else if (i - 0.5 <= (double)Model.Caddie.RatingAvg)
                                    {
                                        <i class="fa fa-star-half-alt"></i>
                                    }
                                    else
                                    {
                                        <i class="far fa-star" style="color:#cbd5e1;"></i>
                                    }
                                }
                            </span>
                            <strong style="font-size:0.875rem;">@Model.Caddie.RatingAvg.ToString("0.0")</strong>
                            <span style="font-size:12px;color:var(--caddie-on-surface-variant);">(@Model.Caddie.TotalBooking đánh giá)</span>
                        </div>
                    </div>
                    @if (!string.IsNullOrEmpty(Model.Caddie.PhoneMasked))
                    {
                        <div class="mt-3">
                            <span id="phoneDisplay" data-masked="@Model.Caddie.PhoneMasked" data-full="@Model.Caddie.Phone"
                                  style="background:var(--caddie-surface-container-low);padding:8px 16px;border-radius:8px;border:1px solid rgba(192,199,212,0.3);font-size:0.875rem;font-weight:600;cursor:pointer;" title="Hover để xem số đầy đủ">
                                <i class="fa fa-phone text-primary me-2"></i>@Model.Caddie.PhoneMasked
                            </span>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Next Booking Card -->
        <div class="col-lg-4">
            <div class="caddie-next-booking-card">
                <div class="d-flex justify-content-between align-items-start">
                    <span class="caddie-next-booking-title">Ngày được khách hàng đặt lịch</span>
                    <i class="fa fa-calendar"></i>
                </div>
                <div class="caddie-next-booking-date" id="nextBookingDate">—</div>
                <div class="caddie-next-booking-sub" id="nextBookingInfo"></div>
                <button class="caddie-next-booking-btn" id="btnViewBookingDetail">Xem chi tiết booking</button>
            </div>
        </div>
    </div>

    <!-- Bottom Row: Info Sidebar + Tabs -->
    <div class="row g-4">
        <!-- Info Sidebar -->
        <div class="col-lg-3">
            <div class="caddie-info-card">
                <h3><i class="fa fa-id-card text-primary"></i> Thông tin chi tiết</h3>

                <div class="caddie-info-item">
                    <div class="caddie-info-label">Giới tính</div>
                    <div class="caddie-info-value">@(Model.Caddie.GenderText ?? "—")</div>
                </div>

                <div class="caddie-info-item">
                    <div class="caddie-info-label">Chiều cao</div>
                    <div class="caddie-info-value">@(Model.Caddie.HeightCm.HasValue ? $"{Model.Caddie.HeightCm} cm" : "—")</div>
                </div>

                <div class="caddie-info-item">
                    <div class="caddie-info-label">Giọng nói</div>
                    <div class="mt-1">
                        @if (Model.Caddie.VoiceRegions.Any())
                        {
                            @foreach (var vr in Model.Caddie.VoiceRegions)
                            {
                                <span class="caddie-info-tag caddie-info-tag-primary">@vr</span>
                            }
                        }
                        else
                        {
                            <span style="color:var(--caddie-on-surface-variant);">—</span>
                        }
                    </div>
                </div>

                <div class="caddie-info-item">
                    <div class="caddie-info-label">Ngoại ngữ</div>
                    <div class="mt-1">
                        @if (Model.Caddie.Languages.Any())
                        {
                            @foreach (var lang in Model.Caddie.Languages)
                            {
                                <span class="caddie-info-tag caddie-info-tag-tertiary">@lang</span>
                            }
                        }
                        else
                        {
                            <span style="color:var(--caddie-on-surface-variant);">—</span>
                        }
                    </div>
                </div>

                <div class="caddie-info-item">
                    <div class="caddie-info-label">Thời gian vào làm</div>
                    <div class="caddie-info-value">
                        @if (Model.Caddie.JoinDate.HasValue)
                        {
                            @Model.Caddie.JoinDate.Value.ToString("dd/MM/yyyy")
                        }
                        else
                        {
                            <span>—</span>
                        }
                    </div>
                    @if (Model.Caddie.ExperienceYear > 0)
                    {
                        <div style="font-size:10px;color:var(--caddie-on-surface-variant);font-style:italic;margin-top:2px;">(@Model.Caddie.ExperienceYear năm kinh nghiệm)</div>
                    }
                </div>

                @if (!string.IsNullOrEmpty(Model.Caddie.Note))
                {
                    <div class="mt-4">
                        <div class="caddie-info-label">Kỹ năng & Ghi chú</div>
                        <div class="caddie-note-quote mt-2">
                            "@Model.Caddie.Note"
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Main Content: Tabs -->
        <div class="col-lg-9">
            <div style="background:#fff;border-radius:12px;box-shadow:0 1px 3px rgba(0,0,0,.06);overflow:hidden;min-height:500px;border:1px solid rgba(192,199,212,0.1);">
                <!-- Tab Headers -->
                <ul class="nav caddie-tabs border-bottom" role="tablist">
                    <li class="nav-item">
                        <a class="nav-link active" data-bs-toggle="tab" href="#tabBookingHistory">Lịch sử đặt caddy</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" data-bs-toggle="tab" href="#tabReviews">Đánh giá khách hàng</a>
                    </li>
                </ul>

                <!-- Tab Content -->
                <div class="tab-content p-3">
                    <!-- Tab: Booking History -->
                    <div class="tab-pane fade show active" id="tabBookingHistory">
                        <div class="table-responsive">
                            <table id="tabBookingTable" class="table table-hover" style="font-size:0.875rem;width:100%;"></table>
                        </div>
                    </div>

                    <!-- Tab: Reviews -->
                    <div class="tab-pane fade" id="tabReviews">
                        <div class="table-responsive">
                            <table id="tabRatingTable" class="table table-hover" style="font-size:0.875rem;width:100%;"></table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- FAB Edit Button -->
    @if (canEdit)
    {
        <button class="caddie-fab" id="btnEditCaddie" data-id="@Model.Caddie.Id" title="Chỉnh sửa hồ sơ">
            <i class="fa fa-pencil"></i>
        </button>
    }
</div>

<!-- Review Detail Modal -->
<div class="modal fade" id="reviewDetailModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content" style="border-radius:12px;border:none;overflow:hidden;">

            <!-- Header -->
            <div class="modal-header" style="background:var(--caddie-surface-container-low);padding:20px 32px;border-bottom:1px solid rgba(192,199,212,0.15);">
                <div>
                    <h5 class="modal-title" style="font-weight:800;font-size:1.125rem;color:var(--caddie-on-surface);">Đánh giá chi tiết Caddy</h5>
                    <p style="font-size:12px;color:var(--caddie-on-surface-variant);margin:2px 0 0;">Thông tin phản hồi từ khách hàng sau buổi chơi</p>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <!-- Body -->
            <div class="modal-body" style="padding:32px;overflow-y:auto;max-height:calc(150vh - 200px);">

                <!-- Info Cards -->
                <div class="row g-3 mb-4 mt-2">
                    <!-- Booking Info -->
                    <div class="col-md-6">
                        <div style="background:var(--caddie-surface-container-low);padding:20px;border-radius:8px;border-bottom:2px solid var(--caddie-primary);height:100%;">
                            <div style="display:flex;align-items:center;gap:10px;margin-bottom:12px;">
                                <i class="fa fa-calendar text-primary" style="font-size:1rem;"></i>
                                <span style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.08em;color:var(--caddie-primary);">Thông tin đặt chỗ</span>
                            </div>
                            <div style="display:flex;justify-content:space-between;margin-bottom:6px;">
                                <span style="font-size:0.875rem;color:var(--caddie-on-surface-variant);">Mã đặt chỗ:</span>
                                <span style="font-size:0.875rem;font-weight:700;" id="reviewBookingCode">—</span>
                            </div>
                            <div style="display:flex;justify-content:space-between;">
                                <span style="font-size:0.875rem;color:var(--caddie-on-surface-variant);">Ngày chơi:</span>
                                <span style="font-size:0.875rem;font-weight:700;" id="reviewBookingDate">—</span>
                            </div>
                        </div>
                    </div>
                    <!-- Customer Info -->
                    <div class="col-md-6">
                        <div style="background:var(--caddie-surface-container-low);padding:20px;border-radius:8px;border-bottom:2px solid #005db7;height:100%;">
                            <div style="display:flex;align-items:center;gap:10px;margin-bottom:12px;">
                                <i class="fa fa-user" style="font-size:1rem;color:#005db7;"></i>
                                <span style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.08em;color:#005db7;">Khách hàng</span>
                            </div>
                            <div style="display:flex;align-items:center;gap:14px;">
                                <div style="width:40px;height:40px;border-radius:50%;overflow:hidden;background:var(--caddie-surface-container-highest);flex-shrink:0;position:relative;">
                                    <img id="reviewCustomerAvatar" src="" style="width:100%;height:100%;object-fit:cover;display:none;" />
                                    <div id="reviewCustomerInitials" style="width:100%;height:100%;display:flex;align-items:center;justify-content:center;font-weight:700;font-size:13px;color:var(--caddie-primary);background:rgba(0,94,164,0.1);"></div>
                                </div>
                                <div>
                                    <div style="font-weight:700;font-size:0.875rem;" id="reviewCustomerName">—</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Skill Ratings -->
                <div class="mb-4">
                    <h6 style="font-weight:700;margin-bottom:16px;display:flex;align-items:center;gap:8px;">
                        <i class="fa fa-bar-chart text-primary"></i> Đánh giá kỹ năng
                    </h6>
                    <div id="reviewSkillRatings" style="display:grid;grid-template-columns:1fr 1fr;gap:16px 48px;">
                        <p style="color:#707783;margin:0;">Đang tải...</p>
                    </div>
                </div>

                <!-- Comment -->
                <div class="mb-4">
                    <h6 style="font-weight:700;margin-bottom:12px;display:flex;align-items:center;gap:8px;">
                        <i class="fa fa-quote-left text-primary"></i> Nhận xét từ khách hàng
                    </h6>
                    <div style="background:var(--caddie-surface-container-low);padding:20px 24px;border-radius:8px;border-left:4px solid rgba(0,94,164,0.25);">
                        <p id="reviewComment" style="font-style:italic;color:var(--caddie-on-surface-variant);margin:0;line-height:1.6;font-size:0.875rem;">—</p>
                    </div>
                </div>
            </div>

            <!-- Footer -->
            <div class="modal-footer" style="background:var(--caddie-surface-container-low);padding:16px 32px;border-top:1px solid rgba(192,199,212,0.15);justify-content:flex-end;">
                <button type="button" class="btn-caddie-primary" data-bs-dismiss="modal" style="padding:10px 28px;">
                    <i class="fa fa-check-circle me-1"></i> Đóng cửa sổ
                </button>
            </div>
        </div>
    </div>
</div>

<input type="hidden" id="CaddieId" value="@Model.Caddie.Id" />
