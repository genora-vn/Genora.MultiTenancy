@page
@using Genora.MultiTenancy.Web.Pages.AppCaddies
@using Genora.MultiTenancy.Permissions
@using Microsoft.AspNetCore.Authorization
@inject IAuthorizationService AuthorizationService
@inject Volo.Abp.MultiTenancy.ICurrentTenant CurrentTenant
@model DetailModel

@section styles {
    <abp-style src="/pages/caddie/caddie-shared.css" />
}

@section scripts {
    <abp-script src="/Pages/AppCaddies/detail.js" />
}

@{
    var canEdit = CurrentTenant.IsAvailable
        ? await AuthorizationService.IsGrantedAsync(MultiTenancyPermissions.AppCaddies.Edit)
        : await AuthorizationService.IsGrantedAsync(MultiTenancyPermissions.HostAppCaddies.Edit);

    var statusClass = Model.Caddie.Status == 1 ? "caddie-profile-status-badge" : "caddie-profile-status-badge" ;
    var statusText = Model.Caddie.Status == 1 ? "Đang hoạt động" : "Ngừng hoạt động";
    var statusBg = Model.Caddie.Status == 1 ? "background:#22c55e;" : "background:#6b7280;";
}

<div class="caddie-detail-page">
    <!-- Top Row: Profile + Next Booking -->
    <div class="row g-4 mb-4">
        <!-- Profile Card -->
        <div class="col-lg-8">
            <div class="caddie-profile-card">
                <div class="caddie-profile-avatar-wrap">
                    <img src="@(Model.Caddie.Avatar ?? "/images/default-avatar.png")" class="caddie-profile-avatar" onerror="this.src='/images/default-avatar.png'" />
                    <span class="caddie-profile-status-badge" style="@statusBg">@statusText</span>
                </div>
                <div class="flex-grow-1">
                    <h2 class="caddie-profile-name">@Model.Caddie.CaddieName</h2>
                    <div class="mt-2 d-flex flex-column gap-2 align-items-start">
                        <div class="caddie-profile-code-badge">
                            <span style="color:var(--caddie-on-surface-variant);font-weight:500;font-size:0.875rem;">Mã caddie:</span>
                            <span class="code">@Model.Caddie.CaddieCode</span>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <span class="caddie-stars">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    if (i <= Math.Round(Model.Caddie.RatingAvg))
                                    {
                                        <i class="fa fa-star"></i>
                                    }
                                    else if (i - 0.5 <= (double)Model.Caddie.RatingAvg)
                                    {
                                        <i class="fa fa-star-half-alt"></i>
                                    }
                                    else
                                    {
                                        <i class="far fa-star" style="color:#cbd5e1;"></i>
                                    }
                                }
                            </span>
                            <strong style="font-size:0.875rem;">@Model.Caddie.RatingAvg.ToString("0.0")</strong>
                            <span style="font-size:12px;color:var(--caddie-on-surface-variant);">(@Model.Caddie.TotalBooking đánh giá)</span>
                        </div>
                    </div>
                    @if (!string.IsNullOrEmpty(Model.Caddie.PhoneMasked))
                    {
                        <div class="mt-3">
                            <span style="background:var(--caddie-surface-container-low);padding:8px 16px;border-radius:8px;border:1px solid rgba(192,199,212,0.3);font-size:0.875rem;font-weight:600;">
                                <i class="fa fa-phone text-primary me-2"></i>@Model.Caddie.PhoneMasked
                            </span>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Next Booking Card -->
        <div class="col-lg-4">
            <div class="caddie-next-booking-card">
                <div class="d-flex justify-content-between align-items-start">
                    <span class="caddie-next-booking-title">Ngày được khách hàng đặt lịch</span>
                    <i class="fa fa-calendar"></i>
                </div>
                <div class="caddie-next-booking-date" id="nextBookingDate">—</div>
                <div class="caddie-next-booking-sub" id="nextBookingInfo"></div>
                <button class="caddie-next-booking-btn" id="btnViewBookingDetail">Xem chi tiết booking</button>
            </div>
        </div>
    </div>

    <!-- Bottom Row: Info Sidebar + Tabs -->
    <div class="row g-4">
        <!-- Info Sidebar -->
        <div class="col-lg-3">
            <div class="caddie-info-card">
                <h3><i class="fa fa-id-card text-primary"></i> Thông tin chi tiết</h3>

                <div class="caddie-info-item">
                    <div class="caddie-info-label">Giới tính</div>
                    <div class="caddie-info-value">@(Model.Caddie.GenderText ?? "—")</div>
                </div>

                <div class="caddie-info-item">
                    <div class="caddie-info-label">Chiều cao</div>
                    <div class="caddie-info-value">@(Model.Caddie.HeightCm.HasValue ? $"{Model.Caddie.HeightCm} cm" : "—")</div>
                </div>

                <div class="caddie-info-item">
                    <div class="caddie-info-label">Giọng nói</div>
                    <div class="mt-1">
                        @if (Model.Caddie.VoiceRegions.Any())
                        {
                            @foreach (var vr in Model.Caddie.VoiceRegions)
                            {
                                <span class="caddie-info-tag caddie-info-tag-primary">@vr</span>
                            }
                        }
                        else
                        {
                            <span style="color:var(--caddie-on-surface-variant);">—</span>
                        }
                    </div>
                </div>

                <div class="caddie-info-item">
                    <div class="caddie-info-label">Ngoại ngữ</div>
                    <div class="mt-1">
                        @if (Model.Caddie.Languages.Any())
                        {
                            @foreach (var lang in Model.Caddie.Languages)
                            {
                                <span class="caddie-info-tag caddie-info-tag-tertiary">@lang</span>
                            }
                        }
                        else
                        {
                            <span style="color:var(--caddie-on-surface-variant);">—</span>
                        }
                    </div>
                </div>

                <div class="caddie-info-item">
                    <div class="caddie-info-label">Thời gian vào làm</div>
                    <div class="caddie-info-value">
                        @if (Model.Caddie.JoinDate.HasValue)
                        {
                            @Model.Caddie.JoinDate.Value.ToString("dd/MM/yyyy")
                        }
                        else
                        {
                            <span>—</span>
                        }
                    </div>
                    @if (Model.Caddie.ExperienceYear > 0)
                    {
                        <div style="font-size:10px;color:var(--caddie-on-surface-variant);font-style:italic;margin-top:2px;">(@Model.Caddie.ExperienceYear năm kinh nghiệm)</div>
                    }
                </div>

                @if (!string.IsNullOrEmpty(Model.Caddie.Note))
                {
                    <div class="mt-4">
                        <div class="caddie-info-label">Kỹ năng & Ghi chú</div>
                        <div class="caddie-note-quote mt-2">
                            "@Model.Caddie.Note"
                        </div>
                    </div>
                }
            </div>
        </div>

        <!-- Main Content: Tabs -->
        <div class="col-lg-9">
            <div style="background:#fff;border-radius:12px;box-shadow:0 1px 3px rgba(0,0,0,.06);overflow:hidden;min-height:500px;border:1px solid rgba(192,199,212,0.1);">
                <!-- Tab Headers -->
                <ul class="nav caddie-tabs border-bottom" role="tablist">
                    <li class="nav-item">
                        <a class="nav-link active" data-bs-toggle="tab" href="#tabBookingHistory">Lịch sử đặt caddy</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" data-bs-toggle="tab" href="#tabReviews">Đánh giá khách hàng</a>
                    </li>
                </ul>

                <!-- Tab Content -->
                <div class="tab-content p-4">
                    <!-- Tab: Booking History -->
                    <div class="tab-pane fade show active" id="tabBookingHistory">
                        <div style="background:var(--caddie-surface-container-low);border-radius:12px;overflow:hidden;border:1px solid rgba(192,199,212,0.3);">
                            <table class="table table-hover mb-0" style="font-size:0.875rem;">
                                <thead style="background:var(--caddie-surface-container-high);">
                                    <tr>
                                        <th style="padding:16px 24px;font-size:11px;font-weight:700;color:var(--caddie-on-surface-variant);text-transform:uppercase;letter-spacing:0.08em;">Ngày & Giờ đặt</th>
                                        <th style="padding:16px 24px;font-size:11px;font-weight:700;color:var(--caddie-on-surface-variant);text-transform:uppercase;letter-spacing:0.08em;">Tên Golfer</th>
                                        <th style="padding:16px 24px;font-size:11px;font-weight:700;color:var(--caddie-on-surface-variant);text-transform:uppercase;letter-spacing:0.08em;">Ngày & Giờ chơi</th>
                                        <th style="padding:16px 24px;font-size:11px;font-weight:700;color:var(--caddie-on-surface-variant);text-transform:uppercase;letter-spacing:0.08em;text-align:center;">Trạng thái thanh toán</th>
                                        <th style="padding:16px 24px;font-size:11px;font-weight:700;color:var(--caddie-on-surface-variant);text-transform:uppercase;letter-spacing:0.08em;text-align:center;">Đánh giá</th>
                                    </tr>
                                </thead>
                                <tbody style="background:#fff;">
                                    <tr>
                                        <td style="padding:16px 24px;font-weight:500;">19/10/2023 14:20</td>
                                        <td style="padding:16px 24px;font-weight:700;">Nguyễn Thành Trung</td>
                                        <td style="padding:16px 24px;color:var(--caddie-on-surface-variant);">20/10/2023 07:30</td>
                                        <td style="padding:16px 24px;text-align:center;"><span style="background:#dcfce7;color:#166534;font-size:10px;font-weight:700;padding:4px 8px;border-radius:4px;text-transform:uppercase;border:1px solid #bbf7d0;">Đã thanh toán</span></td>
                                        <td style="padding:16px 24px;text-align:center;" class="caddie-stars"><i class="fa fa-star"></i><i class="fa fa-star"></i><i class="fa fa-star"></i><i class="fa fa-star"></i><i class="fa fa-star"></i></td>
                                    </tr>
                                    <tr>
                                        <td style="padding:16px 24px;font-weight:500;">17/10/2023 10:15</td>
                                        <td style="padding:16px 24px;font-weight:700;">Phạm Minh Đạo</td>
                                        <td style="padding:16px 24px;color:var(--caddie-on-surface-variant);">18/10/2023 08:15</td>
                                        <td style="padding:16px 24px;text-align:center;"><span style="background:#fef9c3;color:#a16207;font-size:10px;font-weight:700;padding:4px 8px;border-radius:4px;text-transform:uppercase;border:1px solid #fde68a;">Chờ thanh toán</span></td>
                                        <td style="padding:16px 24px;text-align:center;" class="caddie-stars"><i class="fa fa-star"></i><i class="fa fa-star"></i><i class="fa fa-star"></i><i class="fa fa-star"></i><i class="far fa-star" style="color:#cbd5e1;"></i></td>
                                    </tr>
                                    <tr>
                                        <td style="padding:16px 24px;font-weight:500;">14/10/2023 16:45</td>
                                        <td style="padding:16px 24px;font-weight:700;">Vương Gia Hân</td>
                                        <td style="padding:16px 24px;color:var(--caddie-on-surface-variant);">15/10/2023 06:45</td>
                                        <td style="padding:16px 24px;text-align:center;"><span style="background:#dcfce7;color:#166534;font-size:10px;font-weight:700;padding:4px 8px;border-radius:4px;text-transform:uppercase;border:1px solid #bbf7d0;">Đã thanh toán</span></td>
                                        <td style="padding:16px 24px;text-align:center;" class="caddie-stars"><i class="fa fa-star"></i><i class="fa fa-star"></i><i class="fa fa-star"></i><i class="fa fa-star"></i><i class="fa fa-star"></i></td>
                                    </tr>
                                </tbody>
                            </table>
                            <div style="background:var(--caddie-surface-container);padding:16px 24px;display:flex;align-items:center;justify-content:space-between;border-top:1px solid rgba(192,199,212,0.3);">
                                <span style="font-size:11px;font-weight:700;color:var(--caddie-on-surface-variant);text-transform:uppercase;letter-spacing:0.08em;">Hiển thị 1-3 trong 42 flight</span>
                                <div class="d-flex align-items-center gap-1">
                                    <button class="btn btn-sm btn-light" disabled><i class="fa fa-chevron-left"></i></button>
                                    <button class="btn btn-sm btn-primary" style="width:32px;height:32px;font-size:12px;font-weight:700;">1</button>
                                    <button class="btn btn-sm btn-light" style="width:32px;height:32px;font-size:12px;font-weight:700;">2</button>
                                    <button class="btn btn-sm btn-light" style="width:32px;height:32px;font-size:12px;font-weight:700;">3</button>
                                    <button class="btn btn-sm btn-light"><i class="fa fa-chevron-right"></i></button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Tab: Reviews -->
                    <div class="tab-pane fade" id="tabReviews">
                        <div style="background:var(--caddie-surface-container-low);border-radius:12px;overflow:hidden;border:1px solid rgba(192,199,212,0.3);">
                            <table class="table table-hover mb-0" style="font-size:0.875rem;">
                                <thead style="background:var(--caddie-surface-container-high);">
                                    <tr>
                                        <th style="padding:16px 24px;font-size:11px;font-weight:700;color:var(--caddie-on-surface-variant);text-transform:uppercase;letter-spacing:0.08em;">Ngày & Giờ chơi</th>
                                        <th style="padding:16px 24px;font-size:11px;font-weight:700;color:var(--caddie-on-surface-variant);text-transform:uppercase;letter-spacing:0.08em;">Khách hàng</th>
                                        <th style="padding:16px 24px;font-size:11px;font-weight:700;color:var(--caddie-on-surface-variant);text-transform:uppercase;letter-spacing:0.08em;">Thời gian đánh giá</th>
                                        <th style="padding:16px 24px;font-size:11px;font-weight:700;color:var(--caddie-on-surface-variant);text-transform:uppercase;letter-spacing:0.08em;">Đánh giá</th>
                                        <th style="padding:16px 24px;font-size:11px;font-weight:700;color:var(--caddie-on-surface-variant);text-transform:uppercase;letter-spacing:0.08em;">Nhận xét</th>
                                        <th style="padding:16px 24px;font-size:11px;font-weight:700;color:var(--caddie-on-surface-variant);text-transform:uppercase;letter-spacing:0.08em;text-align:right;">Hành động</th>
                                    </tr>
                                </thead>
                                <tbody style="background:#fff;">
                                    <tr class="review-row" data-id="mock-1" style="cursor:pointer;">
                                        <td style="padding:16px 24px;font-weight:500;">20/10/2023 <span style="color:var(--caddie-on-surface-variant);font-weight:400;margin-left:4px;">07:30</span></td>
                                        <td style="padding:16px 24px;font-weight:700;">Nguyễn Thành Trung</td>
                                        <td style="padding:16px 24px;color:var(--caddie-on-surface-variant);">20/10/2023 14:30</td>
                                        <td style="padding:16px 24px;" class="caddie-stars"><i class="fa fa-star"></i><i class="fa fa-star"></i><i class="fa fa-star"></i><i class="fa fa-star"></i><i class="fa fa-star"></i></td>
                                        <td style="padding:16px 24px;color:var(--caddie-on-surface-variant);font-style:italic;max-width:200px;" class="text-truncate">"Phục vụ rất chuyên nghiệp, am hiểu địa hình."</td>
                                        <td style="padding:16px 24px;text-align:right;"><button class="btn btn-link btn-sm text-primary fw-bold p-0">Xem chi tiết</button></td>
                                    </tr>
                                    <tr class="review-row" data-id="mock-2" style="cursor:pointer;">
                                        <td style="padding:16px 24px;font-weight:500;">18/10/2023 <span style="color:var(--caddie-on-surface-variant);font-weight:400;margin-left:4px;">08:15</span></td>
                                        <td style="padding:16px 24px;font-weight:700;">Phạm Minh Đạo</td>
                                        <td style="padding:16px 24px;color:var(--caddie-on-surface-variant);">18/10/2023 16:00</td>
                                        <td style="padding:16px 24px;" class="caddie-stars"><i class="fa fa-star"></i><i class="fa fa-star"></i><i class="fa fa-star"></i><i class="fa fa-star"></i><i class="far fa-star" style="color:#cbd5e1;"></i></td>
                                        <td style="padding:16px 24px;color:var(--caddie-on-surface-variant);font-style:italic;max-width:200px;" class="text-truncate">"Nhiệt tình nhưng cần cải thiện tốc độ."</td>
                                        <td style="padding:16px 24px;text-align:right;"><button class="btn btn-link btn-sm text-primary fw-bold p-0">Xem chi tiết</button></td>
                                    </tr>
                                </tbody>
                            </table>
                            <div style="background:var(--caddie-surface-container);padding:16px 24px;display:flex;align-items:center;justify-content:space-between;border-top:1px solid rgba(192,199,212,0.3);">
                                <span style="font-size:11px;font-weight:700;color:var(--caddie-on-surface-variant);text-transform:uppercase;letter-spacing:0.08em;">Hiển thị 1-2 trong 15 đánh giá</span>
                                <div class="d-flex align-items-center gap-1">
                                    <button class="btn btn-sm btn-light" disabled><i class="fa fa-chevron-left"></i></button>
                                    <button class="btn btn-sm btn-primary" style="width:32px;height:32px;font-size:12px;font-weight:700;">1</button>
                                    <button class="btn btn-sm btn-light" style="width:32px;height:32px;font-size:12px;font-weight:700;">2</button>
                                    <button class="btn btn-sm btn-light"><i class="fa fa-chevron-right"></i></button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- FAB Edit Button -->
    @if (canEdit)
    {
        <button class="caddie-fab" id="btnEditCaddie" data-id="@Model.Caddie.Id" title="Chỉnh sửa hồ sơ">
            <i class="fa fa-pencil"></i>
        </button>
    }
</div>

<!-- Review Detail Modal -->
<div class="modal fade" id="reviewDetailModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius:12px;border:none;">
            <div class="modal-header" style="border-bottom:1px solid rgba(192,199,212,0.1);padding:20px 24px;">
                <div>
                    <h5 class="modal-title" style="font-family:'Manrope';font-weight:800;">Đánh giá chi tiết Caddy</h5>
                    <p style="font-size:12px;color:var(--caddie-on-surface-variant);margin:2px 0 0;">Thông tin phản hồi từ khách hàng sau buổi chơi</p>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" style="padding:24px;">
                <!-- Booking + Customer Info -->
                <div class="row g-3 mb-4">
                    <div class="col-6">
                        <div style="border:1px solid var(--caddie-outline-variant);border-radius:12px;padding:16px;">
                            <div style="font-size:10px;font-weight:700;color:var(--caddie-on-surface-variant);text-transform:uppercase;margin-bottom:8px;"><i class="fa fa-calendar me-1"></i> THÔNG TIN ĐẶT CHỖ</div>
                            <div style="font-size:0.875rem;">Mã đặt chỗ: <strong id="reviewBookingCode">#BK-1234</strong></div>
                            <div style="font-size:0.875rem;">Ngày chơi: <span id="reviewPlayDate">20/10/2023 - 07:30</span></div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div style="border:1px solid var(--caddie-outline-variant);border-radius:12px;padding:16px;">
                            <div style="font-size:10px;font-weight:700;color:var(--caddie-on-surface-variant);text-transform:uppercase;margin-bottom:8px;"><i class="fa fa-user me-1"></i> KHÁCH HÀNG</div>
                            <div class="d-flex align-items-center gap-2">
                                <img id="reviewCustomerAvatar" src="/images/default-avatar.png" class="rounded-circle" style="width:32px;height:32px;" />
                                <div>
                                    <strong id="reviewCustomerName" style="font-size:0.875rem;">Nguyễn Thành Trung</strong>
                                    <div style="font-size:11px;color:var(--caddie-primary);font-weight:600;" id="reviewCustomerTier">Thành viên Diamond</div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Skill Ratings -->
                <h6 style="font-weight:700;margin-bottom:12px;"><i class="fa fa-star text-warning me-1"></i> Đánh giá kỹ năng</h6>
                <div class="row g-2 mb-4" id="reviewSkillRatings">
                    <div class="col-6 d-flex justify-content-between align-items-center" style="font-size:0.875rem;"><span>Đọc line</span><span class="caddie-stars"><i class="fa fa-star"></i><i class="fa fa-star"></i><i class="fa fa-star"></i><i class="fa fa-star"></i><i class="far fa-star" style="color:#cbd5e1;"></i></span></div>
                    <div class="col-6 d-flex justify-content-between align-items-center" style="font-size:0.875rem;"><span>Thái độ</span><span class="caddie-stars"><i class="fa fa-star"></i><i class="fa fa-star"></i><i class="fa fa-star"></i><i class="fa fa-star"></i><i class="far fa-star" style="color:#cbd5e1;"></i></span></div>
                    <div class="col-6 d-flex justify-content-between align-items-center" style="font-size:0.875rem;"><span>Tư vấn gậy</span><span class="caddie-stars"><i class="fa fa-star"></i><i class="fa fa-star"></i><i class="fa fa-star"></i><i class="fa fa-star"></i><i class="fa fa-star"></i></span></div>
                    <div class="col-6 d-flex justify-content-between align-items-center" style="font-size:0.875rem;"><span>Hiểu biết địa hình</span><span class="caddie-stars"><i class="fa fa-star"></i><i class="fa fa-star"></i><i class="fa fa-star"></i><i class="fa fa-star"></i><i class="far fa-star" style="color:#cbd5e1;"></i></span></div>
                </div>

                <!-- Comment -->
                <h6 style="font-weight:700;margin-bottom:12px;"><i class="fa fa-comment text-info me-1"></i> Nhận xét từ khách hàng</h6>
                <div class="caddie-note-quote" id="reviewComment">
                    "Caddy rất nhiệt tình, đọc line chính xác và hỗ trợ chọn gậy rất tốt. Sẽ tiếp tục đặt bạn này lần tới."
                </div>
            </div>
            <div class="modal-footer" style="border-top:1px solid rgba(192,199,212,0.1);padding:16px 24px;">
                <button type="button" class="btn-caddie-primary" data-bs-dismiss="modal">
                    <i class="fa fa-check"></i> Đóng cửa sổ
                </button>
            </div>
        </div>
    </div>
</div>

<input type="hidden" id="CaddieId" value="@Model.Caddie.Id" />
