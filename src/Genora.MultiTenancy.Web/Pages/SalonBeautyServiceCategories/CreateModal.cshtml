@page
@using Genora.MultiTenancy.Localization
@using Microsoft.Extensions.Localization
@using Volo.Abp.AspNetCore.Mvc.UI.Bootstrap.TagHelpers.Modal
@using Genora.MultiTenancy.Web.Pages.SalonBeautyServiceCategories
@model CreateModalModel
@inject IStringLocalizer<MultiTenancyResource> L
@{
    Layout = null;
}

<form asp-page="/SalonBeautyServiceCategories/CreateModal" id="CreateSalonServiceCategoryForm" class="service-category-form" method="post" autocomplete="off" novalidate>
    <abp-modal size="Large">
        <abp-modal-body class="p-0">
            <div class="service-modal service-category-modal">
                <div class="service-modal-header">
                    <div class="service-modal-title-wrap">
                        <div class="service-modal-icon"><i class="fa fa-folder-plus"></i></div>
                        <div>
                            <h3>@L["SalonBeautyServiceCategories:CreateTitle"]</h3>
                            <p>@L["SalonBeautyServiceCategories:CreateSubTitle"]</p>
                        </div>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@L["Close"]"></button>
                </div>

                <div class="service-modal-body">
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="service-form-label" asp-for="Category.Name">@L["SalonBeautyServiceCategory:Name"] <span class="text-danger">*</span></label>
                            <input asp-for="Category.Name" class="form-control service-form-control service-category-required" required maxlength="255" placeholder="@L["SalonBeautyServiceCategories:NamePlaceholder"]" />
                            <span asp-validation-for="Category.Name" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label class="service-form-label" asp-for="Category.SortOrder">@L["SalonBeautyServiceCategory:SortOrder"]</label>
                            <input asp-for="Category.SortOrder" type="number" min="0" class="form-control service-form-control service-category-number-input" placeholder="1" />
                            <span asp-validation-for="Category.SortOrder" class="text-danger"></span>
                        </div>

                        <div class="col-md-6">
                            <label class="service-form-label">@L["SalonBeautyServiceCategory:Status"]</label>
                            <div class="service-status-box service-category-status-inline">
                                <div class="service-status-icon"><i class="fa fa-shield"></i></div>
                                <div class="flex-grow-1">
                                    <strong>@L["SalonBeautyServiceCategories:StatusBoxTitle"]</strong>
                                    <span>@L["SalonBeautyServiceCategories:StatusBoxDescription"]</span>
                                </div>
                                <input asp-for="Category.Status" type="hidden" class="service-category-status-value" />
                                <div class="service-switch-wrap">
                                    <label class="service-switch">
                                        <input type="checkbox" class="service-category-status-toggle" @(Model.Category.Status == 1 ? "checked" : "") />
                                        <span class="service-switch-slider"></span>
                                    </label>
                                    <strong class="service-category-status-toggle-text"
                                            data-active="@L["SalonBeautyCustomer:StatusActive"]"
                                            data-inactive="@L["SalonBeautyCustomer:StatusInactive"]">
                                        @(Model.Category.Status == 1 ? L["SalonBeautyCustomer:StatusActive"] : L["SalonBeautyCustomer:StatusInactive"])
                                    </strong>
                                </div>
                            </div>
                        </div>

                        <div class="col-12">
                            <label class="service-form-label" asp-for="Category.Description">@L["SalonBeautyServiceCategory:Description"]</label>
                            <textarea asp-for="Category.Description" rows="3" maxlength="500" class="form-control service-form-textarea" placeholder="@L["SalonBeautyServiceCategories:DescriptionPlaceholder"]"></textarea>
                            <span asp-validation-for="Category.Description" class="text-danger"></span>
                        </div>

                        <div class="col-12">
                            <label class="service-form-label" asp-for="Category.Note">@L["SalonBeautyServiceCategory:Note"]</label>
                            <textarea asp-for="Category.Note" rows="3" maxlength="500" class="form-control service-form-textarea" placeholder="@L["SalonBeautyServiceCategories:NotePlaceholder"]"></textarea>
                            <span asp-validation-for="Category.Note" class="text-danger"></span>
                        </div>
                    </div>
                </div>

                <div class="service-modal-footer">
                    <button type="button" class="service-btn-secondary" data-bs-dismiss="modal">@L["Cancel"]</button>
                    <button type="submit" class="service-btn-primary service-category-submit-button">
                        <i class="fa fa-save"></i> @L["SalonBeautyServiceCategories:SaveButton"]
                    </button>
                </div>
            </div>
        </abp-modal-body>
    </abp-modal>
</form>
