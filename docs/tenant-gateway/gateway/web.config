<?xml version="1.0" encoding="utf-8"?>
<!-- web.config cho site IIS Genora.Tenant.Gateway. env=Production => nap appsettings.Production.json.
     httpErrors PassThrough de response 429 tu YARP giu nguyen. App pool: No Managed Code, Integrated, Maximum Worker Processes = 1 (quota rate-limit la process-local). -->
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <httpErrors existingResponse="PassThrough" />
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\Genora.MultiTenancy.Gateway.dll" stdoutLogEnabled="false" hostingModel="inprocess">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
          <environmentVariable name="ASPNETCORE_URLS" value="http://127.0.0.1:5088" />
        </environmentVariables>
      </aspNetCore>
      <security><requestFiltering><requestLimits maxAllowedContentLength="20971520" /></requestFiltering></security>
    </system.webServer>
  </location>
</configuration>
