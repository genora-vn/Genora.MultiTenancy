<?xml version="1.0" encoding="utf-8"?>
<!--
  PHUONG AN THAY THE (KHONG DUNG TREN PRODUCTION HIEN TAI).
  Production dang dung XAMPP Apache lam ingress tren cong 443 (xem ../apache/genora-miniapp-vhosts.conf).
  File nay CHI dung neu sau nay chuyen ingress sang IIS (site rieng, App Pool rieng, ARR Enable Proxy + preserveHostHeader=true),
  va Apache KHONG con giu cong 443. Khi do IIS site nay owns 443:duocpham-hoalinh.genora.vn / hoalinh.genora.vn.
  Fallback dung *.genora.vn de KHONG lam hong cac tenant khac (montgo/blue-diamond/laguna/ami-salon...).
-->
<configuration>
  <system.webServer>
    <httpErrors existingResponse="PassThrough" />
    <rewrite>
      <rules>
        <clear />
        <rule name="HL25 Admin to ABP" stopProcessing="true">
          <match url="^/?api/mini-app/hl25/admin(?:/.*)?$" ignoreCase="true" />
          <conditions><add input="{HTTP_HOST}" pattern="^(?:duocpham\-hoalinh\.genora\.vn)(?::443)?$" ignoreCase="true" /></conditions>
          <serverVariables>
            <set name="HTTP_X_FORWARDED_HOST" value="{HTTP_HOST}" />
            <set name="HTTP_X_FORWARDED_PROTO" value="https" />
          </serverVariables>
          <action type="Rewrite" url="http://127.0.0.1:8868/{R:0}" appendQueryString="true" />
        </rule>
        <rule name="HLG Admin to ABP" stopProcessing="true">
          <match url="^/?api/mini-app/hlg/admin(?:/.*)?$" ignoreCase="true" />
          <conditions><add input="{HTTP_HOST}" pattern="^(?:hoalinh\.genora\.vn)(?::443)?$" ignoreCase="true" /></conditions>
          <serverVariables>
            <set name="HTTP_X_FORWARDED_HOST" value="{HTTP_HOST}" />
            <set name="HTTP_X_FORWARDED_PROTO" value="https" />
          </serverVariables>
          <action type="Rewrite" url="http://127.0.0.1:8868/{R:0}" appendQueryString="true" />
        </rule>
        <rule name="HL25 public APIs to YARP" stopProcessing="true">
          <match url="^/?api/mini-app/hl25(?:/.*)?$" ignoreCase="true" />
          <conditions><add input="{HTTP_HOST}" pattern="^(?:duocpham\-hoalinh\.genora\.vn)(?::443)?$" ignoreCase="true" /></conditions>
          <serverVariables>
            <set name="HTTP_X_FORWARDED_HOST" value="{HTTP_HOST}" />
            <set name="HTTP_X_FORWARDED_PROTO" value="https" />
          </serverVariables>
          <action type="Rewrite" url="http://127.0.0.1:5088/{R:0}" appendQueryString="true" />
        </rule>
        <rule name="HLG public APIs to YARP" stopProcessing="true">
          <match url="^/?api/mini-app/hlg(?:/.*)?$" ignoreCase="true" />
          <conditions><add input="{HTTP_HOST}" pattern="^(?:hoalinh\.genora\.vn)(?::443)?$" ignoreCase="true" /></conditions>
          <serverVariables>
            <set name="HTTP_X_FORWARDED_HOST" value="{HTTP_HOST}" />
            <set name="HTTP_X_FORWARDED_PROTO" value="https" />
          </serverVariables>
          <action type="Rewrite" url="http://127.0.0.1:5088/{R:0}" appendQueryString="true" />
        </rule>
        <rule name="Reject wrong host for protected Mini App APIs" stopProcessing="true">
          <match url="^/?api/mini-app/(?:hl25|hlg)(?:/.*)?$" ignoreCase="true" />
          <action type="CustomResponse" statusCode="404" statusReason="Not Found" statusDescription="API not available on this host." />
        </rule>
        <rule name="Known Host static fallback" stopProcessing="true">
          <match url=".*" ignoreCase="true" />
          <conditions><add input="{HTTP_HOST}" pattern="^(?:[a-z0-9-]+\.)?genora\.vn(?::443)?$" ignoreCase="true" /></conditions>
          <serverVariables>
            <set name="HTTP_X_FORWARDED_HOST" value="{HTTP_HOST}" />
            <set name="HTTP_X_FORWARDED_PROTO" value="https" />
          </serverVariables>
          <action type="Rewrite" url="http://127.0.0.1:8868/{R:0}" appendQueryString="true" />
        </rule>
        <rule name="Reject unknown host" stopProcessing="true">
          <match url=".*" />
          <action type="CustomResponse" statusCode="404" statusReason="Not Found" statusDescription="Unknown host." />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
